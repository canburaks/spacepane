#include "Branding.xcconfig"

// Compile-only prototype identities. They are not approved production identities.
PREVIEW_BASE_BUNDLE_IDENTIFIER = invalid.example.previewprototype
APP_GROUP_IDENTIFIER = group.invalid.example.previewprototype
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

MACOSX_DEPLOYMENT_TARGET = 15.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
// Release 1.0 ships for Apple silicon only: Intel execution and the x86_64 CAD worker are unverified.
// Apple accepts an arm64-only Mac App Store app that never shipped Intel; Intel can be added in an update.
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
SWIFT_APPROACHABLE_CONCURRENCY = NO
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_GENERATE_LOCALIZATION_SYMBOLS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GENERATE_INFOPLIST_FILE = NO
CURRENT_PROJECT_VERSION = 10
MARKETING_VERSION = 1.1.0
DEVELOPMENT_LANGUAGE = en
CODE_SIGN_ENTITLEMENTS = Configuration/$(PREVIEW_METADATA_ROLE).entitlements

// Whether the product carries the IGES and STEP 3D previews (decision 028). Version 1.0 ships without them: their
// importer links Open CASCADE Technology under the LGPL, and that licence question is not cleared. NO leaves the
// CAD helper (CADWorker), the CAD import service (CADImportService.xpc) and the OCCT notices out of every bundle,
// builds without the pinned OCCT kernel, and leaves the PREV_INCLUDE_CAD Swift compilation condition off, so the
// format adapters are never registered. YES restores the previous product; it also needs the two catalog entries
// back (Configuration/CADFormatCatalogEntries.json) and the helper prepared by script/build_cad_worker.py.
// script/validate_project.py and script/check_release_archive.py enforce this setting in both directions. A value
// in the ignored Local.xcconfig, or PREV_INCLUDE_CAD=YES on the xcodebuild command line, overrides this one.
PREV_INCLUDE_CAD = NO

// Derived from PREV_INCLUDE_CAD with the nested-variable selection; do not set these by hand.
// The Swift compilation condition: the companion and the preview extension add it to their own conditions.
PREV_CAD_SWIFT_CONDITION_YES = PREV_INCLUDE_CAD
PREV_CAD_SWIFT_CONDITION_NO =
PREV_CAD_SWIFT_CONDITION = $(PREV_CAD_SWIFT_CONDITION_$(PREV_INCLUDE_CAD))
// The CAD service identity the preview extension's Info.plist names (CADImportServiceIdentifier). Without CAD there
// is no service to name, so the value is empty; an Info.plist cannot omit a key by build setting, so the key stays
// with an empty string in that mode. script/validate_project.py checks both modes.
PREV_CAD_SERVICE_IDENTIFIER_YES = $(PREVIEW_BASE_BUNDLE_IDENTIFIER).cad-import
PREV_CAD_SERVICE_IDENTIFIER_NO =
PREV_CAD_SERVICE_IDENTIFIER = $(PREV_CAD_SERVICE_IDENTIFIER_$(PREV_INCLUDE_CAD))
// The preview extension's copy phase embeds the CAD service unless this names it as excluded.
PREV_CAD_EXCLUDED_SOURCE_NAMES_YES =
PREV_CAD_EXCLUDED_SOURCE_NAMES_NO = CADImportService.xpc
PREV_CAD_EXCLUDED_SOURCE_NAMES = $(PREV_CAD_EXCLUDED_SOURCE_NAMES_$(PREV_INCLUDE_CAD))
// The CAD service is still compiled while the setting is NO (the preview extension depends on its target), but it
// is never embedded. Without debug symbols its build leaves no dSYM in the archive for a product that does not ship.
PREV_CAD_SERVICE_DEBUG_FORMAT_YES = dwarf-with-dsym
PREV_CAD_SERVICE_DEBUG_FORMAT_NO = dwarf
PREV_CAD_SERVICE_DEBUG_FORMAT = $(PREV_CAD_SERVICE_DEBUG_FORMAT_$(PREV_INCLUDE_CAD))
// File lists of the "Embed CAD worker" script phase. YES: the lists script/build_cad_worker.py writes (helper and
// both notice folders). NO: committed lists that name the colour-scheme notice only, so a clean checkout builds
// without .build/cad.
PREV_CAD_BUNDLE_INPUTS_YES = $(SRCROOT)/.build/cad/bundle-inputs.xcfilelist
PREV_CAD_BUNDLE_INPUTS_NO = $(SRCROOT)/script/notices-inputs.xcfilelist
PREV_CAD_BUNDLE_INPUTS = $(PREV_CAD_BUNDLE_INPUTS_$(PREV_INCLUDE_CAD))
PREV_CAD_BUNDLE_OUTPUTS_YES = $(SRCROOT)/.build/cad/bundle-outputs.xcfilelist
PREV_CAD_BUNDLE_OUTPUTS_NO = $(SRCROOT)/script/notices-outputs.xcfilelist
PREV_CAD_BUNDLE_OUTPUTS = $(PREV_CAD_BUNDLE_OUTPUTS_$(PREV_INCLUDE_CAD))

// Whether the companion app embeds the Sparkle 2 direct-distribution updater. Direct/GitHub releases set this to YES;
// Mac App Store builds can override with PREV_INCLUDE_SPARKLE=NO. Neither Quick Look extension ever links Sparkle.
PREV_INCLUDE_SPARKLE = YES

PREV_SPARKLE_SWIFT_CONDITION_YES = PREV_INCLUDE_SPARKLE
PREV_SPARKLE_SWIFT_CONDITION_NO =
PREV_SPARKLE_SWIFT_CONDITION = $(PREV_SPARKLE_SWIFT_CONDITION_$(PREV_INCLUDE_SPARKLE))
PREV_SPARKLE_FRAMEWORK_SEARCH_PATHS_YES = $(SRCROOT)/.build/sparkle/dist
PREV_SPARKLE_FRAMEWORK_SEARCH_PATHS_NO =
PREV_SPARKLE_FRAMEWORK_SEARCH_PATHS = $(PREV_SPARKLE_FRAMEWORK_SEARCH_PATHS_$(PREV_INCLUDE_SPARKLE))
PREV_SPARKLE_LDFLAGS_YES = -framework Sparkle -Wl,-rpath,@executable_path/../Frameworks
PREV_SPARKLE_LDFLAGS_NO =
PREV_SPARKLE_LDFLAGS = $(PREV_SPARKLE_LDFLAGS_$(PREV_INCLUDE_SPARKLE))
PREV_APP_ENTITLEMENTS_YES = Configuration/app-sparkle.entitlements
PREV_APP_ENTITLEMENTS_NO = Configuration/app.entitlements
PREV_APP_ENTITLEMENTS = $(PREV_APP_ENTITLEMENTS_$(PREV_INCLUDE_SPARKLE))
PREV_SPARKLE_FEED_URL_YES = $(PREV_SPARKLE_FEED_URL)
PREV_SPARKLE_FEED_URL_NO =
PREV_EFFECTIVE_SPARKLE_FEED_URL = $(PREV_SPARKLE_FEED_URL_$(PREV_INCLUDE_SPARKLE))
PREV_SPARKLE_PUBLIC_ED_KEY_YES = $(PREV_SPARKLE_PUBLIC_ED_KEY)
PREV_SPARKLE_PUBLIC_ED_KEY_NO =
PREV_EFFECTIVE_SPARKLE_PUBLIC_ED_KEY = $(PREV_SPARKLE_PUBLIC_ED_KEY_$(PREV_INCLUDE_SPARKLE))
PREV_SPARKLE_BUNDLE_INPUTS_YES = $(SRCROOT)/.build/sparkle/bundle-inputs.xcfilelist
PREV_SPARKLE_BUNDLE_INPUTS_NO = $(SRCROOT)/script/sparkle-disabled-inputs.xcfilelist
PREV_SPARKLE_BUNDLE_INPUTS = $(PREV_SPARKLE_BUNDLE_INPUTS_$(PREV_INCLUDE_SPARKLE))
PREV_SPARKLE_BUNDLE_OUTPUTS_YES = $(SRCROOT)/.build/sparkle/bundle-outputs.xcfilelist
PREV_SPARKLE_BUNDLE_OUTPUTS_NO = $(SRCROOT)/script/sparkle-disabled-outputs.xcfilelist
PREV_SPARKLE_BUNDLE_OUTPUTS = $(PREV_SPARKLE_BUNDLE_OUTPUTS_$(PREV_INCLUDE_SPARKLE))

// Local identity/signing choices are never committed. No global Xcode switch is needed.
#include? "Local.xcconfig"
