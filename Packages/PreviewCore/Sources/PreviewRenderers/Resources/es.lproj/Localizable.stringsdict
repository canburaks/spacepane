		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Esta vista previa lee documentos anidados hasta %2$@ nivel de profundidad, y este es más profundo. Ábrelo en una app hecha para este tipo de archivo.</string>
			<key>other</key>
			<string>Esta vista previa lee documentos anidados hasta %2$@ niveles de profundidad, y este es más profundo. Ábrelo en una app hecha para este tipo de archivo.</string>
