			<string>Showing the first %2$@ rows.</string>
		</dict>
	</dict>
	<key>preview.table.shownRowsOfTotal</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Showing the first %2$@ row of %3$@.</string>
			<key>other</key>
			<string>Showing the first %2$@ rows of %3$@.</string>
		</dict>
	</dict>
</dict>
</plist>
