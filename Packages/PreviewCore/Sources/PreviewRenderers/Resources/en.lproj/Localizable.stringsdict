<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>appearance.pointsSpoken</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$@ point</string>
			<key>other</key>
			<string>%2$@ points</string>
		</dict>
	</dict>
	<key>failure.body.structureTooDeepLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>This preview reads documents nested up to %2$@ level deep, and this one goes deeper. Open it in an app made for this type of file.</string>
			<key>other</key>
			<string>This preview reads documents nested up to %2$@ levels deep, and this one goes deeper. Open it in an app made for this type of file.</string>
		</dict>
	</dict>
	<key>failure.body.tooManyLinesLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>This preview shows up to %2$@ line, and this file has more. Open it in a text editor to read all of it.</string>
			<key>other</key>
			<string>This preview shows up to %2$@ lines, and this file has more. Open it in a text editor to read all of it.</string>
		</dict>
	</dict>
