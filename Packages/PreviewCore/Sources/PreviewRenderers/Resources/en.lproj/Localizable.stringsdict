		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>This preview reads documents of up to %2$@ item, and this one has more. Open it in an app made for this type of file.</string>
			<key>other</key>
			<string>This preview reads documents of up to %2$@ items, and this one has more. Open it in an app made for this type of file.</string>
		</dict>
	</dict>
