	</dict>
	<key>failure.body.structureTooDeepLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>यह पूर्वावलोकन अधिकतम %2$@ स्तर गहराई तक नेस्टेड दस्तावेज़ पढ़ता है, और यह दस्तावेज़ उससे गहरा है। इसे इस प्रकार की फ़ाइल के लिए बने ऐप में खोलें।</string>
			<key>other</key>
			<string>यह पूर्वावलोकन अधिकतम %2$@ स्तर गहराई तक नेस्टेड दस्तावेज़ पढ़ता है, और यह दस्तावेज़ उससे गहरा है। इसे इस प्रकार की फ़ाइल के लिए बने ऐप में खोलें।</string>
		</dict>
	</dict>
	<key>failure.body.tooManyLinesLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>यह पूर्वावलोकन अधिकतम %2$@ पंक्तियाँ दिखाता है, और इस फ़ाइल में उससे अधिक हैं। पूरा पढ़ने के लिए इसे टेक्स्ट एडिटर में खोलें।</string>
			<key>other</key>
			<string>यह पूर्वावलोकन अधिकतम %2$@ पंक्तियाँ दिखाता है, और इस फ़ाइल में उससे अधिक हैं। पूरा पढ़ने के लिए इसे टेक्स्ट एडिटर में खोलें।</string>
		</dict>
