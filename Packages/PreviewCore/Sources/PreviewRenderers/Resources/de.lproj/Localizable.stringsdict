			<key>other</key>
			<string>%2$@ Punkt</string>
		</dict>
	</dict>
	<key>failure.body.structureTooDeepLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Diese Vorschau liest Dokumente mit bis zu %2$@ Ebene Tiefe, dieses ist tiefer verschachtelt. Öffnen Sie die Datei in einer App, die für diesen Dateityp gedacht ist.</string>
			<key>other</key>
			<string>Diese Vorschau liest Dokumente mit bis zu %2$@ Ebenen Tiefe, dieses ist tiefer verschachtelt. Öffnen Sie die Datei in einer App, die für diesen Dateityp gedacht ist.</string>
		</dict>
	</dict>
