<dict>
	<key>appearance.pointsSpoken</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$@ point</string>
			<key>other</key>
			<string>%2$@ points</string>
		</dict>
	</dict>
	<key>failure.body.structureTooDeepLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Cet aperçu lit les documents imbriqués sur %2$@ niveau au plus, et celui-ci va plus loin. Ouvrez-le dans une application conçue pour ce type de fichier.</string>
			<key>other</key>
			<string>Cet aperçu lit les documents imbriqués sur %2$@ niveaux au plus, et celui-ci va plus loin. Ouvrez-le dans une application conçue pour ce type de fichier.</string>
		</dict>
	</dict>
	<key>failure.body.tooManyLinesLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Cet aperçu affiche au plus %2$@ ligne, et ce fichier en compte davantage. Ouvrez-le dans un éditeur de texte pour le lire en entier.</string>
			<key>other</key>
			<string>Cet aperçu affiche au plus %2$@ lignes, et ce fichier en compte davantage. Ouvrez-le dans un éditeur de texte pour le lire en entier.</string>
		</dict>
	</dict>
