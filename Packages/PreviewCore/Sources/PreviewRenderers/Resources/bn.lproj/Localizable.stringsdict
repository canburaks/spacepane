	<key>finding.summary.concealed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$@টি সম্ভাব্য গোপন মান লুকানো হয়েছে। নির্বাচন ও কপি করার সময় গোপন মান লুকানো পাঠ ব্যবহার করা হয়।</string>
			<key>other</key>
			<string>%2$@টি সম্ভাব্য গোপন মান লুকানো হয়েছে। নির্বাচন ও কপি করার সময় গোপন মান লুকানো পাঠ ব্যবহার করা হয়।</string>
