	<key>appearance.pointsSpoken</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$@ পয়েন্ট</string>
			<key>other</key>
			<string>%2$@ পয়েন্ট</string>
		</dict>
	</dict>
	<key>failure.body.structureTooDeepLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>এই প্রিভিউ সর্বোচ্চ %2$@ স্তর পর্যন্ত নেস্ট করা নথি পড়ে, আর এই নথি তার চেয়ে গভীর। এই ধরনের ফাইলের জন্য তৈরি অ্যাপে এটি খুলুন।</string>
			<key>other</key>
			<string>এই প্রিভিউ সর্বোচ্চ %2$@ স্তর পর্যন্ত নেস্ট করা নথি পড়ে, আর এই নথি তার চেয়ে গভীর। এই ধরনের ফাইলের জন্য তৈরি অ্যাপে এটি খুলুন।</string>
		</dict>
	</dict>
	<key>failure.body.tooManyLinesLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>এই প্রিভিউ সর্বোচ্চ %2$@টি লাইন দেখায়, আর এই ফাইলে তার চেয়ে বেশি আছে। পুরোটা পড়তে এটি টেক্সট এডিটরে খুলুন।</string>
			<key>other</key>
			<string>এই প্রিভিউ সর্বোচ্চ %2$@টি লাইন দেখায়, আর এই ফাইলে তার চেয়ে বেশি আছে। পুরোটা পড়তে এটি টেক্সট এডিটরে খুলুন।</string>
		</dict>
	</dict>
