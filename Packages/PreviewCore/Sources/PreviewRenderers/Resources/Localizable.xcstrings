    "finding.launch.inlineScript": {
      "comment": "Safety finding for a launchd job: instead of only naming a program, the job carries shell or script code written directly inside this file, which macOS runs. The code is not shown. Not formatted; no placeholder. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
