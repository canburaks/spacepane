    "finding.summary.concealed": {
      "comment": "Collapsed preview privacy summary. Count actual concealed values, not finding categories or hidden Unicode characters. Keep the count and the complete selection/copying policy together as one sentence pair, following decision 026. %2$@ is the locale-formatted count supplied by PreviewStrings.count. Concealment already happened; selection and copying return this safe displayed text. Translations are drafts pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%2$@ likely secret hidden. Selection and copying use the concealed text."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%2$@ likely secrets hidden. Selection and copying use the concealed text."
                }
              }
            }
          }
        },
        "tr": {
