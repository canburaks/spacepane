    "failure.body.tooManyLines": {
      "comment": "Body under the title failure.title.tooManyLines: why it happened and what to do next, in one or two complete sentences ending with a period. The last sentence is the next step for the reader. Situation: the file has more lines than the line limit. Used when the limit is not known, so it never prints a number; the variant that prints it is failure.body.tooManyLinesLimit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has more lines than this preview shows. Open it in a text editor to read all of it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu önizlemenin gösterdiğinden daha fazla satırı var. Tamamını okumak için bir metin düzenleyicide açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie hat mehr Zeilen, als diese Vorschau anzeigt. Öffnen Sie die Datei in einem Texteditor, um sie vollständig zu lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contient plus de lignes que cet aperçu n’en affiche. Ouvrez-le dans un éditeur de texte pour le lire en entier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其行数超出了此预览可显示的范围。请在文本编辑器中打开以阅读全部内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行数が、このプレビューで表示できる数を超えています。全体を読むには、テキストエディタで開いてください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें उससे अधिक पंक्तियाँ हैं जितनी यह पूर्वावलोकन दिखाता है। पूरा पढ़ने के लिए इसे टेक्स्ट एडिटर में खोलें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji ya ku ev pêşdîtin nîşan dide bêtir rêzik tê de hene. Ji bo xwendina hemûyê, pelê di edîtorekî nivîsê de veke."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нём больше строк, чем показывает этот предпросмотр. Чтобы прочитать файл целиком, откройте его в текстовом редакторе."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas ini memiliki lebih banyak baris daripada yang ditampilkan pratinjau ini. Buka di editor teks untuk membaca seluruhnya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে এই প্রিভিউ যতটা লাইন দেখায় তার চেয়ে বেশি লাইন আছে। পুরোটা পড়তে এটি টেক্সট এডিটরে খুলুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana da layuka fiye da yadda wannan dubawa ke nunawa. Buɗe shi a cikin manhajar gyara rubutu don karanta shi gaba ɗaya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele tem mais linhas do que esta pré-visualização mostra. Abra-o em um editor de texto para ler tudo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene más líneas de las que muestra esta vista previa. Ábrelo en un editor de texto para leerlo completo."
          }
        }
      }
    },
