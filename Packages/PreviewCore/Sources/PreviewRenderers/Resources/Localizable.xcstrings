    "settings.scheme.acknowledgements": {
      "comment": "Acknowledgement on the About page for the third-party palettes that the built-in color schemes adapt. Keep the product names and MIT unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in color schemes adapt palette values from GitHub Primer, Solarized, Atom One, Nord and Dracula, each published under the MIT license."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik renk şemaları, her biri MIT lisansıyla yayımlanan GitHub Primer, Solarized, Atom One, Nord ve Dracula palet değerlerini uyarlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die integrierten Farbschemata passen Palettenwerte von GitHub Primer, Solarized, Atom One, Nord und Dracula an, die jeweils unter der MIT-Lizenz veröffentlicht sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les palettes de couleurs intégrées adaptent des valeurs de GitHub Primer, Solarized, Atom One, Nord et Dracula, chacun publié sous licence MIT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置配色方案改编自 GitHub Primer、Solarized、Atom One、Nord 和 Dracula 的调色板数值，它们均以 MIT 许可证发布。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵のカラースキームは、GitHub Primer、Solarized、Atom One、Nord、Draculaのパレット値を調整したもので、いずれもMITライセンスで公開されています。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतर्निहित रंग योजनाएँ GitHub Primer, Solarized, Atom One, Nord और Dracula के पैलेट मानों को अपनाती हैं; ये सभी MIT लाइसेंस के तहत प्रकाशित हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexşeyên rengan ên çêkirî nirxên paletê yên GitHub Primer, Solarized, Atom One, Nord û Dracula adapte dikin; her yek di bin lîsansa MIT de hatiye weşandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные цветовые схемы адаптируют значения палитр GitHub Primer, Solarized, Atom One, Nord и Dracula, каждая из которых опубликована по лицензии MIT."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skema warna bawaan mengadaptasi nilai palet dari GitHub Primer, Solarized, Atom One, Nord, dan Dracula, yang masing-masing dirilis dengan lisensi MIT."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্তর্নির্মিত রঙের স্কিমগুলো GitHub Primer, Solarized, Atom One, Nord ও Dracula-র প্যালেট মান অভিযোজন করে; প্রতিটিই MIT লাইসেন্সের অধীনে প্রকাশিত।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsarin launi da aka gina a ciki yana daidaita ƙimar launuka daga GitHub Primer, Solarized, Atom One, Nord da Dracula, kowanne an buga shi ƙarƙashin lasisin MIT."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esquemas de cores integrados adaptam valores de paleta de GitHub Primer, Solarized, Atom One, Nord e Dracula, cada um publicado sob a licença MIT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los esquemas de color integrados adaptan valores de paleta de GitHub Primer, Solarized, Atom One, Nord y Dracula, cada uno publicado bajo la licencia MIT."
          }
        }
      }
    },
