        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件超出了此预览可读取的大小。请使用适用于此类文件的应用打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはこのプレビューで読み込める大きさを超えています。この種類のファイルに対応したアプリで開いてください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल उससे बड़ी है जितनी यह पूर्वावलोकन पढ़ सकता है। इसे इस प्रकार की फ़ाइल के लिए बने ऐप में खोलें।"
