    "format.archive.gzip.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded decompression of supported text or TAR listings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen metin veya TAR listelerinin sınırlı açılması."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Dekomprimierung von unterstütztem Text oder TAR-Listen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décompression limitée de texte pris en charge ou de listes TAR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限度地解压受支持的文本或 TAR 列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するテキストや TAR 一覧を制限付きで解凍します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित टेक्स्ट या TAR सूचियों का सीमित विसंपीड़न।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekirina sînordar a metn an lîsteyên TAR ên piştgirîkirî."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распаковка поддерживаемого текста или списка TAR с ограничениями."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekompresi berbatas untuk teks yang didukung atau daftar TAR."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমর্থিত লেখা বা TAR তালিকার সীমাবদ্ধ ডিকম্প্রেশন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Buɗe matsewar rubutu ko jerin TAR da ake tallafawa cikin iyaka."
          }
        },
