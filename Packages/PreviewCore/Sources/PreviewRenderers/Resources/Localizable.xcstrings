    "midi.noAutoplay": {
      "comment": "App-authored label or feedback; preserve format placeholders and their argument types.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback starts only when you press Play."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma yalnızca Oynat'a bastığınızda başlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe startet erst, wenn Sie „Wiedergabe“ drücken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture démarre uniquement lorsque vous appuyez sur Lire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有按下“播放”才开始播放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「再生」を押した場合にのみ再生を開始します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लेबैक केवल चलाएँ दबाने पर शुरू होता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lêdan tenê dema ku Bilîze bikirtînî dest pê dike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизведение начинается только при нажатии «Воспроизвести»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemutaran hanya dimulai saat Anda menekan Putar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেবল চালান চাপলে প্লেব্যাক শুরু হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunnawa yana farawa ne kawai bayan ka danna Kunna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução começa somente quando você pressiona Reproduzir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción comienza solo cuando pulsas Reproducir."
          }
        }
      }
    },
