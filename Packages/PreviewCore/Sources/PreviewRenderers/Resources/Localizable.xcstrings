    "format.text.restructuredtext.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline reStructuredText headings, lists, literal blocks and admonitions plus safe source; directives are never run."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı reStructuredText başlıkları, listeleri, sabit metin blokları ve uyarıları ile güvenli kaynak; yönergeler asla çalıştırılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline dargestellte reStructuredText-Überschriften, Listen, Literalblöcke und Hinweisboxen sowie sichere Quelle; Direktiven werden nie ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres, listes, blocs littéraux et avertissements reStructuredText hors ligne et source sûre ; les directives ne sont jamais exécutées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线显示 reStructuredText 的标题、列表、字面块和提示框，并提供安全源码；绝不会执行指令。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "reStructuredText の見出し、リスト、リテラルブロック、注意書きをオフラインで表示し、安全なソースも提供します。ディレクティブは実行しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "reStructuredText के शीर्षक, सूचियाँ, लिटरल ब्लॉक और सूचना-बॉक्स ऑफ़लाइन, साथ में सुरक्षित स्रोत; निर्देश कभी नहीं चलाए जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sernivîs, lîste, blokên rastnivîs û nîşeyên reStructuredText ên negirêdayî û çavkaniya ewle; ferman tu car nayên xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки, списки, буквальные блоки и врезки reStructuredText без сети и безопасный исходник; директивы никогда не выполняются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul, daftar, blok literal, dan kotak peringatan reStructuredText secara luring plus sumber aman; direktif tidak pernah dijalankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইনে reStructuredText শিরোনাম, তালিকা, আক্ষরিক ব্লক ও সতর্কবার্তা এবং নিরাপদ উৎস; নির্দেশনা কখনো চালানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken reStructuredText, jeri, tubalan rubutu na zahiri da akwatunan gargaɗi ba tare da intanet ba, tare da amintaccen tushe; ba a taɓa gudanar da umarni ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos, listas, blocos literais e avisos reStructuredText offline, mais código-fonte seguro; diretivas nunca são executadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encabezados, listas, bloques literales y avisos de reStructuredText sin conexión, más código fuente seguro; las directivas nunca se ejecutan."
          }
        }
      }
    },
