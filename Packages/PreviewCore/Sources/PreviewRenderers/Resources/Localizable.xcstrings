    "format.package.android.description": {
      "comment": "One-sentence description of the package.android file type; states what is and is not shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manifest summary, permissions and file listing. Nothing is extracted or run, and signatures are not verified."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manifest özeti, izinler ve dosya listesi. Hiçbir şey çıkarılmaz veya çalıştırılmaz ve imzalar doğrulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manifest-Übersicht, Berechtigungen und Dateiliste. Nichts wird entpackt oder ausgeführt, und Signaturen werden nicht geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumé du manifeste, autorisations et liste des fichiers. Rien n’est extrait ni exécuté et les signatures ne sont pas vérifiées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清单摘要、权限和文件列表。不会解压或运行任何内容，也不验证签名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マニフェストの概要、権限、ファイル一覧。何も展開や実行はせず、署名の検証も行いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैनिफ़ेस्ट सारांश, अनुमतियाँ और फ़ाइल सूची। कुछ भी निकाला या चलाया नहीं जाता और हस्ताक्षरों का सत्यापन नहीं होता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurteya manîfestoyê, destûr û lîsteya pelan. Tiştek nayê derxistin an xebitandin û îmze nayên piştrastkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводка манифеста, разрешения и список файлов. Ничего не распаковывается и не запускается, подписи не проверяются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringkasan manifes, izin, dan daftar berkas. Tidak ada yang diekstrak atau dijalankan, dan tanda tangan tidak diverifikasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যানিফেস্টের সারসংক্ষেপ, অনুমতি ও ফাইলের তালিকা। কিছুই এক্সট্র্যাক্ট বা চালানো হয় না এবং স্বাক্ষর যাচাই করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Taƙaitaccen manifest, izini da jerin fayiloli. Ba a cire ko gudanar da komai ba, kuma ba a tabbatar da sa hannu ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumo do manifesto, permissões e lista de arquivos. Nada é extraído nem executado e as assinaturas não são verificadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen del manifiesto, permisos y lista de archivos. No se extrae ni se ejecuta nada y las firmas no se verifican."
          }
        }
      }
    },
