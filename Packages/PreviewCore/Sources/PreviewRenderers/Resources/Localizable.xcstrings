    "format.text.webvtt.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed WebVTT cues and safe source; styles and regions are not applied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlı WebVTT altyazı satırları ve güvenli kaynak; stiller ve bölgeler uygulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitgesteuerte WebVTT-Untertitel und sichere Quelle; Stile und Regionen werden nicht angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répliques WebVTT minutées et source sécurisée ; les styles et régions ne sont pas appliqués."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带时间的 WebVTT 字幕条目和安全源码；不应用样式和区域。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング付きの WebVTT 字幕キューと安全なソース。スタイルとリージョンは適用されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समयबद्ध WebVTT कैप्शन प्रविष्टियाँ और सुरक्षित स्रोत; शैलियाँ और क्षेत्र लागू नहीं किए जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Binnivîsên WebVTT ên bi dem û çavkaniya ewle; şêwaz û herêm nayên sepandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизированные реплики WebVTT и безопасный исходный текст; стили и области не применяются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baris takarir WebVTT berwaktu dan sumber aman; gaya dan wilayah tidak diterapkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়যুক্ত WebVTT ক্যাপশন অংশ ও নিরাপদ উৎস; শৈলী ও অঞ্চল প্রয়োগ করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubutun ƙasa na WebVTT masu lokaci da tushe mai aminci; ba a amfani da salo da yankuna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas WebVTT temporizadas e fonte segura; estilos e regiões não são aplicados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtítulos WebVTT con tiempos y fuente segura; no se aplican estilos ni regiones."
          }
        }
      }
    },
