    "format.document.epub.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book text, cover and details from EPUB packages; protected books show only their details."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB paketlerinden kitap metni, kapak ve ayrıntılar; korumalı kitaplarda yalnızca ayrıntılar gösterilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchtext, Cover und Angaben aus EPUB-Paketen; geschützte Bücher zeigen nur ihre Angaben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte, couverture et détails des paquets EPUB ; les livres protégés n’affichent que leurs détails."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 EPUB 包中的正文、封面和详细信息；受保护的图书仅显示详细信息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB パッケージの本文、表紙、詳細を表示します。保護された書籍では詳細のみ表示します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB पैकेज से पुस्तक का पाठ, आवरण और विवरण; सुरक्षित पुस्तकों में केवल विवरण दिखता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivîsa pirtûkê, bergê û hûrgiliyên ji pakêtên EPUB; di pirtûkên parastî de tenê hûrgilî tên nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст, обложка и сведения из пакетов EPUB; у защищённых книг показываются только сведения."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks buku, sampul, dan detail dari paket EPUB; buku terproteksi hanya menampilkan detailnya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB প্যাকেজ থেকে বইয়ের লেখা, প্রচ্ছদ ও তথ্য; সুরক্ষিত বইয়ে শুধু তথ্য দেখানো হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubutun littafi, murfi da bayanai daga fakitin EPUB; littattafan da aka kare suna nuna bayanansu kawai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto, capa e detalhes de pacotes EPUB; livros protegidos mostram apenas os detalhes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto, portada y detalles de paquetes EPUB; los libros protegidos solo muestran sus detalles."
          }
        }
      }
    },
