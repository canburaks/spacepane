    "format.text.microdvd.description": {
      "comment": "Description of the MicroDVD subtitle type; the .sub suffix is also used by binary VobSub files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame-timed MicroDVD cues converted to clock times. Binary VobSub .sub files are never displayed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kare zamanlı MicroDVD altyazıları saat zamanına dönüştürülür. İkili VobSub .sub dosyaları asla gösterilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildbasiert zeitgesteuerte MicroDVD-Untertitel, in Uhrzeiten umgerechnet. Binäre VobSub-.sub-Dateien werden nie angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répliques MicroDVD minutées en images, converties en durées. Les fichiers binaires VobSub .sub ne sont jamais affichés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以帧计时的 MicroDVD 字幕条目，转换为时钟时间。二进制 VobSub .sub 文件绝不会显示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーム単位の MicroDVD キューを時刻に変換して表示します。バイナリの VobSub .sub ファイルは表示されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्रेम-समयबद्ध MicroDVD प्रविष्टियाँ घड़ी के समय में बदली जाती हैं। बाइनरी VobSub .sub फ़ाइलें कभी नहीं दिखाई जातीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Binnivîsên MicroDVD yên bi çarçoveyê têne guhertin demên demjimêrê. Pelên .sub yên VobSub ên binary tu carî nayên nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реплики MicroDVD с привязкой к кадрам, переведённые во время. Двоичные файлы VobSub .sub никогда не показываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitel MicroDVD berbasis bingkai diubah menjadi waktu jam. Berkas VobSub .sub biner tidak pernah ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রেম-ভিত্তিক MicroDVD সাবটাইটেল ঘড়ির সময়ে রূপান্তর করা হয়। বাইনারি VobSub .sub ফাইল কখনও দেখানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubutun ƙasa na MicroDVD masu firam ana mai da su lokacin agogo. Ba a taɓa nuna fayilolin VobSub .sub na binary ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas MicroDVD por quadros convertidas em horários. Arquivos VobSub .sub binários nunca são exibidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtítulos MicroDVD por fotogramas convertidos a horas. Los archivos VobSub .sub binarios nunca se muestran."
          }
        }
      }
    },
