    "format.data.json-lines.description": {
      "comment": "This is a safe source presentation, not a records browser. The entire bounded file must validate; malformed records never show partial content.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded JSON Lines records with likely secrets concealed. Malformed records are replaced by concealed placeholders."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olası gizli bilgileri gizlenmiş, sınırlı JSON Lines kayıtları. Hatalı kayıtlar gizlenmiş yer tutucularla değiştirilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte JSON-Lines-Datensätze mit verborgenen wahrscheinlichen Geheimnissen. Fehlerhafte Datensätze werden durch verborgene Platzhalter ersetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrements JSON Lines limités avec secrets probables masqués. Les enregistrements incorrects sont remplacés par des espaces réservés masqués."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限度的 JSON Lines 记录，隐藏可能的机密信息。格式错误的记录会替换为隐藏占位符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密情報と思われる部分を隠した、制限付き JSON Lines レコード。不正なレコードは内容を隠したプレースホルダに置き換わります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित JSON Lines रिकॉर्ड, जिनमें संभावित गोपनीय जानकारी छिपाई जाती है। गलत रिकॉर्ड छिपे प्लेसहोल्डर से बदले जाते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomarên JSON Lines ên sînordar bi agahiyên veşartî yên têne veşartin. Tomarên xerab bi cihgirên veşartî tên guhertin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи JSON Lines с ограничениями и скрытием вероятных секретов. Некорректные записи заменяются скрытыми заполнителями."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman JSON Lines berbatas dengan informasi yang diduga rahasia disamarkan. Rekaman tidak valid diganti dengan penanda penyamaran."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমাবদ্ধ JSON Lines রেকর্ডে সম্ভাব্য গোপন তথ্য লুকানো হয়। ভুল রেকর্ড লুকানো স্থানধারক দিয়ে প্রতিস্থাপিত হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubutattun bayanai na JSON Lines masu iyaka da ɓoye bayanan da ake zaton sirri ne. Ana maye gurbin rubutattun bayanan da suka lalace da alamomin ɓoye."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros JSON Lines com limites e possíveis segredos ocultados. Registros malformados são substituídos por marcadores de ocultação."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros JSON Lines limitados con posibles secretos ocultos. Los registros mal formados se sustituyen por marcadores de ocultación."
          }
        }
      }
    },
