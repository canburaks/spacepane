    "notebook.truncated": {
      "comment": "Shown at the end of a long notebook preview. %1$lld is the number of cells displayed and %2$lld is the total number of cells, both Int64; keep positional placeholders and keep the wording independent of singular and plural.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview shortened. Cells shown: %1$lld of %2$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizleme kısaltıldı. Gösterilen hücre: %2$lld içinden %1$lld."
          }
        },
        "de": {
          "stringUnit": {
