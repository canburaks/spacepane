            "value": "Долгота от %1$@ до %2$@, широта от %3$@ до %4$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bujur %1$@ hingga %2$@, lintang %3$@ hingga %4$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রাঘিমাংশ %1$@ থেকে %2$@, অক্ষাংশ %3$@ থেকে %4$@"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Longitude daga %1$@ zuwa %2$@, latitude daga %3$@ zuwa %4$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Longitude de %1$@ a %2$@, latitude de %3$@ a %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Longitud de %1$@ a %2$@, latitud de %3$@ a %4$@"
          }
        }
      }
    },
    "preview.data.plotHelp": {
      "comment": "Accessibility help of the coordinate plot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawn from the file’s coordinates. No map tiles or network are used."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyadaki koordinatlardan çizildi. Harita karoları veya ağ kullanılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus den Koordinaten der Datei gezeichnet. Es werden keine Kartenkacheln oder Netzwerkzugriffe verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiné à partir des coordonnées du fichier. Aucune tuile de carte ni réseau n’est utilisé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据文件中的坐标绘制，不使用地图图块或网络。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル内の座標から描画しています。地図タイルやネットワークは使用しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल के निर्देशांकों से बनाया गया। कोई मानचित्र टाइल या नेटवर्क उपयोग नहीं होता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji koordînatên pelê hatiye xêzkirin. Tu kevirên nexşeyê an tor nayên bikaranîn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Построено по координатам из файла. Плитки карты и сеть не используются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digambar dari koordinat dalam berkas. Tidak ada ubin peta atau jaringan yang digunakan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলের স্থানাঙ্ক থেকে আঁকা। কোনো ম্যাপ টাইল বা নেটওয়ার্ক ব্যবহার হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An zana daga haɗin wuraren da ke cikin fayil. Ba a amfani da tayal ɗin taswira ko cibiyar sadarwa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhado a partir das coordenadas do arquivo. Nenhum bloco de mapa ou rede é usado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibujado a partir de las coordenadas del archivo. No se usan teselas de mapa ni red."
          }
        }
      }
    },
    "preview.data.plotSimplified": {
      "comment": "Notice shown with the coordinate plot when long paths show only some of their points. Source is the name of the Source preview mode; keep it identical to the translation of preview.mode.source.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long paths show only some points. Source lists the drawn points."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun yollar yalnızca noktalarının bir alt kümesini gösterir. Kaynak, çizilen noktaları listeler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange Pfade zeigen nur eine Teilmenge ihrer Punkte. Quelle listet die gezeichneten Punkte auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les longs tracés n’affichent qu’une partie de leurs points. Source liste les points dessinés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较长的路径仅绘制其部分点。“源码”中列出了所绘制的点。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いパスは一部の点だけを描画します。ソースには描画された点が一覧表示されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबे पथ अपने बिंदुओं का केवल एक उपसमुच्चय दिखाते हैं। स्रोत में खींचे गए बिंदु सूचीबद्ध हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rêyên dirêj tenê beşek ji xalên xwe nîşan didin. Çavkanî xalên hatine xêzkirin lîste dike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длинные пути показаны лишь частью своих точек. Исходный текст содержит отрисованные точки."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalur panjang hanya menampilkan sebagian titiknya. Sumber mencantumkan titik yang digambar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দীর্ঘ পথে শুধু কিছু বিন্দু দেখানো হয়। উৎসে আঁকা বিন্দুগুলোর তালিকা আছে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dogayen hanyoyi suna nuna wasu daga cikin makinsu kawai. Tushe yana lissafa makin da aka zana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhos longos mostram apenas parte dos seus pontos. Origem lista os pontos desenhados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rutas largas muestran solo una parte de sus puntos. Código fuente lista los puntos dibujados."
          }
        }
      }
    },
