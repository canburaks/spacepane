    "format.text.markdown.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline rendered Markdown subset and safe source; no remote resources or scripts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı işlenmiş Markdown alt kümesi ve güvenli kaynak; uzak kaynak veya betik yoktur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline gerenderte Markdown-Teilmenge und sichere Quelle; keine externen Ressourcen oder Skripte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous-ensemble Markdown rendu hors ligne et source sécurisée ; aucune ressource distante ni aucun script."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线渲染部分 Markdown 语法及安全源码；不使用远程资源或脚本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown の一部をオフラインで表示し、安全なソースも提供します。リモートリソースやスクリプトは使用しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन रेंडर किया गया Markdown का एक भाग और सुरक्षित स्रोत; कोई दूरस्थ संसाधन या स्क्रिप्ट नहीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Beşeke Markdown a nîşandayî ya bê internet û çavkaniya ewle; çavkaniyên dûr û skrîpt tune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автономное форматирование подмножества Markdown и безопасный исходный текст; без удалённых ресурсов и скриптов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Subset Markdown yang dirender secara luring dan sumber aman; tanpa sumber daya jarak jauh atau skrip."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইনে রেন্ডার করা Markdown-এর অংশ ও নিরাপদ উৎস; কোনো দূরবর্তী সংস্থান বা স্ক্রিপ্ট নেই।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wani ɓangaren Markdown da aka tsara ba tare da intanet ba da tushe mai aminci; babu kayan nesa ko rubutun umarni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Subconjunto Markdown renderizado offline e origem segura; sem recursos remotos nem scripts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subconjunto de Markdown renderizado sin conexión y código fuente seguro; sin recursos remotos ni scripts."
          }
        }
      }
    },
