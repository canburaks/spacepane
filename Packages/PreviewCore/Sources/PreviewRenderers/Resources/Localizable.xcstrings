    "format.data.csv.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded comma-separated tables and safe source; formulas are never evaluated."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı virgülle ayrılmış tablolar ve güvenli kaynak; formüller asla hesaplanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte kommagetrennte Tabellen und sichere Quelle; Formeln werden nie ausgewertet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tableaux limités à valeurs séparées par des virgules et source sécurisée ; les formules ne sont jamais évaluées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限度的逗号分隔表格和安全源码；从不计算公式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限付きのカンマ区切り表と安全なソース。数式は評価されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित अल्पविराम-पृथक तालिकाएँ और सुरक्षित स्रोत; सूत्रों का कभी मूल्यांकन नहीं किया जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabloyên sînordar ên bi bêhnokê veqetandî û çavkaniya ewle; formul qet nayên hesabkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблицы с разделителями-запятыми с ограничениями и безопасный исходный текст; формулы никогда не вычисляются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabel nilai dipisahkan koma yang berbatas dan sumber aman; rumus tidak pernah dievaluasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমিত কমা-বিভক্ত সারণি ও নিরাপদ উৎস; সূত্র কখনো মূল্যায়ন করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Teburan ƙimomi da waƙafi ya raba masu iyaka da tushe mai aminci; ba a taɓa lissafa dabaru ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabelas limitadas separadas por vírgulas e fonte segura; fórmulas nunca são avaliadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablas limitadas separadas por comas y fuente segura; las fórmulas nunca se evalúan."
          }
        }
      }
    },
