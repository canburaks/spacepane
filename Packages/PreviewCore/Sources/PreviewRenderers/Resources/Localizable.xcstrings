    "preview.ebooks.pages.help": {
      "comment": "VoiceOver hint for the scrolling list of page images; describes the keyboard shortcuts for moving through pages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the arrow keys, Space, or Page Up and Page Down to move through the pages. Press Command-Up or Command-Down to jump to the start or end."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfalar arasında gezinmek için ok tuşlarını, Boşluk'u veya Sayfa Yukarı ile Sayfa Aşağı tuşlarını kullanın. Başa veya sona gitmek için Command-Yukarı ya da Command-Aşağı tuşlarına basın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den Pfeiltasten, der Leertaste oder Bild auf und Bild ab blättern Sie durch die Seiten. Mit Befehl-Pfeil-nach-oben oder Befehl-Pfeil-nach-unten springen Sie zum Anfang oder Ende."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les touches fléchées, la barre d’espace ou Page précédente et Page suivante pour parcourir les pages. Appuyez sur Commande-Flèche haut ou Commande-Flèche bas pour aller au début ou à la fin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向键、空格键或“向上翻页”“向下翻页”键浏览页面。按 Command–向上箭头或 Command–向下箭头可跳到开头或结尾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印キー、スペースキー、Page Up/Page Down キーでページを移動できます。Command＋上矢印または Command＋下矢印で先頭または末尾へ移動します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठों में आगे-पीछे जाने के लिए तीर कुंजियाँ, स्पेस या पेज अप और पेज डाउन का उपयोग करें। शुरुआत या अंत पर जाने के लिए Command-ऊपर या Command-नीचे दबाएँ।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji bo gerîna di rûpelan de bişkojkên tîrê, Space an jî Page Up û Page Down bi kar bîne. Ji bo çûna destpêk an dawiyê Command-Jor an Command-Jêr bitikîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перехода по страницам используйте клавиши со стрелками, пробел или Page Up и Page Down. Нажмите Command–стрелка вверх или Command–стрелка вниз, чтобы перейти к началу или концу."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan tombol panah, Spasi, atau Page Up dan Page Down untuk berpindah antarhalaman. Tekan Command-Atas atau Command-Bawah untuk melompat ke awal atau akhir."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃষ্ঠাগুলোর মধ্যে যেতে তীরচিহ্নের কী, স্পেস, অথবা পেজ আপ ও পেজ ডাউন ব্যবহার করুন। শুরু বা শেষে যেতে Command-উপরে বা Command-নিচে চাপুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da maɓallan kibiya, Space, ko Page Up da Page Down don zagaya shafukan. Danna Command-Sama ko Command-Ƙasa don tsallakawa zuwa farko ko ƙarshe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as teclas de seta, a barra de espaço ou Page Up e Page Down para percorrer as páginas. Pressione Command-Seta para cima ou Command-Seta para baixo para ir ao início ou ao fim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las teclas de flecha, la barra espaciadora o Re Pág y Av Pág para recorrer las páginas. Pulsa Comando-Flecha arriba o Comando-Flecha abajo para ir al principio o al final."
          }
        }
      }
    },
