    "format.ml.pickle.description": {
      "comment": "One-sentence description of a file type in the companion's File Types list: the app lists which Python functions a pickle would import if it were loaded, and never loads it; the second sentence warns that the check is limited. Technical names stay as they are. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What loading the file would import, checked without loading it. A file with no findings can still be unsafe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya yüklenirse nelerin içe aktarılacağı, dosya yüklenmeden denetlenir. Bulgusu olmayan bir dosya yine de güvenli olmayabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das Laden der Datei importieren würde, geprüft ohne sie zu laden. Auch eine Datei ohne Befunde kann unsicher sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que le chargement du fichier importerait, vérifié sans le charger. Un fichier sans constat peut quand même être dangereux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不加载文件，仅检查加载它时会导入哪些内容。即使没有发现，文件仍可能不安全。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込んだ場合に何がインポートされるかを、読み込まずに確認します。確認項目がなくても、安全とは限りません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल को लोड करने पर क्या इंपोर्ट होगा, इसे फ़ाइल लोड किए बिना जाँचा जाता है। निष्कर्ष न होने पर भी फ़ाइल असुरक्षित हो सकती है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Barkirina pelê dê çi import bike, bêyî ku pel were barkirin tê kontrolkirin. Pelek ku tiştek tê de nehatibe dîtin jî dibe ku ne ewle be."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что импортировал бы файл при загрузке; проверка выполняется без загрузки. Файл без замечаний всё равно может быть небезопасным."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang akan diimpor saat berkas dimuat, diperiksa tanpa memuatnya. Berkas tanpa temuan masih bisa tidak aman."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল লোড করলে কী ইমপোর্ট হবে, তা ফাইল লোড না করেই যাচাই করা হয়। কোনো ফলাফল না থাকলেও ফাইলটি অনিরাপদ হতে পারে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Abin da lodin fayil ɗin zai shigo da shi, ana dubawa ba tare da ɗora shi ba. Fayil maras abubuwan da aka gano zai iya zama maras tsaro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o carregamento do arquivo importaria, verificado sem carregá-lo. Um arquivo sem ocorrências ainda pode ser inseguro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que importaría la carga del archivo, comprobado sin cargarlo. Un archivo sin hallazgos aún puede no ser seguro."
          }
        }
      }
    },
