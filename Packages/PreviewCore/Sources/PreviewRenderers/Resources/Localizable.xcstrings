    "findings.report.copyHint": {
      "comment": "Accessibility hint (read by VoiceOver) for the Copy Findings Report button. It says what the button copies and promises that no text from the file is included. Not formatted; no placeholder. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies a list of these findings. No text from the file is included."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bulguların bir listesini kopyalar. Dosyadan hiçbir metin eklenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert eine Liste dieser Befunde. Es ist kein Text aus der Datei enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie la liste de ces constats. Aucun texte du fichier n’est inclus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝这些发现的列表，不包含文件中的任何文本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの確認項目の一覧をコピーします。ファイルのテキストは含まれません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन निष्कर्षों की सूची कॉपी करता है। फ़ाइल का कोई टेक्स्ट शामिल नहीं होता।"
