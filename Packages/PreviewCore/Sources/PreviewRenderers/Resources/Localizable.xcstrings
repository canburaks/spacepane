    "format.data.toml.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common configuration previews with safe source fallback for advanced syntax."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmiş sözdiziminde güvenli kaynak görünümüne dönen yaygın yapılandırma önizlemeleri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gängige Konfigurationsvorschauen mit sicherer Quellansicht bei erweiterter Syntax."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçus de configuration courante avec repli sur la source sécurisée pour la syntaxe avancée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常见配置预览，遇到高级语法时回退为安全源码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般的な設定をプレビューします。高度な構文では安全なソースに切り替わります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य कॉन्फ़िगरेशन पूर्वावलोकन; उन्नत सिंटैक्स के लिए सुरक्षित स्रोत का विकल्प।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtinên sazkirinên asayî bi vegerîna çavkaniya ewle ji bo hevoksaziya pêşketî."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр обычных конфигураций с безопасным исходным текстом для сложного синтаксиса."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau konfigurasi umum dengan sumber aman sebagai cadangan untuk sintaks lanjutan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাধারণ কনফিগারেশন প্রিভিউ; উন্নত সিনট্যাক্সের জন্য নিরাপদ উৎসের বিকল্প।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubawar tsarin saituna na gama gari; idan nahawu ya yi zurfi, ana nuna tushe mai aminci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualizações de configurações comuns, com origem segura para sintaxe avançada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistas previas de configuraciones comunes, con código fuente seguro para sintaxis avanzada."
          }
        }
      }
    },
