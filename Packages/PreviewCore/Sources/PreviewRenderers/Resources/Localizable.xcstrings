    "finding.notebook.executionGaps": {
      "comment": "Jupyter notebook check: the saved execution numbers are not consecutive. %lld is a count (Int64). Keep the wording independent of singular and plural.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Execution numbers skip values, so cells were rerun or removed. Gaps: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştırma numaraları değer atlıyor, yani hücreler yeniden çalıştırılmış veya kaldırılmış. Boşluk sayısı: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausführungsnummern überspringen Werte, daher wurden Zellen erneut ausgeführt oder entfernt. Lücken: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les numéros d’exécution sautent des valeurs : des cellules ont été réexécutées ou supprimées. Écarts : %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行编号存在跳号，说明单元格被重新运行或删除过。跳号数：%lld。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行番号が飛んでいるため、セルが再実行または削除されています。欠番数: %lld。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निष्पादन संख्याएँ कुछ मान छोड़ देती हैं, इसलिए सेल दोबारा चलाए गए या हटाए गए। अंतराल: %lld।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejmarên xebitandinê hin nirxan derbas dikin, ji ber vê yekê şane ji nû ve hatine xebitandin an jêbirin. Valahî: %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В номерах выполнения есть пропуски, поэтому ячейки перезапускались или были удалены. Пропусков: %lld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomor eksekusi melewati beberapa nilai, sehingga sel dijalankan ulang atau dihapus. Nomor yang terlewat: %lld."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সিকিউশন নম্বরে কিছু মান বাদ পড়েছে, তাই সেল আবার চালানো বা মুছে ফেলা হয়েছে। ফাঁক: %lld।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lambobin gudanarwa suna tsallake wasu ƙimomi, don haka an sake gudanar da sel ko an cire su. Giɓi: %lld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números de execução pulam valores, então células foram executadas de novo ou removidas. Lacunas: %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números de ejecución saltan valores, así que se volvieron a ejecutar o se eliminaron celdas. Saltos: %lld."
          }
        }
      }
    },
    "finding.notebook.mayNotReproduce": {
      "comment": "Jupyter notebook hint shown with the execution-order checks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved results may differ when the notebook runs from top to bottom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not defteri baştan sona çalıştırıldığında kayıtlı sonuçlar farklı olabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Ergebnisse können abweichen, wenn das Notebook von oben nach unten ausgeführt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats enregistrés peuvent différer si le notebook est exécuté de haut en bas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从头到尾运行笔记本时，已保存的结果可能会不同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートブックを上から順に実行すると、保存されている結果と異なる場合があります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोटबुक को ऊपर से नीचे तक चलाने पर सहेजे गए परिणाम अलग हो सकते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dema defter ji jor heta jêr tê xebitandin, dibe ku encamên tomarkirî cuda bin."
          }
        },
        "ru": {
          "stringUnit": {
