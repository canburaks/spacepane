    "format.archive.bzip2.description": {
      "comment": "Supported-behavior description for bzip2 files. A TAR archive inside is listed, text is shown, and anything else is reported as binary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded decompression of bzip2 streams: TAR.BZ2 listings and supported text. Other content is reported as binary."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bzip2 akışlarının sınırlı açılması: TAR.BZ2 listeleri ve desteklenen metin. Diğer içerik ikili olarak bildirilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Dekomprimierung von bzip2-Datenströmen: TAR.BZ2-Listen und unterstützter Text. Anderer Inhalt wird als binär gemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décompression bornée des flux bzip2 : listes TAR.BZ2 et texte pris en charge. Tout autre contenu est signalé comme binaire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对 bzip2 数据流进行有界解压：TAR.BZ2 列表和受支持的文本。其他内容将报告为二进制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "bzip2 ストリームを上限付きで解凍します。TAR.BZ2 の一覧と対応するテキストを表示し、それ以外の内容はバイナリとして報告します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "bzip2 स्ट्रीम का सीमित डीकंप्रेशन: TAR.BZ2 सूचियाँ और समर्थित पाठ। अन्य सामग्री को बाइनरी बताया जाता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekirina sînorkirî ya herikên bzip2: lîsteyên TAR.BZ2 û nivîsa piştgirîkirî. Naveroka din wekî binary tê ragihandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченная распаковка потоков bzip2: списки TAR.BZ2 и поддерживаемый текст. Прочее содержимое помечается как двоичное."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekompresi aliran bzip2 yang dibatasi: daftar TAR.BZ2 dan teks yang didukung. Konten lain dilaporkan sebagai biner."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "bzip2 স্ট্রিমের সীমিত ডিকম্প্রেশন: TAR.BZ2 তালিকা ও সমর্থিত টেক্সট। অন্য বিষয়বস্তু বাইনারি হিসেবে জানানো হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Buɗe rafukan bzip2 mai iyaka: jerin TAR.BZ2 da rubutun da ake goyon baya. Ana bayyana sauran abubuwan a matsayin binary."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descompressão limitada de fluxos bzip2: listas TAR.BZ2 e texto compatível. Outro conteúdo é indicado como binário."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descompresión acotada de flujos bzip2: listas TAR.BZ2 y texto compatible. El resto del contenido se indica como binario."
          }
        }
      }
    },
