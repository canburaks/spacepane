    "preview.privacyNotice": {
      "comment": "Privacy status above concealed text; does not reveal secret values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Likely secrets are concealed. Selection and copying use the concealed content."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olası gizli bilgiler gizlenir. Seçme ve kopyalama işlemleri gizlenmiş içeriği kullanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahrscheinliche Geheimnisse sind verborgen. Auswahl und Kopieren verwenden den verborgenen Inhalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets probables sont masqués. La sélection et la copie utilisent le contenu masqué."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能的机密信息已隐藏。选择和拷贝使用隐藏后的内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密情報と思われる部分は隠されます。選択とコピーには、隠された後の内容が使われます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संभावित गोपनीय जानकारी छिपाई जाती है। चयन और कॉपी में छिपाई गई सामग्री का उपयोग होता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Agahiyên ku dibe ku veşartî bin tên veşartin. Hilbijartin û kopîkirin naveroka veşartî bi kar tînin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вероятные секреты скрыты. Выделение и копирование используют содержимое со скрытыми секретами."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi yang diduga rahasia disembunyikan. Pemilihan dan penyalinan menggunakan konten yang telah disamarkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্ভাব্য গোপন তথ্য লুকানো হয়। নির্বাচন ও কপিতে গোপন তথ্য লুকানোর পরের বিষয়বস্তু ব্যবহার করা হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ɓoye bayanan da ake zaton sirri ne. Zaɓawa da kwafi suna amfani da bayanan da aka ɓoye."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Possíveis segredos são ocultados. A seleção e a cópia usam o conteúdo ocultado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los posibles secretos se ocultan. La selección y la copia usan el contenido con los secretos ocultos."
          }
        }
      }
    },
