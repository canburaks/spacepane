          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用未正确设置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが正しく設定されていません"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप सही ढंग से सेट अप नहीं है"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepan bi awayekî rast nehatiye sazkirin"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение настроено неправильно"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi belum disiapkan dengan benar"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি সঠিকভাবে সেট আপ করা নেই"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a saita manhajar yadda ya kamata ba"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não está configurado corretamente"
          }
        },
