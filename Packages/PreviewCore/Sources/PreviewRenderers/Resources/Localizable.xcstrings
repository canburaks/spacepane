    "format.text.sbv.description": {
      "comment": "Description of the SBV caption type.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed YouTube SBV cues and safe source; markup is not applied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlı YouTube SBV altyazı satırları ve güvenli kaynak; biçimlendirme uygulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitgesteuerte YouTube-SBV-Untertitel und sichere Quelle; Auszeichnungen werden nicht angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répliques YouTube SBV minutées et source sécurisée ; le balisage n’est pas appliqué."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带时间的 YouTube SBV 字幕条目和安全源码；不应用标记。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング付きの YouTube SBV 字幕キューと安全なソース。マークアップは適用されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समयबद्ध YouTube SBV कैप्शन प्रविष्टियाँ और सुरक्षित स्रोत; मार्कअप लागू नहीं किया जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Binnivîsên YouTube SBV yên bi dem û çavkaniya ewle; nîşankirin nayê sepandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизированные реплики YouTube SBV и безопасный исходный текст; разметка не применяется."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Takarir YouTube SBV berwaktu dan sumber aman; markup tidak diterapkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়যুক্ত YouTube SBV ক্যাপশন অংশ ও নিরাপদ উৎস; মার্কআপ প্রয়োগ করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubutun ƙasa na YouTube SBV masu lokaci da tushe mai aminci; ba a amfani da alamomin tsari."
          }
        },
        "pt": {
