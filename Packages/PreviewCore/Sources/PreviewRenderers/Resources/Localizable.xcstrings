    "format.security.certificate.description": {
      "comment": "One-sentence description of the security.certificate file type; states what is and is not shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificate details and fingerprints. Private keys are hidden, and trust is not evaluated."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifika ayrıntıları ve parmak izleri. Özel anahtarlar gizlenir ve güven değerlendirilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikatsdetails und Fingerabdrücke. Private Schlüssel bleiben verborgen, und das Vertrauen wird nicht bewertet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détails et empreintes des certificats. Les clés privées sont masquées et la confiance n’est pas évaluée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证书详情和指纹。私钥会被隐藏，也不评估信任状态。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書の詳細とフィンガープリント。秘密鍵は非表示で、信頼性の評価は行いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणपत्र विवरण और फ़िंगरप्रिंट। निजी कुंजियाँ छिपी रहती हैं और भरोसे का मूल्यांकन नहीं होता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hûrguliyên sertîfîkayan û şopan. Mifteyên taybet veşartî ne û pêbawerî nayê nirxandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведения о сертификатах и отпечатки. Закрытые ключи скрыты, доверие не оценивается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail sertifikat dan sidik jari. Kunci privat disembunyikan, dan kepercayaan tidak dievaluasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্টিফিকেটের বিবরণ ও ফিঙ্গারপ্রিন্ট। ব্যক্তিগত কী লুকানো থাকে এবং বিশ্বাসযোগ্যতা মূল্যায়ন করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayanan takaddun shaida da zanen yatsa. An ɓoye maɓallan sirri, kuma ba a tantance amincewa ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalhes e impressões digitais de certificados. Chaves privadas ficam ocultas e a confiança não é avaliada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalles y huellas de certificados. Las claves privadas permanecen ocultas y no se evalúa la confianza."
          }
        }
      }
    },
