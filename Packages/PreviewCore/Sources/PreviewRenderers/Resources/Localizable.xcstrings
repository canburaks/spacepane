    "format.text.substation-alpha.description": {
      "comment": "Description of the SubStation Alpha subtitle type; override tags are removed in the cue list only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed ASS and SSA dialogue as cues with style overrides removed; styles, fonts and drawings are not applied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlı ASS ve SSA diyalogları, stil geçersiz kılmaları kaldırılmış altyazı satırları olarak; stiller, yazı tipleri ve çizimler uygulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitgesteuerte ASS- und SSA-Dialoge als Untertitel ohne Stilüberschreibungen; Stile, Schriften und Zeichnungen werden nicht angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogues ASS et SSA minutés sous forme de répliques, sans les surcharges de style ; styles, polices et dessins ne sont pas appliqués."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带时间的 ASS 和 SSA 对白，显示为已去除样式覆盖标记的字幕条目；不应用样式、字体和绘图。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング付きの ASS/SSA のセリフを、スタイル上書きを除いたキューとして表示します。スタイル、フォント、描画は適用されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समयबद्ध ASS और SSA संवाद, शैली ओवरराइड हटाकर उपशीर्षक प्रविष्टियों के रूप में; शैलियाँ, फ़ॉन्ट और चित्रण लागू नहीं किए जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Axaftinên ASS û SSA yên bi dem, wekî binnivîs bê guherandinên şêwazê; şêwaz, curenivîs û xêzkirin nayên sepandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизированные реплики ASS и SSA без переопределений стиля; стили, шрифты и рисунки не применяются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog ASS dan SSA berwaktu sebagai subtitel tanpa penimpaan gaya; gaya, fon, dan gambar tidak diterapkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়যুক্ত ASS ও SSA সংলাপ, শৈলী ওভাররাইড বাদ দিয়ে সাবটাইটেল অংশ হিসেবে; শৈলী, ফন্ট ও চিত্র প্রয়োগ করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tattaunawar ASS da SSA masu lokaci a matsayin rubutun ƙasa ba tare da gyaran salo ba; ba a amfani da salo, rubutun haruffa da zane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diálogos ASS e SSA temporizados como legendas sem substituições de estilo; estilos, fontes e desenhos não são aplicados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diálogos ASS y SSA con tiempos como subtítulos sin anulaciones de estilo; no se aplican estilos, fuentes ni dibujos."
          }
        }
      }
    },
