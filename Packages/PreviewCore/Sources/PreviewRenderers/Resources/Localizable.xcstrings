    "format.config.environment.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only assignments with likely secrets concealed; substitutions are never executed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olası gizli bilgileri gizlenmiş salt okunur atamalar; yerine koyma ifadeleri asla çalıştırılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützte Zuweisungen mit verborgenen wahrscheinlichen Geheimnissen; Ersetzungen werden nie ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affectations en lecture seule avec secrets probables masqués ; les substitutions ne sont jamais exécutées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读赋值并隐藏可能的机密信息；从不执行替换表达式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密情報と思われる部分を隠した読み取り専用の代入式。置換式は実行しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोपनीय जानकारी छिपाकर केवल पढ़ने के असाइनमेंट; प्रतिस्थापन कभी निष्पादित नहीं होते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Danasînên tenê-xwendinê bi agahiyên veşartî yên têne veşartin; veguhastin tu carî nayên xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присваивания только для чтения со скрытием вероятных секретов; подстановки никогда не выполняются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penetapan nilai hanya baca dengan informasi yang diduga rahasia disamarkan; substitusi tidak pernah dijalankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গোপন তথ্য লুকিয়ে শুধু পড়ার অ্যাসাইনমেন্ট; প্রতিস্থাপন কখনো চালানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanya ƙimomi don karantawa kawai tare da ɓoye sirri; ba a aiwatar da musanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribuições somente para leitura com possíveis segredos ocultados; substituições nunca são executadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asignaciones de solo lectura con posibles secretos ocultos; nunca se ejecutan sustituciones."
          }
        }
      }
    },
