    "format.database.sqlite.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded private-snapshot inspection of tables, schema and indexes; busy or live-WAL databases are declined."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablo, şema ve dizinlerin sınırlı özel anlık görüntü incelemesi; meşgul veya canlı WAL veritabanları reddedilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Prüfung von Tabellen, Schema und Indizes in einem privaten Snapshot; belegte Datenbanken oder Datenbanken mit aktivem WAL werden abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspection limitée des tables, du schéma et des index depuis un instantané privé ; les bases occupées ou avec WAL actif sont refusées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限度地检查表、架构和索引的私有快照；拒绝忙碌或有活动 WAL 的数据库。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーブル、スキーマ、インデックスの非公開スナップショットを制限付きで確認します。使用中または稼働中 WAL のあるデータベースは受け付けません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तालिकाओं, स्कीमा और इंडेक्स के निजी स्नैपशॉट का सीमित निरीक्षण; व्यस्त या सक्रिय WAL डेटाबेस अस्वीकृत होते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola sînordar a wêneya demkî ya taybet a tablo, şema û indeksan; bingehên meşgûl an bi WAL a zindî tên redkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр таблиц, схемы и индексов по частному снимку с ограничениями; занятые базы или базы с активным WAL отклоняются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan berbatas untuk tabel, skema, dan indeks dalam salinan privat; basis data sibuk atau dengan WAL aktif ditolak."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টেবিল, স্কিমা ও সূচির ব্যক্তিগত স্ন্যাপশটের সীমাবদ্ধ পরীক্ষা; ব্যস্ত বা সক্রিয় WAL ডেটাবেস গ্রহণ করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba kwafin sirri na tebura, tsarin bayanai da fihirisa cikin iyaka; ana ƙin rumbunan bayanai masu aiki ko WAL mai rai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspeção limitada de tabelas, esquema e índices em uma cópia privada; bancos ocupados ou com WAL ativo são recusados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspección limitada de tablas, esquema e índices en una copia privada; se rechazan bases ocupadas o con WAL activo."
          }
        }
      }
    },
