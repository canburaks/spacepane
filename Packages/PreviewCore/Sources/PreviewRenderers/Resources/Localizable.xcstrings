    "format.cad.iges.description": {
      "comment": "CAD preview user interface. Translation draft; requires native-speaker and host review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local 3D preview. Disabled by default because CAD import can use substantial time and memory."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel 3B önizleme. CAD içe aktarımı önemli ölçüde zaman ve bellek kullanabildiği için varsayılan olarak kapalıdır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale 3D-Vorschau. Standardmäßig deaktiviert, da der CAD-Import viel Zeit und Speicher benötigen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu 3D local. Désactivé par défaut, car l’importation CAD peut demander beaucoup de temps et de mémoire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 3D 预览。默认关闭，因为 CAD 导入可能消耗较多时间和内存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル3Dプレビュー。CADの読み込みには多くの時間とメモリが必要な場合があるため、初期状態では無効です。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय 3D पूर्वावलोकन। डिफ़ॉल्ट रूप से बंद है क्योंकि CAD आयात में अधिक समय और मेमोरी लग सकती है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtina 3D ya herêmî. Ji destpêkê ve girtî ye, ji ber ku anîna CAD dikare gelek dem û bîrê bikar bîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный 3D-просмотр. По умолчанию выключен, поскольку импорт CAD может требовать много времени и памяти."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau 3D lokal. Dinonaktifkan secara bawaan karena impor CAD dapat memerlukan banyak waktu dan memori."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় 3D প্রিভিউ। স্বাভাবিকভাবে বন্ধ থাকে, কারণ CAD আমদানিতে অনেক সময় ও মেমরি লাগতে পারে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duban 3D na cikin naʼura. Ana kashe shi a asali saboda shigo da CAD na iya ɗaukar lokaci da ƙwaƙwalwa mai yawa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia 3D local. Desativada por padrão, pois a importação CAD pode consumir muito tempo e memória."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa 3D local. Desactivada por defecto porque la importación CAD puede consumir mucho tiempo y memoria."
          }
        }
      }
    },
