            "state": "translated",
            "value": "पूर्वावलोकन प्रसंस्करण समय सीमा पर पहुँच गया।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtin gihîşt sînorê dema pêvajoyê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнуто ограничение времени обработки предпросмотра."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau mencapai batas waktu pemrosesan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রিভিউ প্রক্রিয়াকরণের সময়সীমায় পৌঁছেছে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubawar ta kai iyakar lokacin sarrafawa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pré-visualização atingiu o limite de tempo de processamento."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
