    "format.text.mermaid.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native flowcharts, sequence, state, class, entity-relationship and pie diagrams plus safe source; nothing is run or fetched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel akış şemaları, sıra, durum, sınıf, varlık-ilişki ve pasta diyagramları ile güvenli kaynak; hiçbir şey çalıştırılmaz veya alınmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Flussdiagramme sowie Sequenz-, Zustands-, Klassen-, Entity-Relationship- und Kreisdiagramme plus sichere Quelle; nichts wird ausgeführt oder abgerufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organigrammes, diagrammes de séquence, d’états, de classes, entité-relation et en secteurs natifs, plus la source sûre ; rien n’est exécuté ni récupéré."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生绘制流程图、时序图、状态图、类图、实体关系图和饼图，并提供安全源码；不会运行或获取任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フローチャート、シーケンス図、状態遷移図、クラス図、ER 図、円グラフをネイティブに描画し、安全なソースも表示します。何も実行・取得しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्लोचार्ट, अनुक्रम, स्टेट, क्लास, एंटिटी-रिलेशनशिप और पाई आरेख मूल रूप से बनाए जाते हैं, साथ में सुरक्षित स्रोत; कुछ भी चलाया या लाया नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyagramên herikînê, rêzê, rewşan, çînan, hebûn-têkilî û pîrê bi awayekî xwerû têne xêzkirin û çavkaniya ewle jî heye; tiştek nayê xebitandin an anîn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блок-схемы, диаграммы последовательности, состояний, классов, «сущность—связь» и круговые рисуются нативно, плюс безопасный исходный код; ничего не запускается и не загружается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagram alir, urutan, status, kelas, entitas-relasi, dan lingkaran digambar secara native beserta sumber aman; tidak ada yang dijalankan atau diambil."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্লোচার্ট, সিকোয়েন্স, স্টেট, ক্লাস, এনটিটি-রিলেশনশিপ ও পাই ডায়াগ্রাম নেটিভভাবে আঁকা হয়, সাথে নিরাপদ সোর্স; কিছুই চালানো বা আনা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana zana zanen tafiyar aiki, jeri, yanayi, aji, abu-da-alaƙa da daʼira kai tsaye tare da amintaccen tushe; ba a gudanar ko ɗauko komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluxogramas, diagramas de sequência, de estados, de classes, entidade-relacionamento e de pizza desenhados nativamente, além da origem segura; nada é executado nem buscado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagramas de flujo, de secuencia, de estados, de clases, entidad-relación y circulares dibujados de forma nativa, más el origen seguro; no se ejecuta ni se descarga nada."
          }
        }
      }
    },
