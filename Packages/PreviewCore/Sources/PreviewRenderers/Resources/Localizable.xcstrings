    "about.privacy.body": {
      "comment": "Placeholder is the replaceable app display name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ processes files locally on your Mac. No file content leaves your device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosyaları Mac'inizde yerel olarak işler. Hiçbir dosya içeriği cihazınızdan çıkmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verarbeitet Dateien lokal auf Ihrem Mac. Kein Dateiinhalt verlässt Ihr Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ traite les fichiers localement sur votre Mac. Aucun contenu de fichier ne quitte votre appareil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在你的 Mac 上本地处理文件。任何文件内容都不会离开你的设备。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は Mac 上でファイルをローカルに処理します。ファイルの内容がデバイスの外に出ることはありません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फ़ाइलों को आपके Mac पर स्थानीय रूप से प्रोसेस करता है। फ़ाइल की कोई सामग्री आपके डिवाइस से बाहर नहीं जाती।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pelan li ser Macê te bi herêmî pêvajo dike. Naveroka tu pelê ji cîhaza te dernakeve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ обрабатывает файлы локально на вашем Mac. Содержимое файлов не покидает ваше устройство."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ memproses berkas secara lokal di Mac Anda. Tidak ada konten berkas yang keluar dari perangkat Anda."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আপনার Mac-এ স্থানীয়ভাবে ফাইল প্রসেস করে। কোনো ফাইলের বিষয়বস্তু আপনার ডিভাইস ছেড়ে যায় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yana sarrafa fayiloli a cikin Mac ɗinku. Babu abin da ke cikin fayil da ke barin naʼurarku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ processa arquivos localmente no seu Mac. Nenhum conteúdo de arquivo sai do seu dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ procesa los archivos localmente en tu Mac. Ningún contenido de archivo sale de tu dispositivo."
          }
        }
      }
    },
