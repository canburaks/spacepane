    "settings.providers.none": {
      "comment": "Result when no other app with an overlapping Quick Look extension was found. It only covers folders that could be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other app with an overlapping Quick Look extension was found in the folders that could be read."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunabilen klasörlerde, çakışan bir Quick Look uzantısına sahip başka bir uygulama bulunamadı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den lesbaren Ordnern wurde keine andere App mit einer überschneidenden Quick Look-Erweiterung gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune autre app dotée d’une extension Quick Look se recoupant n’a été trouvée dans les dossiers lisibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在可读取的文件夹中，未发现其他带有重叠快速查看扩展的应用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れたフォルダの中に、対象が重なるクイックルック機能拡張を持つほかのアプリは見つかりませんでした。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़े जा सकने वाले फ़ोल्डरों में ओवरलैप करने वाले Quick Look एक्सटेंशन वाला कोई अन्य ऐप नहीं मिला।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Di peldankên ku dihate xwendin de sepaneke din a bi pêvekeke Quick Look a hevpar nehat dîtin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папках, которые удалось прочитать, не найдено других приложений с пересекающимся расширением Quick Look."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan aplikasi lain dengan ekstensi Quick Look yang tumpang tindih di folder yang dapat dibaca."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব ফোল্ডার পড়া গেছে সেখানে অন্য কোনো অ্যাপে একই ধরনের Quick Look এক্সটেনশন পাওয়া যায়নি।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a sami wata manhaja mai ƙarin Quick Look da ke haɗuwa ba a cikin manyan fayilolin da za a iya karantawa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum outro app com extensão do Quick Look sobreposta foi encontrado nas pastas que puderam ser lidas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna otra app con una extensión de Quick Look coincidente en las carpetas que se pudieron leer."
          }
        }
      }
    },
