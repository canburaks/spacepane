    "finding.autorun.agentHooks": {
      "comment": "Safety finding for the settings of an AI coding agent: the number of commands (called hooks) that run by themselves whenever the AI agent performs an action. A hook is a command attached to an agent event. The command is not shown. %2$@ is the number of commands. The count is formatted by the app for the display locale and is never part of the translation. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
