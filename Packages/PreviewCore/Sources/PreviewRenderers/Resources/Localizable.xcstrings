    "preview.markup.references.languageNote": {
      "comment": "Second sentence of the status line shown with a formatted reference list (BibTeX). It says that the terms inside the citations (such as et al., n.d., pp., Ed., thesis types) are the English terms of each style guide (APA, MLA, Chicago, IEEE) and are not translated. One short sentence, no placeholders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Citation terms follow each style guide’s English conventions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atıf terimleri, her stil kılavuzunun İngilizce kurallarını izler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zitierbegriffe folgen den englischen Konventionen des jeweiligen Stilleitfadens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les termes des citations suivent les conventions anglaises de chaque guide de style."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引文中的术语遵循各格式指南的英文惯例。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用中の用語は、各スタイルガイドの英語の慣例に従っています。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उद्धरण के शब्द प्रत्येक शैली-मार्गदर्शिका की अंग्रेज़ी परंपराओं का पालन करते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Termên referansan li gorî peymanên Îngilîzî yên her rêbera şêwazê ne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Термины в ссылках следуют английским правилам каждого руководства по стилю."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Istilah kutipan mengikuti konvensi bahasa Inggris dari setiap panduan gaya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উদ্ধৃতির পরিভাষা প্রতিটি শৈলী-নির্দেশিকার ইংরেজি রীতি অনুসরণ করে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalmomin ambato suna bin ƙaʼidojin Turanci na kowace jagorar salo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os termos das citações seguem as convenções em inglês de cada guia de estilo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los términos de las citas siguen las convenciones en inglés de cada guía de estilo."
          }
        }
      }
    },
    "preview.markup.references.notice": {
      "comment": "Caption under the citation style control: the list is formatted with simplified rules.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatted from the BibTeX fields with simplified style rules. Check the style guide before citing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX alanlarından basitleştirilmiş stil kurallarıyla biçimlendirildi. Alıntı yapmadan önce stil kılavuzunu kontrol edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus den BibTeX-Feldern mit vereinfachten Stilregeln formatiert. Prüfen Sie vor dem Zitieren den Stilleitfaden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis en forme à partir des champs BibTeX avec des règles de style simplifiées. Vérifiez le guide de style avant de citer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据 BibTeX 字段按简化的格式规则生成。引用前请核对格式指南。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX のフィールドから簡略化したスタイル規則で整形しています。引用する前にスタイルガイドを確認してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX फ़ील्ड से सरलीकृत शैली नियमों के अनुसार स्वरूपित। उद्धरण देने से पहले शैली-मार्गदर्शिका जाँचें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji qadên BibTeX bi rêzikên şêwazê yên sade hatiye formatkirin. Beriya referansdanê rêbera şêwazê kontrol bike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформлено по полям BibTeX с упрощёнными правилами стиля. Перед цитированием сверьтесь с руководством по стилю."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diformat dari bidang BibTeX dengan aturan gaya yang disederhanakan. Periksa panduan gaya sebelum mengutip."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX ক্ষেত্র থেকে সরলীকৃত শৈলী-নিয়মে বিন্যস্ত। উদ্ধৃত করার আগে শৈলী-নির্দেশিকা দেখে নিন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An tsara daga filayen BibTeX da dokokin salo masu sauƙi. Duba jagorar salo kafin ambato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatado a partir dos campos BibTeX com regras de estilo simplificadas. Consulte o guia de estilo antes de citar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formateado a partir de los campos BibTeX con reglas de estilo simplificadas. Consulta la guía de estilo antes de citar."
          }
        }
