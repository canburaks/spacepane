          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribution de %1$@ à %2$@, plages : %3$@, effectifs : %4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分布范围从 %1$@ 到 %2$@，共 %3$@ 个区间，各区间的数量依次为 %4$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ から %2$@ までの分布。区間数は %3$@、各区間の件数は %4$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ से %2$@ तक का वितरण, श्रेणियों की संख्या: %3$@, गिनती: %4$@"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Belavbûna ji %1$@ heta %2$@, hejmara navberan: %3$@, hejmar: %4$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распределение от %1$@ до %2$@, диапазонов: %3$@, количества: %4$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribusi dari %1$@ hingga %2$@ dalam %3$@ rentang, dengan jumlah %4$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ থেকে %2$@ পর্যন্ত বণ্টন, পরিসরের সংখ্যা: %3$@, গণনা: %4$@"
          }
        },
        "ha": {
          "stringUnit": {
