    "appearance.profile.saveInvalid": {
      "comment": "Explanation shown under the profile name field on the Theme page, and as the Save button's hint, when the typed name is too long (over 128 bytes of text) or contains a line break, a control character or a text direction mark. One sentence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a shorter name without line breaks or control characters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır sonu veya denetim karakteri içermeyen daha kısa bir ad kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie einen kürzeren Namen ohne Zeilenumbrüche oder Steuerzeichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un nom plus court, sans retour à la ligne ni caractère de contrôle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用更短的名称，且不含换行或控制字符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改行や制御文字を含まない、より短い名前を使用してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटा नाम उपयोग करें, जिसमें लाइन ब्रेक या नियंत्रण वर्ण न हों।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Navekî kurttir bêyî şikestina rêzê an tîpên kontrolê bi kar bîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте более короткое имя без переносов строк и управляющих символов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan nama yang lebih pendek tanpa pemisah baris atau karakter kontrol."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইন ব্রেক বা কন্ট্রোল ক্যারেক্টার ছাড়া ছোট একটি নাম ব্যবহার করুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da gajeriyar suna ba tare da karya layi ko haruffan sarrafawa ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um nome mais curto, sem quebras de linha nem caracteres de controle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un nombre más corto, sin saltos de línea ni caracteres de control."
          }
        }
      }
    },
