    "finding.archive.caseCollisions": {
      "comment": "Archive check: macOS volumes are usually case-insensitive. %lld is a count (Int64). Keep the wording independent of singular and plural.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names that differ only in capitalization and would replace each other on a Mac: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca büyük/küçük harfle ayrılan ve Mac üzerinde birbirinin yerini alacak adlar: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen, die sich nur in der Groß-/Kleinschreibung unterscheiden und sich auf einem Mac gegenseitig ersetzen würden: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms qui ne diffèrent que par la casse et se remplaceraient mutuellement sur un Mac : %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅大小写不同、在 Mac 上会互相覆盖的名称：%lld。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字と小文字だけが異なり、Mac では互いを置き換えてしまう名前: %lld。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल बड़े/छोटे अक्षर के अंतर वाले नाम, जो Mac पर एक-दूसरे को बदल देंगे: %lld।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Navên ku tenê di mezin/biçûkiya tîpan de cuda ne û dê li ser Mac şûna hev bigirin: %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена, которые отличаются только регистром букв и перезапишут друг друга на Mac: %lld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama yang hanya berbeda huruf besar/kecil dan akan saling menimpa di Mac: %lld."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু বড়/ছোট হাতের অক্ষরে ভিন্ন এবং Mac-এ একটি অন্যটিকে প্রতিস্থাপন করবে এমন নাম: %lld।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunayen da suka bambanta kawai a manyan ko ƙananan haruffa kuma za su maye gurbin juna a kan Mac: %lld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes que diferem apenas em maiúsculas e minúsculas e se substituiriam em um Mac: %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres que solo se diferencian en mayúsculas y minúsculas y se sustituirían entre sí en un Mac: %lld."
          }
        }
      }
    },
    "finding.archive.directionalName": {
      "comment": "Archive check for Unicode bidirectional control characters in entry names. %lld is a count (Int64). Keep the wording independent of singular and plural.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names with direction-changing characters that can disguise them: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı yönünü değiştiren karakterler içeren, yanıltıcı olabilecek adlar: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen mit Zeichen, die die Schreibrichtung ändern und sie verschleiern können: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms contenant des caractères de changement de direction qui peuvent les déguiser : %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "含有可改变文字方向、可能用于伪装的字符的名称：%lld。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の方向を変える文字を含み、見せかけに悪用されうる名前: %lld。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिशा बदलने वाले अक्षरों वाले नाम, जो उन्हें भ्रामक बना सकते हैं: %lld।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Navên bi tîpên ku alîyê nivîsê diguherînin û dikarin wan veşêrin: %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена с символами смены направления текста, которые могут их маскировать: %lld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama dengan karakter pengubah arah yang dapat menyamarkannya: %lld."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিক পরিবর্তনকারী অক্ষরযুক্ত নাম, যা সেগুলোকে ছদ্মবেশী করতে পারে: %lld।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunayen da ke ɗauke da haruffa masu canza alkibla waɗanda za su iya ɓoye su: %lld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes com caracteres que mudam a direção do texto e podem disfarçá-los: %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres con caracteres que cambian la dirección del texto y pueden disfrazarlos: %lld."
          }
        }
      }
    },
    "finding.archive.disguisedName": {
      "comment": "Archive check for a document-like extension followed by a program extension. Keep the example file name unchanged. %lld is a count (Int64). Keep the wording independent of singular and plural.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names that disguise their real type, like “invoice.pdf.app”: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek türünü gizleyen adlar, örneğin “invoice.pdf.app”: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen, die ihren wahren Typ verschleiern, wie „invoice.pdf.app“: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms qui masquent leur vrai type, comme « invoice.pdf.app » : %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伪装真实类型的名称，如“invoice.pdf.app”：%lld。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の種類を偽装した名前（例:「invoice.pdf.app」）: %lld。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना असली प्रकार छिपाने वाले नाम, जैसे “invoice.pdf.app”: %lld।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Navên ku cureyê xwe yê rast vedişêrin, wekî “invoice.pdf.app”: %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена, маскирующие настоящий тип, например «invoice.pdf.app»: %lld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama yang menyamarkan tipe aslinya, seperti “invoice.pdf.app”: %lld."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আসল ধরন ছদ্মবেশে ঢাকা নাম, যেমন “invoice.pdf.app”: %lld।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunayen da ke ɓoye ainihin nauʼinsu, kamar “invoice.pdf.app”: %lld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes que disfarçam o tipo real, como “invoice.pdf.app”: %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres que disfrazan su tipo real, como «invoice.pdf.app»: %lld."
          }
        }
      }
