    "finding.extension.relaxedScriptPolicy": {
      "comment": "Safety finding for a browser extension: its content security policy allows 'unsafe-eval', which lets the extension turn text, possibly downloaded, into running code. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its security policy allows running text as code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik ilkesi, metnin kod olarak çalıştırılmasına izin veriyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherheitsrichtlinie erlaubt es, Text als Code auszuführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa politique de sécurité autorise l’exécution de texte comme code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其安全策略允许将文本作为代码运行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティポリシーにより、テキストをコードとして実行できます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी सुरक्षा नीति टेक्स्ट को कोड के रूप में चलाने की अनुमति देती है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Polîtîkaya wê ya ewlehiyê dihêle ku nivîs wekî kod bê xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его политика безопасности разрешает выполнять текст как код."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan keamanannya mengizinkan teks dijalankan sebagai kode."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর নিরাপত্তা নীতি টেক্সটকে কোড হিসেবে চালানোর অনুমতি দেয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Manufofin tsaronta suna ba da damar gudanar da rubutu a matsayin lamba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A política de segurança dela permite executar texto como código."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su política de seguridad permite ejecutar texto como código."
          }
        }
      }
    },
    "finding.extension.selfHostedUpdates": {
      "comment": "Safety finding for a browser extension: the extension names its own update address instead of the browser's official extension store, so later versions skip the store's review. The address is not shown. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates from its own server instead of the browser’s store."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcının mağazası yerine kendi sunucusundan güncellenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert sich von einem eigenen Server statt aus dem Store des Browsers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se met à jour depuis son propre serveur plutôt que depuis la boutique du navigateur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从自己的服务器更新，而不是浏览器的商店。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのストアではなく、独自のサーバからアップデートされます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र के स्टोर की जगह अपने ही सर्वर से अपडेट होता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Li şûna firoşgeha gerokê, ji serverê xwe yê taybet nûve dibe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновляется со своего сервера, а не из магазина браузера."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbarui dari servernya sendiri, bukan dari toko peramban."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্রাউজারের স্টোরের বদলে নিজের সার্ভার থেকে আপডেট হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana sabunta kansa daga server ɗinsa, ba daga shagon burauza ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza a partir do próprio servidor, em vez da loja do navegador."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se actualiza desde su propio servidor, en lugar de la tienda del navegador."
          }
        }
      }
    },
