    "finding.artifact.mismatchedContent": {
      "comment": "Safety finding: the bytes of the file are in a different format from the one its name (suffix) says, for example a file named as a PyTorch checkpoint that is really a 7z archive. Attackers use this to slip files past tools that trust the name. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content is a different format from what the file name says."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriğin biçimi, dosya adının belirttiği biçimden farklı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt hat ein anderes Format, als der Dateiname angibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu est d’un autre format que celui indiqué par le nom du fichier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件内容的格式与文件名所示的格式不一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容の形式が、ファイル名が示す形式と異なります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामग्री का प्रारूप फ़ाइल के नाम में बताए गए प्रारूप से अलग है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma naverokê ji ya ku navê pelê dibêje cuda ye."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат содержимого отличается от указанного в имени файла."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format kontennya berbeda dari yang ditunjukkan nama berkas."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়বস্তুর ফরম্যাট ফাইলের নামে উল্লেখ করা ফরম্যাট থেকে আলাদা।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsarin abubuwan da ke ciki ya bambanta da wanda sunan fayil ya nuna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo está em um formato diferente do indicado pelo nome do arquivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido tiene un formato distinto del que indica el nombre del archivo."
          }
        }
      }
    },
    "finding.artifact.nativeCode": {
      "comment": "Safety finding for a package, extension, AI bundle or model archive: the number of files inside it that are native machine code (programs or libraries compiled for a processor, such as Mach-O, ELF, Windows .exe/.dll files or Node.js .node add-ons). Native code can do anything the user can do and cannot be read like a script. Say it as a fact, not as a verdict that the file is harmful. %2$@ is the number. The count is formatted by the app for the display locale and is never part of the translation. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
