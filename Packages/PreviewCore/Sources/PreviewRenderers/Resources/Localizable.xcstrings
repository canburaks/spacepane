    "format.text.source-code.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only source with bounded lexical highlighting and likely secrets concealed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı sözcüksel vurgulama ve olası gizli bilgileri gizlenmiş salt okunur kaynak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützter Quellcode mit begrenzter lexikalischer Hervorhebung und verborgenen wahrscheinlichen Geheimnissen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source en lecture seule avec coloration lexicale limitée et secrets probables masqués."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读源码，提供有限度的词法高亮并隐藏可能的机密信息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密情報と思われる部分を隠し、制限付き字句ハイライトを使用する読み取り専用ソース。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित लेक्सिकल हाइलाइटिंग वाला केवल पढ़ने का स्रोत, जिसमें संभावित गोपनीय जानकारी छिपाई जाती है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Çavkaniya tenê-xwendinê bi rengkirina peyvan a sînordar û agahiyên veşartî yên têne veşartin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный код только для чтения с ограниченной лексической подсветкой и скрытием вероятных секретов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber hanya baca dengan penyorotan leksikal berbatas dan informasi yang diduga rahasia disamarkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমাবদ্ধ আভিধানিক হাইলাইটিংসহ শুধু পড়ার উৎস, যেখানে সম্ভাব্য গোপন তথ্য লুকানো হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tushe don karantawa kawai, da bambanta kalmomi cikin iyaka da ɓoye bayanan da ake zaton sirri ne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Código-fonte somente para leitura, com realce lexical limitado e possíveis segredos ocultados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código fuente de solo lectura con resaltado léxico limitado y posibles secretos ocultos."
          }
        }
      }
    },
