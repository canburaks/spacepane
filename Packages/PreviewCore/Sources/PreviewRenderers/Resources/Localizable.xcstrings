    "format.text.org.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline Org mode headings, lists, blocks and tables plus safe source; nothing is evaluated or exported."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı Org mode başlıkları, listeleri, blokları ve tabloları ile güvenli kaynak; hiçbir şey çalıştırılmaz veya dışa aktarılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline dargestellte Org-mode-Überschriften, Listen, Blöcke und Tabellen sowie sichere Quelle; nichts wird ausgewertet oder exportiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres, listes, blocs et tableaux Org mode hors ligne et source sûre ; rien n’est évalué ni exporté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线显示 Org mode 的标题、列表、块和表格，并提供安全源码；不会执行或导出任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Org mode の見出し、リスト、ブロック、表をオフラインで表示し、安全なソースも提供します。評価もエクスポートも行いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Org mode के शीर्षक, सूचियाँ, ब्लॉक और तालिकाएँ ऑफ़लाइन, साथ में सुरक्षित स्रोत; कुछ भी चलाया या निर्यात नहीं किया जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sernivîs, lîste, blok û tabloyên Org mode ên negirêdayî û çavkaniya ewle; tiştek nayê xebitandin an derxistin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки, списки, блоки и таблицы Org mode без сети и безопасный исходник; ничего не вычисляется и не экспортируется."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul, daftar, blok, dan tabel Org mode secara luring plus sumber aman; tidak ada yang dievaluasi atau diekspor."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইনে Org mode শিরোনাম, তালিকা, ব্লক ও টেবিল এবং নিরাপদ উৎস; কিছুই চালানো বা রপ্তানি করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken Org mode, jeri, tubalan da teburan ba tare da intanet ba, tare da amintaccen tushe; ba a gudanar ko fitar da komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos, listas, blocos e tabelas Org mode offline, mais código-fonte seguro; nada é avaliado nem exportado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encabezados, listas, bloques y tablas de Org mode sin conexión, más código fuente seguro; no se evalúa ni se exporta nada."
          }
        }
      }
    },
