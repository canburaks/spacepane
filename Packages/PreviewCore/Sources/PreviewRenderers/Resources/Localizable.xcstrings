    "finding.pickle.runsCode": {
      "comment": "Safety finding for a Python pickle or PyTorch checkpoint: the number of imports (named Python functions the file asks for when loaded, such as os.system or eval) that can run commands or code. The app never loads the file; it only reads which names it asks for. 'Loading' means opening it in Python, for example with torch.load. %2$@ is the number. The count is formatted by the app for the display locale and is never part of the translation. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
