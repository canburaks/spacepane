    },
    "settings.behavior.reloadSubtitle": {
      "comment": "Explanation under the reload switch. Describes new versus already open previews.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preview that stays open reads its file again after the file changes on disk. A new preview always reads the current file."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık kalan bir önizleme, dosya diskte değiştikten sonra dosyasını yeniden okur. Yeni bir önizleme her zaman güncel dosyayı okur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geöffnete Vorschau liest ihre Datei erneut, nachdem sich die Datei auf dem Datenträger geändert hat. Eine neue Vorschau liest immer die aktuelle Datei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aperçu qui reste ouvert relit son fichier après que celui-ci a changé sur le disque. Un nouvel aperçu lit toujours le fichier actuel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持打开的预览会在文件于磁盘上更改后重新读取该文件。新的预览始终读取当前文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたままのプレビューは、ディスク上のファイルが変更されると、そのファイルを再び読み込みます。新しいプレビューは常に最新のファイルを読み込みます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुला रहने वाला पूर्वावलोकन, डिस्क पर फ़ाइल बदलने के बाद उसे फिर से पढ़ता है। नया पूर्वावलोकन हमेशा मौजूदा फ़ाइल पढ़ता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtina ku vekirî dimîne piştî ku pel li ser dîskê diguhere, pelê xwe dîsa dixwîne. Pêşdîtineke nû her dem pelê heyî dixwîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытый предпросмотр заново читает файл после его изменения на диске. Новый предпросмотр всегда читает текущий файл."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau yang tetap terbuka membaca ulang berkasnya setelah berkas berubah di disk. Pratinjau baru selalu membaca berkas terbaru."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খোলা থাকা প্রিভিউ ডিস্কে ফাইল বদলে গেলে ফাইলটি আবার পড়ে। নতুন প্রিভিউ সব সময় বর্তমান ফাইল পড়ে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubawar da ke buɗe tana sake karanta fayil ɗinta bayan fayil ɗin ya canza a diski. Sabuwar dubawa kullum tana karanta fayil ɗin na yanzu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pré-visualização que permanece aberta lê o arquivo novamente depois que ele muda no disco. Uma nova pré-visualização sempre lê o arquivo atual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vista previa que permanece abierta vuelve a leer su archivo después de que este cambie en el disco. Una vista previa nueva siempre lee el archivo actual."
          }
        }
      }
    },
    "settings.behavior.reloadTitle": {
      "comment": "Switch title. When on, a preview that stays open reads its file again after the file changes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload previews when the file changes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya değiştiğinde önizlemeleri yeniden yükle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau neu laden, wenn sich die Datei ändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharger les aperçus lorsque le fichier change"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件更改时重新载入预览"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが変更されたらプレビューを再読み込み"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल बदलने पर पूर्वावलोकन फिर से लोड करें"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gava pel diguhere pêşdîtinan ji nû ve barke"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновлять предпросмотр при изменении файла"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat ulang pratinjau saat berkas berubah"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল বদলালে প্রিভিউ আবার লোড করুন"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sake loda dubawa idan fayil ya canza"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarregar pré-visualizações quando o arquivo mudar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recargar vistas previas cuando cambie el archivo"
          }
        }
      }
    },
    "settings.behavior.thumbnailsSubtitle": {
      "comment": "Privacy explanation under the thumbnail contents switch: only text that passed the redaction filter is drawn, and macOS may keep older thumbnails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumbnails of supported files may show a small excerpt. Only text that has passed the privacy filter is drawn, so likely secrets stay hidden. macOS may keep earlier thumbnails for a while."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen dosyaların küçük resimleri kısa bir alıntı gösterebilir. Yalnızca gizlilik filtresinden geçen metin çizilir; bu yüzden olası gizli bilgiler gizli kalır. macOS önceki küçük resimleri bir süre saklayabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniaturbilder unterstützter Dateien können einen kurzen Auszug zeigen. Es wird nur Text gezeichnet, der den Datenschutzfilter durchlaufen hat; wahrscheinliche Geheimnisse bleiben also verborgen. macOS behält frühere Miniaturbilder möglicherweise noch eine Weile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vignettes des fichiers pris en charge peuvent afficher un court extrait. Seul le texte ayant passé le filtre de confidentialité est dessiné : les secrets probables restent donc masqués. macOS peut conserver les vignettes précédentes pendant un certain temps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受支持文件的缩略图可能显示一小段摘录。仅绘制已通过隐私过滤的文本，因此疑似机密信息会保持隐藏。macOS 可能会暂时保留之前的缩略图。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応ファイルのサムネイルには、短い抜粋が表示されることがあります。プライバシーフィルタを通過したテキストだけが描画されるため、機密と思われる値は表示されません。macOSは以前のサムネイルをしばらく保持する場合があります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित फ़ाइलों के थंबनेल में एक छोटा अंश दिख सकता है। केवल वही टेक्स्ट बनाया जाता है जो गोपनीयता फ़िल्टर से गुज़रा हो, इसलिए संभावित गोपनीय मान छिपे रहते हैं। macOS पहले के थंबनेल कुछ समय तक रख सकता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Wêneyên biçûk ên pelên piştgirîkirî dikarin perçeyeke kurt nîşan bidin. Tenê nivîsa ku ji parzûna nepenîtiyê derbas bûye tê xêzkirin, ji ber vê yekê nepenîyên mimkûn veşartî dimînin. macOS dikare wêneyên biçûk ên berê demekê biparêze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Миниатюры поддерживаемых файлов могут показывать небольшой фрагмент. Отображается только текст, прошедший фильтр конфиденциальности, поэтому вероятные секреты остаются скрытыми. macOS может некоторое время хранить прежние миниатюры."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar mini berkas yang didukung dapat menampilkan kutipan singkat. Hanya teks yang lolos filter privasi yang digambar, sehingga rahasia yang mungkin ada tetap tersembunyi. macOS dapat menyimpan gambar mini sebelumnya untuk sementara waktu."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমর্থিত ফাইলের থাম্বনেইলে ছোট একটি অংশ দেখানো হতে পারে। শুধু গোপনীয়তা ফিল্টার পেরোনো টেক্সটই আঁকা হয়, তাই সম্ভাব্য গোপন মান লুকানো থাকে। macOS আগের থাম্বনেইল কিছুদিন রেখে দিতে পারে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙananan hotunan fayilolin da ake tallafa wa na iya nuna ɗan gajeren yanki. Rubutun da ya wuce matatar sirri kawai ake zana, don haka ana ɓoye abubuwan da wataƙila sirri ne. macOS na iya riƙe ƙananan hotunan da suka gabata na ɗan lokaci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As miniaturas de arquivos compatíveis podem mostrar um pequeno trecho. Apenas o texto que passou pelo filtro de privacidade é desenhado, então prováveis segredos permanecem ocultos. O macOS pode manter miniaturas anteriores por algum tempo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las miniaturas de los archivos compatibles pueden mostrar un pequeño fragmento. Solo se dibuja el texto que ha pasado el filtro de privacidad, así que los posibles secretos siguen ocultos. macOS puede conservar miniaturas anteriores durante un tiempo."
          }
        }
      }
    },
