    "format.package.browser-extension.description": {
      "comment": "One-sentence description of a file type in the companion's File Types list: browser extension packages; the summary shows what the extension may access. Technical names stay as they are. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions, site access, update address and content security policy from the manifest. Nothing is installed or run."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manifestten izinler, site erişimi, güncelleme adresi ve içerik güvenliği ilkesi. Hiçbir şey kurulmaz veya çalıştırılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen, Website-Zugriff, Update-Adresse und Content-Security-Policy aus dem Manifest. Nichts wird installiert oder ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisations, accès aux sites, adresse de mise à jour et politique de sécurité du contenu, lus dans le manifeste. Rien n’est installé ni exécuté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从清单读取权限、网站访问、更新地址和内容安全策略。不会安装或运行任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マニフェストから、権限、サイトへのアクセス、アップデートのアドレス、コンテンツセキュリティポリシーを表示します。何もインストールや実行はしません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैनिफ़ेस्ट से अनुमतियाँ, साइट एक्सेस, अपडेट पता और कंटेंट सिक्योरिटी पॉलिसी। कुछ भी इंस्टॉल या चलाया नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Destûr, gihîştina malperan, navnîşana nûvekirinê û polîtîkaya ewlehiya naverokê ji manîfestoyê. Tiştek nayê sazkirin an xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешения, доступ к сайтам, адрес обновлений и политика безопасности контента из манифеста. Ничего не устанавливается и не запускается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin, akses situs, alamat pembaruan, dan kebijakan keamanan konten dari manifes. Tidak ada yang diinstal atau dijalankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যানিফেস্ট থেকে অনুমতি, সাইট অ্যাক্সেস, আপডেটের ঠিকানা ও কন্টেন্ট সিকিউরিটি পলিসি। কিছুই ইনস্টল বা চালানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Izini, damar shiga shafuka, adireshin sabuntawa da manufofin tsaron abun ciki daga manifest. Ba a shigar ko gudanar da komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissões, acesso a sites, endereço de atualização e política de segurança de conteúdo, lidos do manifesto. Nada é instalado nem executado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos, acceso a sitios, dirección de actualización y política de seguridad de contenido, leídos del manifiesto. No se instala ni se ejecuta nada."
          }
        }
      }
    },
