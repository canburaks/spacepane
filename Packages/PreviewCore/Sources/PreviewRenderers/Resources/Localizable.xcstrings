    "format.ml.gguf.description": {
      "comment": "One-sentence description of a file type in the companion's File Types list: GGUF AI model files; only the header is read, never the model weights. Technical names stay as they are. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Architecture, size, quantization, context length, license and chat template from the header. Model weights are never read."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst bilgiden mimari, boyut, nicemleme, bağlam uzunluğu, lisans ve sohbet şablonu. Model ağırlıkları hiçbir zaman okunmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Architektur, Größe, Quantisierung, Kontextlänge, Lizenz und Chat-Vorlage aus dem Header. Modellgewichte werden nie gelesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Architecture, taille, quantification, longueur de contexte, licence et modèle de conversation, lus dans l’en-tête. Les poids du modèle ne sont jamais lus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从头部读取架构、大小、量化方式、上下文长度、许可证和聊天模板。从不读取模型权重。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッダから、アーキテクチャ、サイズ、量子化、コンテキスト長、ライセンス、チャットテンプレートを表示します。モデルの重みは読み取りません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हेडर से आर्किटेक्चर, आकार, क्वांटाइज़ेशन, संदर्भ लंबाई, लाइसेंस और चैट टेम्प्लेट। मॉडल वेट कभी नहीं पढ़े जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mîmarî, mezinahî, quantization, dirêjahiya kontekstê, lîsans û şablona sohbetê ji sernivîsê. Giraniyên modelê tu carî nayên xwendin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архитектура, размер, квантование, длина контекста, лицензия и шаблон чата из заголовка. Веса модели никогда не читаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arsitektur, ukuran, kuantisasi, panjang konteks, lisensi, dan templat obrolan dari header. Bobot model tidak pernah dibaca."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হেডার থেকে আর্কিটেকচার, আকার, কোয়ান্টাইজেশন, কনটেক্সটের দৈর্ঘ্য, লাইসেন্স ও চ্যাট টেমপ্লেট। মডেলের ওয়েট কখনও পড়া হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsarin gine-gine, girma, quantization, tsawon context, lasisi da chat template daga kan fayil. Ba a taɓa karanta nauyin samfurin ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquitetura, tamanho, quantização, tamanho do contexto, licença e template de chat, lidos do cabeçalho. Os pesos do modelo nunca são lidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquitectura, tamaño, cuantización, longitud de contexto, licencia y plantilla de chat, leídos de la cabecera. Los pesos del modelo nunca se leen."
          }
        }
      }
    },
    "format.ml.gguf.name": {
