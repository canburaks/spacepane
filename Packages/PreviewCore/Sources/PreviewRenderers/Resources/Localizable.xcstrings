    "general.banner.sharedBody": {
      "comment": "Banner body next to the Open System Settings button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the extensions on in System Settings. macOS chooses the preview and thumbnail provider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzantıları Sistem Ayarları'nda açın. Önizleme ve küçük resim sağlayıcısını macOS seçer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die Erweiterungen in den Systemeinstellungen. macOS wählt den Anbieter für Vorschau und Miniaturbilder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les extensions dans Réglages Système. macOS choisit le fournisseur d’aperçus et de vignettes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”中开启这些扩展。预览和缩略图提供程序由 macOS 选择。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」で機能拡張をオンにしてください。プレビューとサムネイルのプロバイダは macOS が選択します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्ज़ में एक्सटेंशन चालू करें। पूर्वावलोकन और थंबनेल प्रदाता macOS चुनता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêvekan di Mîhengên Pergalê de çalak bike. macOS pêşkêşkarê pêşdîtin û wêneyên biçûk hildibijêre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите расширения в Системных настройках. Поставщика предпросмотра и миниатюр выбирает macOS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan ekstensi di Pengaturan Sistem. macOS memilih penyedia pratinjau dan gambar mini."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংসে এক্সটেনশন চালু করুন। প্রিভিউ ও থাম্বনেইল প্রদানকারী macOS বেছে নেয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunna ƙarin a Saitunan Tsari. macOS ne ke zaɓar mai samar da dubawa da ƙananan hotuna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as extensões em Ajustes do Sistema. O macOS escolhe o provedor de pré-visualização e miniaturas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las extensiones en Ajustes del Sistema. macOS elige el proveedor de vistas previas y miniaturas."
          }
        }
      }
    },
    "general.banner.sharedTitle": {
      "comment": "Banner title when the App Group container is available. Not a claim that the extensions are enabled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are shared with the Quick Look extensions"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar Quick Look uzantılarıyla paylaşılıyor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen werden mit den Quick Look-Erweiterungen geteilt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages sont partagés avec les extensions Quick Look"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已与快速查看扩展共享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はクイックルック機能拡張と共有されています"
          }
        },
        "hi": {
