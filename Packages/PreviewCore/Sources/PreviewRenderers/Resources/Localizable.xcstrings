    "settings.allTypesScope": {
      "comment": "Clarifies the scope of bulk file type actions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These actions apply to all shipped file types, including types hidden by search."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemler, arama nedeniyle gizlenenler dahil, uygulamada sunulan tüm dosya türlerine uygulanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktionen gelten für alle enthaltenen Dateitypen, auch für durch die Suche ausgeblendete Typen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces actions s’appliquent à tous les types inclus, y compris ceux masqués par la recherche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些操作适用于所有已提供的文件类型，包括搜索时隐藏的类型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの操作は、検索で非表示になった種類も含め、提供されているすべてのファイルの種類に適用されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये कार्रवाइयाँ ऐप में उपलब्ध सभी फ़ाइल प्रकारों पर लागू होती हैं, जिनमें खोज के कारण छिपे प्रकार भी शामिल हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev kiryar li ser hemû cureyên pelan ên di sepanê de tên pêşkêşkirin tên sepandin, tevî yên bi lêgerînê veşartî."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти действия применяются ко всем доступным типам файлов, включая скрытые поиском."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini berlaku untuk semua jenis berkas yang disertakan, termasuk yang disembunyikan oleh pencarian."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কাজগুলি অ্যাপে থাকা সব ফাইলের ধরনের জন্য প্রযোজ্য, অনুসন্ধানের কারণে লুকানো ধরনগুলিও এর অন্তর্ভুক্ত।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waɗannan ayyuka sun shafi duk nauʼoʼin fayil da manhajar ke bayarwa, har da waɗanda bincike ya ɓoye."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas ações se aplicam a todos os tipos de arquivo incluídos, mesmo aos ocultos pela busca."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas acciones se aplican a todos los tipos de archivo incluidos, también a los ocultos por la búsqueda."
          }
        }
      }
    },
