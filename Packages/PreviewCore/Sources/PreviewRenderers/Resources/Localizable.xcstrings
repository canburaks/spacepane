    "state.empty.body": {
      "comment": "Body under state.empty.title: one complete sentence ending with a period. There is no next step to give.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has no content, so there is nothing to preview."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriği olmadığı için önizlenecek bir şey yok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie hat keinen Inhalt, deshalb gibt es nichts anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne contient rien, il n’y a donc rien à afficher."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件没有内容，因此无可预览。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容がないため、プレビューするものがありません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें कोई सामग्री नहीं है, इसलिए पूर्वावलोकन के लिए कुछ नहीं है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Naverok tê de tune ye, ji ber vê yekê tiştek ji bo pêşdîtinê tune ye."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нём нет содержимого, поэтому предпросматривать нечего."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
