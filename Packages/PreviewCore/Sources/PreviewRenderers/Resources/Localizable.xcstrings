    "settings.groupTypesScope": {
      "comment": "Visible and accessibility help for group controls. The mixed state includes search-hidden group members.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This checkbox changes every type in this group, including types hidden by search."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu onay kutusu, arama nedeniyle gizlenenler dahil, gruptaki her türü değiştirir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Kontrollkästchen ändert alle Typen dieser Gruppe, auch die durch die Suche ausgeblendeten Typen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette case modifie tous les types du groupe, y compris ceux masqués par la recherche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此复选框会更改此组中的所有类型，包括搜索时隐藏的类型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェックボックスは、検索で非表示になった種類も含め、このグループのすべての種類を変更します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चेकबॉक्स इस समूह के सभी प्रकार बदलता है, जिनमें खोज के कारण छिपे प्रकार भी शामिल हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev qutiya hilbijartinê her cureya vê komê diguherîne, tevî yên bi lêgerînê veşartî."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот флажок изменяет все типы в группе, включая скрытые поиском."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotak centang ini mengubah setiap jenis dalam grup ini, termasuk yang disembunyikan oleh pencarian."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই চেকবক্স অনুসন্ধানে লুকানো ধরনসহ এই গোষ্ঠীর প্রতিটি ধরন পরিবর্তন করে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan akwatin zaɓi yana canza kowane nauʼi a rukuni, har da waɗanda bincike ya ɓoye."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta caixa altera todos os tipos neste grupo, mesmo os ocultos pela busca."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta casilla cambia todos los tipos de este grupo, también los ocultos por la búsqueda."
          }
        }
      }
    },
