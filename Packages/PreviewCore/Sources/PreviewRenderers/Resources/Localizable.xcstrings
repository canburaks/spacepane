    "format.model.obj.description": {
      "comment": "One-sentence description of the OBJ preview shown under the file-type switch. 'Polygon geometry' is a surface made of flat many-sided faces. The second sentence promises that material libraries, texture images and any other files an OBJ file refers to are never opened.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local 3D preview of polygon geometry. Materials, textures and linked files are never read."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çokgen geometrinin yerel 3B önizlemesi. Malzemeler, dokular ve bağlı dosyalar hiçbir zaman okunmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale 3D-Vorschau von Polygongeometrie. Materialien, Texturen und verknüpfte Dateien werden nie gelesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu 3D local de géométrie polygonale. Les matériaux, les textures et les fichiers liés ne sont jamais lus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多边形几何的本地 3D 预览。永远不会读取材质、纹理和关联文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポリゴン形状のローカル3Dプレビュー。マテリアル、テクスチャ、リンクされたファイルは読み込まれません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुभुज ज्यामिति का स्थानीय 3D पूर्वावलोकन। सामग्री, टेक्सचर और जुड़ी फ़ाइलें कभी नहीं पढ़ी जातीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtina 3D ya herêmî ji bo geometriya pirgoşe. Materyal, tekstûr û pelên girêdayî qet nayên xwendin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный 3D-просмотр полигональной геометрии. Материалы, текстуры и связанные файлы никогда не читаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau 3D lokal untuk geometri poligon. Material, tekstur, dan file tertaut tidak pernah dibaca."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বহুভুজ জ্যামিতির স্থানীয় 3D প্রিভিউ। ম্যাটেরিয়াল, টেক্সচার ও সংযুক্ত ফাইল কখনোই পড়া হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duban 3D na cikin naʼura na siffa mai kusurwoyi masu yawa. Ba a taɓa karanta kayan ƙira, tsarin saman da fayilolin da aka haɗa ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia 3D local de geometria poligonal. Materiais, texturas e arquivos vinculados nunca são lidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa 3D local de geometría poligonal. Nunca se leen materiales, texturas ni archivos vinculados."
          }
        }
      }
    },
