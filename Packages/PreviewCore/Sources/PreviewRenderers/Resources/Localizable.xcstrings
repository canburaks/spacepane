    "format.archive.xip.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded inner archive listings. Archive signatures are not verified."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı iç arşiv listeleri. Arşiv imzaları doğrulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Listen des inneren Archivs. Archivsignaturen werden nicht überprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listes limitées de l’archive interne. Les signatures d’archive ne sont pas vérifiées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限度地列出内部归档内容。不验证归档签名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部アーカイブの一覧を制限付きで表示します。アーカイブの署名は検証しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित आंतरिक संग्रह सूचियाँ। संग्रह हस्ताक्षर सत्यापित नहीं होते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lîsteyên arşîva hundirîn ên sînordar. Îmzeyên arşîvê nayên piştrastkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список содержимого внутреннего архива с ограничениями. Подписи архивов не проверяются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar arsip bagian dalam berbatas. Tanda tangan arsip tidak diverifikasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমাবদ্ধ ভেতরের আর্কাইভ তালিকা। আর্কাইভ স্বাক্ষর যাচাই করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Jerin kundin fayil na ciki mai iyaka. Ba a tabbatar da sa hannun kundin ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Listagens limitadas do arquivo interno. As assinaturas do arquivo não são verificadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listados limitados del archivo interno. No se verifican las firmas del archivo."
          }
        }
      }
    },
