    "format.audio.midi.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard MIDI format 0/1 with explicit playback using the macOS sound bank."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ses bankasını kullanarak açıkça başlatılan oynatmayla standart MIDI biçimi 0/1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-MIDI-Format 0/1 mit ausdrücklich gestarteter Wiedergabe über die macOS-Klangbank."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MIDI standard format 0/1 avec lecture explicite via la banque de sons macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准 MIDI 格式 0/1，使用 macOS 音色库，由用户明确开始播放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準 MIDI 形式 0/1。macOS のサウンドバンクを使い、明示的な操作で再生します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मानक MIDI प्रारूप 0/1, macOS साउंड बैंक के साथ उपयोगकर्ता द्वारा शुरू किया गया प्लेबैक।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma standard MIDI 0/1 bi lêdana ku bi xwe tê destpêkirin, bi banka dengê macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартный MIDI формата 0/1 с явным запуском воспроизведения через банк звуков macOS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format MIDI Standar 0/1 dengan pemutaran eksplisit menggunakan bank suara macOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মানক MIDI ফরম্যাট 0/1, macOS সাউন্ড ব্যাংক দিয়ে ব্যবহারকারীর স্পষ্ট নির্দেশে চালানো হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsarin MIDI na yau da kullum 0/1, da kunnawa bayan zaɓi ta amfani da bankin sauti na macOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "MIDI padrão nos formatos 0/1, com reprodução explícita usando o banco de sons do macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MIDI estándar en formatos 0/1, con reproducción explícita mediante el banco de sonidos de macOS."
          }
        }
      }
    },
