    "state.configurationUnavailable.title": {
      "comment": "Title of the state shown in place of a preview when this copy of the app is not set up to share settings with its previews. User-facing wording: never mention App Groups, entitlements or signing. Short, sentence case, no final period; the body is settings.extensionConfigurationUnavailable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not set up correctly"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama doğru kurulmamış"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist nicht korrekt eingerichtet"
          }
        },
        "fr": {
