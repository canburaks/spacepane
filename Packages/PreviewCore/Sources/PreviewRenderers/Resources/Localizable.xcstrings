    "settings.behavior.hiddenSubtitle": {
      "comment": "Explanation under the hidden items switch. Hidden items are files and folders whose names start with a dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List files and folders whose names start with a dot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adı nokta ile başlayan dosya ve klasörleri listeler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet Dateien und Ordner auf, deren Name mit einem Punkt beginnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Énumère les fichiers et dossiers dont le nom commence par un point."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出名称以点开头的文件和文件夹。"
          }
        },
        "ja": {
