    "format.data.jsonc.description": {
      "comment": "Description of the JSONC and JSON5 file type.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JSONC and JSON5 documents with comments, trailing commas and unquoted keys, as an outline and highlighted source. Likely secrets are concealed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorumlar, sondaki virgüller ve tırnaksız anahtarlar içeren JSONC ve JSON5 belgeleri; ana hat ve vurgulu kaynak olarak gösterilir. Olası sırlar gizlenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JSONC- und JSON5-Dokumente mit Kommentaren, nachgestellten Kommas und Schlüsseln ohne Anführungszeichen, als Gliederung und hervorgehobene Quelle. Wahrscheinliche Geheimnisse werden verborgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents JSONC et JSON5 avec commentaires, virgules finales et clés sans guillemets, en arborescence et en source colorée. Les secrets probables sont masqués."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带有注释、尾随逗号和无引号键的 JSONC 与 JSON5 文档，以大纲和高亮源码显示。可能的机密信息会被隐藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コメント、末尾のカンマ、引用符なしのキーを含む JSONC と JSON5 を、アウトラインと強調表示されたソースで表示します。機密と思われる値は隠されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टिप्पणियों, अंतिम अल्पविराम और बिना उद्धरण वाली कुंजियों वाले JSONC और JSON5 दस्तावेज़, रूपरेखा और हाइलाइट किए गए स्रोत के रूप में। संभावित गोपनीय जानकारी छिपाई जाती है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgeyên JSONC û JSON5 bi şîrove, vîrgulên dawî û mifteyên bê nîşankirin, wekî avahî û çavkaniya ronîkirî. Agahiyên veşartî yên gengaz têne veşartin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документы JSONC и JSON5 с комментариями, завершающими запятыми и ключами без кавычек: структура и подсвеченный исходный текст. Вероятные секреты скрываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen JSONC dan JSON5 dengan komentar, koma akhir, dan kunci tanpa tanda kutip, sebagai struktur dan sumber yang disorot. Rahasia yang mungkin disembunyikan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মন্তব্য, শেষের কমা ও উদ্ধৃতিচিহ্নহীন কী সহ JSONC ও JSON5 নথি, রূপরেখা ও হাইলাইট করা উৎস হিসেবে। সম্ভাব্য গোপন তথ্য লুকানো হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Takardun JSONC da JSON5 masu sharhi, waƙafi na ƙarshe da makullai marasa alamar zance, a matsayin tsari da tushe mai haske. Ana ɓoye sirrin da ake zato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentos JSONC e JSON5 com comentários, vírgulas finais e chaves sem aspas, como estrutura e fonte destacada. Prováveis segredos são ocultados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentos JSONC y JSON5 con comentarios, comas finales y claves sin comillas, como estructura y fuente resaltada. Los secretos probables se ocultan."
          }
        }
      }
    },
