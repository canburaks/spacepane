    "format.data.numpy-archive.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy .npz archives: array names, types and shapes, and the first numeric array; nothing is extracted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy .npz arşivleri: dizi adları, türleri ve şekilleri ile ilk sayısal dizi; hiçbir şey çıkarılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy-.npz-Archive: Array-Namen, -Typen und -Formen sowie das erste numerische Array; es wird nichts entpackt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives NumPy .npz : noms, types et formes des tableaux, ainsi que le premier tableau numérique ; rien n’est extrait."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy .npz 归档：数组名称、类型和形状，以及第一个数值数组；不会解压任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy .npz アーカイブ：配列の名前、型、形状と最初の数値配列。何も展開しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy .npz संग्रह: ऐरे के नाम, प्रकार और आकृतियाँ तथा पहला संख्यात्मक ऐरे; कुछ भी निकाला नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşîvên NumPy .npz: navên arrayan, cure û şeklên wan û arraya hejmarî ya yekem; tiştek nayê derxistin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивы NumPy .npz: имена, типы и формы массивов и первый числовой массив; ничего не распаковывается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arsip NumPy .npz: nama, tipe, dan bentuk array serta array numerik pertama; tidak ada yang diekstrak."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy .npz আর্কাইভ: অ্যারের নাম, ধরন ও আকৃতি এবং প্রথম সংখ্যাসূচক অ্যারে; কিছুই বের করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Taskar NumPy .npz: sunaye, nauʼi da siffar jeri da jerin lambobi na farko; ba a fitar da komai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos NumPy .npz: nomes, tipos e formatos dos arrays e o primeiro array numérico; nada é extraído."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos NumPy .npz: nombres, tipos y formas de los arrays y el primer array numérico; no se extrae nada."
          }
        }
      }
    },
