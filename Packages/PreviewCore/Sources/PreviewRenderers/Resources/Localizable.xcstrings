    "format.text.lrc.description": {
      "comment": "Description of the LRC synchronized lyrics type.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed LRC lyric lines with song tags as cues; word timings are removed from the list."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlı LRC şarkı sözü satırları ve şarkı etiketleri; sözcük zamanlamaları listeden çıkarılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitgesteuerte LRC-Textzeilen mit Song-Tags als Einträge; Wortzeiten werden aus der Liste entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lignes de paroles LRC minutées avec leurs balises de morceau ; les minutages par mot sont retirés de la liste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带时间的 LRC 歌词行及歌曲标签；逐字时间标记会从列表中移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング付きの LRC 歌詞行と曲タグをキューとして表示します。単語ごとのタイミングは一覧から取り除かれます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समयबद्ध LRC गीत पंक्तियाँ और गीत टैग प्रविष्टियों के रूप में; शब्द-समय सूची से हटा दिए जाते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rêzên gotinên LRC yên bi dem û etîketên stranê; demên peyvan ji lîsteyê têne rakirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строки LRC с метками времени и тегами песни; пословные метки времени удаляются из списка."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baris lirik LRC berwaktu dengan tag lagu; waktu per kata dihapus dari daftar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়যুক্ত LRC গানের লাইন ও গানের ট্যাগ; শব্দ-সময় তালিকা থেকে বাদ দেওয়া হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Layukan waƙa na LRC masu lokaci da alamun waƙa; ana cire lokutan kalmomi daga jerin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas de letra LRC temporizadas com marcas da música; os tempos por palavra são removidos da lista."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Líneas de letra LRC con tiempos y etiquetas de la canción; los tiempos por palabra se quitan de la lista."
          }
        }
      }
    },
