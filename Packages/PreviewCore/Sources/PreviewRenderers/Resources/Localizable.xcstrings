    "finding.extension.allSites": {
      "comment": "Safety finding for a browser extension (.xpi for Firefox, .crx for Chrome): the extension asks for access to all websites, so it can read and change any page the user opens. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can read and change every website you visit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziyaret ettiğiniz her web sitesini okuyabilir ve değiştirebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann jede von Ihnen besuchte Website lesen und ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut lire et modifier chaque site web que vous consultez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以读取和更改您访问的每个网站。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスするすべての Web サイトを読み取り、変更できます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो भी वेबसाइट देखते हैं, उसे पढ़ और बदल सकता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikare her malperê ku tu serdan dikî bixwîne û biguherîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может читать и изменять любой сайт, который вы посещаете."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat membaca dan mengubah setiap situs web yang Anda kunjungi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দেখা প্রতিটি ওয়েবসাইট পড়তে ও বদলাতে পারে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana iya karantawa da canza kowane shafin yanar gizo da kuka ziyarta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ler e alterar todos os sites que você visita."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede leer y modificar todos los sitios web que visitas."
          }
        }
      }
    },
