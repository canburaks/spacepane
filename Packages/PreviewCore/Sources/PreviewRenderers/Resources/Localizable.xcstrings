    "finding.action.copyConcealedHelp": {
      "comment": "Tooltip and accessibility help for the Copy Concealed Text button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the file’s text with likely secrets replaced by dots, ready to paste into a ticket or chat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyanın metnini, olası gizli bilgiler noktalarla değiştirilmiş olarak kopyalar; bir talebe veya sohbete yapıştırmaya hazırdır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert den Text der Datei, wobei wahrscheinliche Geheimnisse durch Punkte ersetzt sind – bereit zum Einfügen in ein Ticket oder einen Chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie le texte du fichier avec les secrets probables remplacés par des points, prêt à coller dans un ticket ou une discussion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝文件文本，其中可能的机密信息会以圆点替换，可直接粘贴到工单或聊天中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密情報と思われる部分をドットに置き換えたファイルのテキストをコピーします。チケットやチャットにそのまま貼り付けられます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल का टेक्स्ट कॉपी करता है, जिसमें संभावित गोपनीय जानकारी की जगह बिंदु होते हैं; टिकट या चैट में चिपकाने के लिए तैयार।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivîsa pelê kopî dike û agahiyên ku dibe ku veşartî bin bi xalan diguherîne; ji bo pêvekirina di tîket an sohbetekê de amade ye."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирует текст файла, заменяя вероятные секреты точками. Его можно сразу вставить в тикет или чат."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalin teks berkas dengan informasi yang diduga rahasia diganti titik, siap ditempelkan ke tiket atau obrolan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলের টেক্সট কপি করে এবং সম্ভাব্য গোপন তথ্যের জায়গায় বিন্দু বসায়; টিকিট বা চ্যাটে পেস্ট করার জন্য প্রস্তুত।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana kwafar rubutun fayil tare da maye gurbin bayanan da ake zaton sirri ne da ɗigo-ɗigo, a shirye don liƙawa a tikiti ko tattaunawa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia o texto do arquivo com possíveis segredos substituídos por pontos, pronto para colar em um ticket ou chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el texto del archivo con los posibles secretos reemplazados por puntos, listo para pegar en un ticket o un chat."
          }
        }
      }
    },
