    "preview.listing.partialNotice": {
      "comment": "Notice above a Files table or Tree for a folder or archive listing that is incomplete. Totals cover only the entries shown; never imply they are complete totals. The reason (a limit was reached or some folders could not be read) is deliberately not stated: keep it to one sentence of at most 12 words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This listing is partial, so totals cover only the entries shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu liste kısmidir, bu yüzden toplamlar yalnızca gösterilen girdileri kapsar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Liste ist unvollständig, daher beziehen sich die Summen nur auf die angezeigten Einträge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette liste est partielle, les totaux ne couvrent donc que les entrées affichées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此列表不完整，因此总数仅涵盖所显示的条目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この一覧は一部のみのため、合計は表示されている項目のみが対象です。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सूची आंशिक है, इसलिए कुल केवल दिखाई गई प्रविष्टियों को ही शामिल करते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev lîste beşî ye, ji ber vê yekê tevahî tenê hêmanên tê nîşandan dihesibîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список неполный, поэтому итоги охватывают только показанные записи."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar ini sebagian, sehingga total hanya mencakup entri yang ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই তালিকা আংশিক, তাই মোট কেবল দেখানো এন্ট্রিগুলোকে ধরে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan jerin bai cika ba, don haka jimillar tana ƙunshe da abubuwan da aka nuna kawai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta listagem é parcial, então os totais cobrem apenas as entradas exibidas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este listado es parcial, así que los totales solo cubren las entradas mostradas."
          }
        }
      }
