    "format.data.numpy.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy array header and the first values of numeric arrays; pickled objects are never loaded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy dizisi başlığı ve sayısal dizilerin ilk değerleri; serileştirilmiş nesneler asla yüklenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy-Array-Header und die ersten Werte numerischer Arrays; serialisierte (Pickle-)Objekte werden nie geladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En-tête de tableau NumPy et premières valeurs des tableaux numériques ; les objets sérialisés (pickle) ne sont jamais chargés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy 数组头信息以及数值数组的前几个值；绝不加载 pickle 序列化对象。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy 配列のヘッダーと数値配列の先頭の値。pickle 化されたオブジェクトは読み込みません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy ऐरे हेडर और संख्यात्मक ऐरे के पहले मान; पिकल किए गए ऑब्जेक्ट कभी लोड नहीं किए जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sernivîsa arraya NumPy û nirxên yekem ên arrayên hejmarî; tiştên pickle tu carî nayên barkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок массива NumPy и первые значения числовых массивов; сериализованные (pickle) объекты никогда не загружаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Header array NumPy dan nilai pertama array numerik; objek pickle tidak pernah dimuat."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "NumPy অ্যারের হেডার ও সংখ্যাসূচক অ্যারের প্রথম মানগুলো; পিকল করা অবজেক্ট কখনো লোড হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan jerin NumPy da ƙimar farko na jerin lambobi; ba a taɓa ɗora abubuwan pickle ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabeçalho de array NumPy e os primeiros valores de arrays numéricos; objetos serializados (pickle) nunca são carregados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabecera de array de NumPy y primeros valores de arrays numéricos; los objetos serializados (pickle) nunca se cargan."
          }
        }
      }
    },
