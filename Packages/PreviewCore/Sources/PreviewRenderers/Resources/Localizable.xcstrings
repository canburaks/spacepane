    "format.model.3mf.description": {
      "comment": "One-sentence description of the 3MF preview shown under the file-type switch. 3MF files describe 3D-printing models; 'build layout' is how the objects are arranged on the print bed; a 'slicer' is the program that prepares a model for a 3D printer. The second sentence says what the preview does not show.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local 3D preview of 3D-printing models, including build layout and units. Colors, materials and slicer settings are not shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapı yerleşimi ve birimler dahil 3B baskı modellerinin yerel 3B önizlemesi. Renkler, malzemeler ve dilimleyici ayarları gösterilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale 3D-Vorschau von 3D-Druckmodellen mit Bauanordnung und Einheiten. Farben, Materialien und Slicer-Einstellungen werden nicht angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu 3D local de modèles d’impression 3D, avec disposition sur le plateau et unités. Les couleurs, les matériaux et les réglages du trancheur ne sont pas affichés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 打印模型的本地 3D 预览，包含构建布局和单位。不显示颜色、材质和切片软件设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルド配置と単位を含む3Dプリント用モデルのローカル3Dプレビュー。色、マテリアル、スライサー設定は表示されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्ड लेआउट और इकाइयों सहित 3D प्रिंटिंग मॉडल का स्थानीय 3D पूर्वावलोकन। रंग, सामग्री और स्लाइसर सेटिंग नहीं दिखाई जातीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtina 3D ya herêmî ji bo modelên çapa 3D, bi cihkirina platformê û yekeyan. Reng, materyal û mîhengên slicerê nayên nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный 3D-просмотр моделей для 3D-печати с расположением на столе и единицами измерения. Цвета, материалы и настройки слайсера не показываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau 3D lokal untuk model pencetakan 3D, termasuk tata letak dan satuan. Warna, material, dan pengaturan slicer tidak ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিল্ড বিন্যাস ও একক সহ 3D প্রিন্টিং মডেলের স্থানীয় 3D প্রিভিউ। রং, ম্যাটেরিয়াল ও স্লাইসার সেটিংস দেখানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duban 3D na cikin naʼura na samfuran bugun 3D, har da tsarin shimfiɗawa da maʼauni. Ba a nuna launuka, kayan ƙira da saitunan slicer ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia 3D local de modelos de impressão 3D, incluindo a disposição na mesa e as unidades. Cores, materiais e ajustes do fatiador não são exibidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa 3D local de modelos de impresión 3D, con la disposición en la bandeja y las unidades. No se muestran colores, materiales ni ajustes del laminador."
          }
        }
      }
    },
