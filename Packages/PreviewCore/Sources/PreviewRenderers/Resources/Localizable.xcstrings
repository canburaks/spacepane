    "general.developerMode.subtitle": {
      "comment": "Explains Developer Mode. Try Preview is the name of the sidebar item; translate it as in navigation.tryPreview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Try Preview in the sidebar so you can open a file directly in this app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenar çubuğunda Önizlemeyi Dene öğesini gösterir; böylece bir dosyayı doğrudan bu uygulamada açabilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt „Vorschau testen“ in der Seitenleiste an, damit Sie eine Datei direkt in dieser App öffnen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche Essayer l’aperçu dans la barre latérale pour ouvrir un fichier directement dans cette app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在边栏中显示“试用预览”，以便直接在此应用中打开文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーに「プレビューを試す」を表示し、このアプリでファイルを直接開けるようにします。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइडबार में “पूर्वावलोकन आज़माएँ” दिखाता है, ताकि आप किसी फ़ाइल को सीधे इस ऐप में खोल सकें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtinê Biceribîne di darika kêlekê de nîşan dide da ku tu pelekî rasterast di vê sepanê de veke."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает «Проверить предпросмотр» в боковом меню, чтобы открывать файл прямо в этом приложении."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan Coba Pratinjau di bilah samping agar Anda dapat membuka berkas langsung di aplikasi ini."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইডবারে “প্রিভিউ চেষ্টা করুন” দেখায়, যাতে আপনি সরাসরি এই অ্যাপে ফাইল খুলতে পারেন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana nuna Gwada Dubawa a gefen allo domin ku buɗe fayil kai tsaye a wannan manhaja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra Testar Pré-visualização na barra lateral para você abrir um arquivo diretamente neste app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra Probar vista previa en la barra lateral para que puedas abrir un archivo directamente en esta app."
          }
        }
      }
    },
