        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas ini lebih besar dari yang dapat dibaca pratinjau ini. Buka di aplikasi yang dibuat untuk jenis berkas ini."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলটি এই প্রিভিউ যতটা পড়তে পারে তার চেয়ে বড়। এই ধরনের ফাইলের জন্য তৈরি অ্যাপে এটি খুলুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan fayil ya fi girman abin da wannan dubawa za ta iya karantawa. Buɗe fayil ɗin a cikin manhajar da aka ƙera don irin wannan fayil."
          }
        },
        "pt": {
