            "value": "নোটবুক ওপর থেকে নিচে চালালে সংরক্ষিত ফলাফল ভিন্ন হতে পারে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakamakon da aka adana na iya bambanta idan aka gudanar da littafin rubutun daga sama zuwa ƙasa."
          }
        },
        "pt": {
          "stringUnit": {
