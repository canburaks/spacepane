    "preview.contentHelp": {
      "comment": "Accessibility help for native selectable text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only text. Select text to copy it; use Find to search the loaded content."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur metin. Kopyalamak için metni seçin; yüklenen içerikte arama yapmak için Bul'u kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützter Text. Wählen Sie Text zum Kopieren aus; durchsuchen Sie den geladenen Inhalt mit „Suchen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte en lecture seule. Sélectionnez du texte pour le copier ; utilisez Rechercher pour parcourir le contenu chargé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读文本。选择文本进行拷贝；使用“查找”搜索已载入的内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用テキストです。テキストを選択してコピーできます。「検索」で読み込んだ内容を検索できます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल पढ़ने का टेक्स्ट। कॉपी करने के लिए टेक्स्ट चुनें; लोड की गई सामग्री खोजने के लिए खोजें का उपयोग करें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Metna tenê-xwendinê. Ji bo kopîkirinê metnê hilbijêre; ji bo lêgerîna naveroka barkirî Bibîne bi kar bîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст только для чтения. Выделите текст для копирования; используйте поиск по загруженному содержимому."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks hanya baca. Pilih teks untuk menyalinnya; gunakan Cari untuk mencari dalam konten yang dimuat."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু পড়ার লেখা। কপি করতে লেখা নির্বাচন করুন; লোড করা বিষয়বস্তু খুঁজতে খুঁজুন ব্যবহার করুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubutu don karantawa kawai. Zaɓi rubutu don kwafi; yi amfani da Nemo don bincika abubuwan da aka loda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto somente para leitura. Selecione o texto para copiá-lo; use Buscar para pesquisar o conteúdo carregado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto de solo lectura. Selecciona texto para copiarlo; usa Buscar para buscar en el contenido cargado."
          }
        }
      }
    },
