    "format.archive.rar.description": {
      "comment": "Supported-behavior description for RAR archives. Only entry names and metadata are listed; no file is extracted or decompressed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded RAR 4 and RAR 5 entry listings from the headers alone. Files are never extracted or decompressed; archives with encrypted headers are not listed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca üst bilgilerden RAR 4 ve RAR 5 girdilerinin sınırlı listeleri. Dosyalar hiçbir zaman çıkarılmaz veya açılmaz; üst bilgileri şifreli arşivler listelenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Eintragslisten für RAR 4 und RAR 5, allein aus den Headern. Dateien werden nie extrahiert oder dekomprimiert; Archive mit verschlüsselten Headern werden nicht aufgelistet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listes d’entrées bornées pour RAR 4 et RAR 5, lues dans les seuls en-têtes. Les fichiers ne sont jamais extraits ni décompressés ; les archives aux en-têtes chiffrés ne sont pas listées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅根据头部信息对 RAR 4 和 RAR 5 条目生成有界列表。绝不提取或解压文件；头部已加密的压缩包不会列出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッダだけから RAR 4 と RAR 5 の項目を上限付きで一覧表示します。ファイルの展開や解凍は行いません。ヘッダが暗号化されたアーカイブは一覧表示されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल हेडर से RAR 4 और RAR 5 प्रविष्टियों की सीमित सूची। फ़ाइलें कभी निकाली या डीकंप्रेस नहीं की जातीं; एन्क्रिप्टेड हेडर वाले संग्रह सूचीबद्ध नहीं होते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lîsteyên sînorkirî yên tomarên RAR 4 û RAR 5 tenê ji sernivîsan. Pel qet nayên derxistin an vekirin; arşîvên bi sernivîsên şîfrekirî nayên lîstekirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченные списки записей RAR 4 и RAR 5 только по заголовкам. Файлы никогда не извлекаются и не распаковываются; архивы с зашифрованными заголовками не перечисляются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar entri RAR 4 dan RAR 5 yang dibatasi, hanya dari header. File tidak pernah diekstrak atau didekompresi; arsip dengan header terenkripsi tidak didaftar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু হেডার থেকে RAR 4 ও RAR 5 এন্ট্রির সীমিত তালিকা। ফাইল কখনও এক্সট্র্যাক্ট বা ডিকম্প্রেস করা হয় না; এনক্রিপ্টেড হেডারযুক্ত আর্কাইভ তালিকাভুক্ত হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Jerin shigarwar RAR 4 da RAR 5 mai iyaka daga kan fayil kawai. Ba a taɓa cire fayiloli ko buɗe su ba; ba a jera taskokin da kan fayilolinsu aka ɓoye ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas limitadas de entradas RAR 4 e RAR 5 lidas apenas dos cabeçalhos. Os arquivos nunca são extraídos nem descomprimidos; arquivos com cabeçalhos cifrados não são listados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas acotadas de entradas RAR 4 y RAR 5 leídas solo de las cabeceras. Los archivos nunca se extraen ni se descomprimen; los archivos con cabeceras cifradas no se listan."
          }
        }
      }
    },
