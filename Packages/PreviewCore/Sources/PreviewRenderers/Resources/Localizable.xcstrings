    "appearance.themeTransfer.hint": {
      "comment": "App-authored label or feedback; preserve format placeholders and their argument types.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import only a bounded JSON appearance document. Fonts are never installed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sınırlı bir JSON görünüm belgesi içe aktarın. Yazı tipleri asla yüklenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie nur ein begrenztes JSON-Darstellungsdokument. Schriften werden nie installiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez uniquement un document JSON d’apparence de taille limitée. Aucune police n’est installée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅导入大小受限的 JSON 外观文稿。不会安装字体。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズが制限された JSON 外観文書のみを読み込みます。フォントはインストールされません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सीमित JSON रूप दस्तावेज़ आयात करें। फ़ॉन्ट कभी इंस्टॉल नहीं होते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenê belgeyeke JSON a dîmenê ya sînordar têxe. Font tu carî nayên sazkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте только ограниченный по размеру JSON-документ оформления. Шрифты никогда не устанавливаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor hanya dokumen JSON tampilan dengan ukuran terbatas. Font tidak pernah dipasang."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেবল সীমাবদ্ধ JSON চেহারার নথি আমদানি করুন। ফন্ট কখনো ইনস্টল করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shigo da takardar JSON ta kamanni mai iyaka kawai. Ba a shigar da nauʼin rubutu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe somente um documento JSON de aparência com tamanho limitado. Fontes nunca são instaladas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa solo un documento JSON de apariencia de tamaño limitado. Nunca se instalan fuentes."
          }
        }
      }
    },
