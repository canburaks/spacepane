    "failure.binary": {
      "comment": "Binary text rejection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file contains binary content that cannot be shown as text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya, metin olarak gösterilemeyen ikili içerik barındırıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei enthält Binärdaten, die nicht als Text angezeigt werden können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier contient des données binaires impossibles à afficher comme texte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件包含无法显示为文本的二进制内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには、テキストとして表示できないバイナリ内容が含まれています。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल में बाइनरी सामग्री है जिसे टेक्स्ट के रूप में नहीं दिखाया जा सकता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev pel naveroka duî bar dike ku wek metn nayê nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл содержит двоичные данные, которые нельзя показать как текст."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas ini berisi konten biner yang tidak dapat ditampilkan sebagai teks."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলে বাইনারি বিষয়বস্তু আছে যা লেখা হিসেবে দেখানো যায় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayil yana ɗauke da bayanan binary da ba za a nuna a matsayin rubutu ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo contém dados binários que não podem ser mostrados como texto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo contiene datos binarios que no se pueden mostrar como texto."
          }
        }
      }
    },
    "failure.body.binaryContent": {
      "comment": "Body under the title failure.title.binaryContent: why it happened and what to do next, in one or two complete sentences ending with a period. The last sentence is the next step for the reader. Situation: the file holds binary data where text was expected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It contains binary data, not text. Open it in an app made for this type of file."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin değil, ikili veri içeriyor. Bu dosya türü için tasarlanmış bir uygulamada açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie enthält Binärdaten und keinen Text. Öffnen Sie die Datei in einer App, die für diesen Dateityp gedacht ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contient des données binaires, pas du texte. Ouvrez-le dans une application conçue pour ce type de fichier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中是二进制数据，而不是文本。请使用适用于此类文件的应用打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストではなく、バイナリデータが含まれています。この種類のファイルに対応したアプリで開いてください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें टेक्स्ट नहीं, बाइनरी डेटा है। इसे इस प्रकार की फ़ाइल के लिए बने ऐप में खोलें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Daneyên duî tê de hene, ne metn. Pelê di sepanekê de veke ku ji bo vê cureya pelê hatiye çêkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нём двоичные данные, а не текст. Откройте файл в приложении, предназначенном для этого типа файлов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berisi data biner, bukan teks. Buka di aplikasi yang dibuat untuk jenis berkas ini."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে লেখা নয়, বাইনারি ডেটা আছে। এই ধরনের ফাইলের জন্য তৈরি অ্যাপে এটি খুলুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana ɗauke da bayanan binary, ba rubutu ba. Buɗe fayil ɗin a cikin manhajar da aka ƙera don irin wannan fayil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele contém dados binários, não texto. Abra-o em um app feito para este tipo de arquivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contiene datos binarios, no texto. Ábrelo en una app hecha para este tipo de archivo."
          }
        }
      }
    },
    "failure.body.cadImporterUnavailable": {
      "comment": "Body under the title failure.title.cadImporterUnavailable: why it happened and what to do next, in one or two complete sentences ending with a period. The last sentence is the next step for the reader. Situation: the isolated CAD importer service did not answer (busy, interrupted, missing component or packaging problem); suggest retrying or checking the installation and do not require reinstallation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may be busy or interrupted. Try again, or check that the app is installed correctly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meşgul olabilir veya kesintiye uğramış olabilir. Yeniden deneyin ya da uygulamanın doğru kurulduğunu kontrol edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist möglicherweise ausgelastet oder unterbrochen. Versuchen Sie es erneut oder prüfen Sie, ob die App korrekt installiert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est peut-être occupé ou interrompu. Réessayez ou vérifiez que l’application est correctement installée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能正忙或已中断。请重试，或检查应用是否已正确安装。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中か、接続が中断された可能性があります。もう一度お試しいただくか、アプリが正しくインストールされているか確認してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सकता है कि वह व्यस्त हो या बाधित हो गया हो। फिर से कोशिश करें, या जाँचें कि ऐप ठीक से इंस्टॉल है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibe ku mijûl be an qut bûbe. Dîsa biceribîne, an kontrol bike ka sepan rast hatiye sazkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, он занят или соединение прервано. Повторите попытку или проверьте, правильно ли установлено приложение."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengimpor mungkin sedang sibuk atau terputus. Coba lagi, atau periksa apakah aplikasi terinstal dengan benar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ব্যস্ত বা বিচ্ছিন্ন হয়ে থাকতে পারে। আবার চেষ্টা করুন, অথবা অ্যাপ ঠিকমতো ইনস্টল হয়েছে কি না পরীক্ষা করুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wataƙila yana aiki ko an katse shi. Sake gwadawa, ko duba ko an shigar da manhajar yadda ya kamata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele pode estar ocupado ou ter sido interrompido. Tente novamente ou verifique se o app está instalado corretamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que esté ocupado o se haya interrumpido. Vuelve a intentarlo o comprueba que la app esté instalada correctamente."
          }
        }
      }
    },
    "failure.body.deadlineExceeded": {
      "comment": "Body under the title failure.title.deadlineExceeded: why it happened and what to do next, in one or two complete sentences ending with a period. The last sentence is the next step for the reader. Situation: the preview stopped at its time limit. Used when the limit is not known, so it never prints a number; the variant that prints it is failure.body.deadlineExceededLimit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file took longer to process than the time allowed. Try again, or open it in an app made for this type of file."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyanın işlenmesi izin verilen süreden uzun sürdü. Yeniden deneyin veya bu dosya türü için tasarlanmış bir uygulamada açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verarbeitung dieser Datei hat länger gedauert als erlaubt. Versuchen Sie es erneut oder öffnen Sie die Datei in einer App, die für diesen Dateityp gedacht ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement de ce fichier a dépassé le délai autorisé. Réessayez, ou ouvrez-le dans une application conçue pour ce type de fichier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理此文件所用的时间超出了允许的时间。请重试，或使用适用于此类文件的应用打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルの処理に、許可されている時間より長くかかりました。もう一度お試しいただくか、この種類のファイルに対応したアプリで開いてください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल को प्रोसेस करने में अनुमत समय से अधिक लगा। फिर से कोशिश करें, या इसे इस प्रकार की फ़ाइल के लिए बने ऐप में खोलें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêvajoyîna vê pelê ji dema destûrdayî dirêjtir kişand. Dîsa biceribîne, an pelê di sepanekê de veke ku ji bo vê cureya pelê hatiye çêkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработка этого файла заняла больше времени, чем разрешено. Повторите попытку или откройте файл в приложении, предназначенном для этого типа файлов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemrosesan berkas ini memakan waktu lebih lama dari yang diizinkan. Coba lagi, atau buka di aplikasi yang dibuat untuk jenis berkas ini."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইল প্রক্রিয়া করতে অনুমোদিত সময়ের চেয়ে বেশি লেগেছে। আবার চেষ্টা করুন, অথবা এই ধরনের ফাইলের জন্য তৈরি অ্যাপে এটি খুলুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarrafa wannan fayil ya ɗauki lokaci fiye da wanda aka yarda. Sake gwadawa, ko buɗe fayil ɗin a cikin manhajar da aka ƙera don irin wannan fayil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O processamento deste arquivo levou mais tempo do que o permitido. Tente novamente ou abra-o em um app feito para este tipo de arquivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesar este archivo tardó más del tiempo permitido. Vuelve a intentarlo o ábrelo en una app hecha para este tipo de archivo."
          }
        }
      }
    },
    "failure.body.deadlineExceededLimit": {
      "comment": "Variant of failure.body.deadlineExceeded used when the limit is known: formatted key with one %@, which is the time allowed for one preview, in words (such as “2 seconds”), already formatted for the locale. Keep one %@ in the sentence and end with the same next step as the variant without a number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preview allows %@ to process a file, and this one took longer. Try again, or open it in an app made for this type of file."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu önizleme bir dosyayı işlemek için %@ süre tanır, bu dosya ise daha uzun sürdü. Yeniden deneyin veya bu dosya türü için tasarlanmış bir uygulamada açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vorschau erlaubt %@ für die Verarbeitung einer Datei, diese hat länger gedauert. Versuchen Sie es erneut oder öffnen Sie die Datei in einer App, die für diesen Dateityp gedacht ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet aperçu accorde %@ pour traiter un fichier, et celui-ci a pris plus de temps. Réessayez, ou ouvrez-le dans une application conçue pour ce type de fichier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预览允许用 %@ 处理一个文件，而此文件耗时更长。请重试，或使用适用于此类文件的应用打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレビューがファイルの処理に許可しているのは %@ で、このファイルはそれより長くかかりました。もう一度お試しいただくか、この種類のファイルに対応したアプリで開いてください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पूर्वावलोकन किसी फ़ाइल को प्रोसेस करने के लिए %@ देता है, और इस फ़ाइल में उससे अधिक लगा। फिर से कोशिश करें, या इसे इस प्रकार की फ़ाइल के लिए बने ऐप में खोलें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev pêşdîtin %@ dide ji bo pêvajoyîna pelekê, û vê pelê ji wê bêtir kişand. Dîsa biceribîne, an pelê di sepanekê de veke ku ji bo vê cureya pelê hatiye çêkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот предпросмотр отводит на обработку файла %@, а этот файл потребовал больше времени. Повторите попытку или откройте файл в приложении, предназначенном для этого типа файлов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau ini memberi waktu %@ untuk memproses sebuah berkas, dan berkas ini memakan waktu lebih lama. Coba lagi, atau buka di aplikasi yang dibuat untuk jenis berkas ini."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্রিভিউ একটি ফাইল প্রক্রিয়া করতে %@ সময় দেয়, আর এই ফাইলে তার চেয়ে বেশি লেগেছে। আবার চেষ্টা করুন, অথবা এই ধরনের ফাইলের জন্য তৈরি অ্যাপে এটি খুলুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan dubawa tana ba da %@ don sarrafa fayil, amma wannan ya ɗauki fiye da haka. Sake gwadawa, ko buɗe fayil ɗin a cikin manhajar da aka ƙera don irin wannan fayil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pré-visualização permite %@ para processar um arquivo, e este levou mais tempo. Tente novamente ou abra-o em um app feito para este tipo de arquivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vista previa permite %@ para procesar un archivo, y este tardó más. Vuelve a intentarlo o ábrelo en una app hecha para este tipo de archivo."
          }
        }
      }
    },
    "failure.body.encryptedContent": {
      "comment": "Body under the title failure.title.encryptedContent: why it happened and what to do next, in one or two complete sentences ending with a period. The last sentence is the next step for the reader. Situation: the file or part of it is encrypted or protected by DRM; nothing is decrypted or guessed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its content cannot be shown. Open it in an app that can unlock it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriği gösterilemiyor. Kilidini açabilen bir uygulamada açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt kann nicht angezeigt werden. Öffnen Sie die Datei in einer App, die sie entsperren kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son contenu ne peut pas être affiché. Ouvrez-le dans une application capable de le déverrouiller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法显示其内容。请使用能够解锁它的应用打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を表示できません。ロックを解除できるアプリで開いてください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी सामग्री नहीं दिखाई जा सकती। इसे ऐसे ऐप में खोलें जो इसे अनलॉक कर सके।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Naveroka wê nayê nîşandan. Pelê di sepanekê de veke ku dikare kilîta wê veke."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его содержимое нельзя показать. Откройте файл в приложении, которое может его расшифровать."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinya tidak dapat ditampilkan. Buka di aplikasi yang dapat membukanya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর বিষয়বস্তু দেখানো যায় না। যে অ্যাপ এটি আনলক করতে পারে তাতে খুলুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba za a iya nuna abin da ke ciki ba. Buɗe shi a cikin manhajar da za ta iya buɗe shi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível mostrar o conteúdo. Abra-o em um app que consiga desbloqueá-lo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede mostrar su contenido. Ábrelo en una app que pueda desbloquearlo."
          }
        }
      }
    },
    "failure.body.geometryTooComplex": {
      "comment": "Body under the title failure.title.geometryTooComplex: why it happened and what to do next, in one or two complete sentences ending with a period. The last sentence is the next step for the reader. Situation: a 3D model has more detail than the geometry limits allow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has more detail than this preview can draw safely. Open it in an app made for 3D models."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu önizlemenin güvenle çizebileceğinden daha fazla ayrıntı içeriyor. 3B modeller için tasarlanmış bir uygulamada açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es enthält mehr Details, als diese Vorschau sicher darstellen kann. Öffnen Sie die Datei in einer App für 3D-Modelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contient plus de détails que cet aperçu ne peut en dessiner en toute sécurité. Ouvrez-le dans une application conçue pour les modèles 3D."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其细节超出了此预览可安全绘制的范围。请使用适用于 3D 模型的应用打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレビューで安全に描画できる量を超える詳細が含まれています。3Dモデルに対応したアプリで開いてください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें उससे अधिक विवरण है जितना यह पूर्वावलोकन सुरक्षित रूप से बना सकता है। इसे 3D मॉडल के लिए बने ऐप में खोलें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji ya ku ev pêşdîtin bi ewlehî dikare xêz bike bêtir hûrgilî tê de heye. Pelê di sepanekê de veke ku ji bo modelên 3D hatiye çêkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нём больше деталей, чем этот предпросмотр может безопасно отрисовать. Откройте файл в приложении для 3D-моделей."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini memiliki lebih banyak detail daripada yang dapat digambar pratinjau ini dengan aman. Buka di aplikasi untuk model 3D."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে এই প্রিভিউ নিরাপদে যতটা আঁকতে পারে তার চেয়ে বেশি খুঁটিনাটি আছে। 3D মডেলের জন্য তৈরি অ্যাপে এটি খুলুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana da cikakkun bayanai fiye da yadda wannan dubawa za ta iya zana cikin aminci. Buɗe shi a cikin manhajar da aka ƙera don samfuran 3D."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele tem mais detalhes do que esta pré-visualização consegue desenhar com segurança. Abra-o em um app para modelos 3D."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene más detalle del que esta vista previa puede dibujar con seguridad. Ábrelo en una app para modelos 3D."
          }
        }
      }
    },
    "failure.body.inputTooLarge": {
      "comment": "Body under the title failure.title.inputTooLarge: why it happened and what to do next, in one or two complete sentences ending with a period. The last sentence is the next step for the reader. Situation: the file is larger than the input size limit for its type. Used when the limit is not known, so it never prints a number; the variant that prints it is failure.body.inputTooLargeLimit.",
