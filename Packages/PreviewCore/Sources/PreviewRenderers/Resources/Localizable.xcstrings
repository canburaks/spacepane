    "settings.storageUnavailable": {
      "comment": "Status when neither shared nor private storage can be opened.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings storage is unavailable. Choices apply only while this app is open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayar depolama alanı kullanılamıyor. Seçimler yalnızca bu uygulama açıkken geçerlidir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einstellungsspeicher ist nicht verfügbar. Die Auswahl gilt nur, solange diese App geöffnet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage des réglages est indisponible. Les choix s’appliquent uniquement tant que cette app est ouverte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置存储不可用。选择仅在此应用打开时生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の保存先を利用できません。選択はこのアプリを開いている間のみ適用されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ का संग्रहण उपलब्ध नहीं है। चयन केवल ऐप खुला रहने तक लागू हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihê tomarkirina mîhengan nayê bikaranîn. Hilbijartin tenê dema ku ev sepan vekirî ye derbasdar in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище настроек недоступно. Выбор действует только пока приложение открыто."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan pengaturan tidak tersedia. Pilihan hanya berlaku selama aplikasi terbuka."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসের সঞ্চয়স্থান উপলব্ধ নয়। অ্যাপ খোলা থাকলেই নির্বাচন প্রযোজ্য হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wurin adana saituna ba ya samuwa. Zaɓukan suna aiki ne kawai yayin da manhajar take buɗe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento de ajustes está indisponível. As escolhas valem somente enquanto o app estiver aberto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento de ajustes no está disponible. Las opciones se aplican solo mientras la app está abierta."
          }
        }
      }
    },
    "setup.notConfigured": {
      "comment": "Banner body when shared extension storage is unavailable and settings stay private to the companion. Describes what the extensions do meanwhile: they show a setup message in Finder previews and keep thumbnails generic (content-free) until the build's shared App Group is configured. Keep App Group untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are saved for this app only. Until this build’s shared App Group is configured, the extensions show a setup message in Finder previews and keep thumbnails generic."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar yalnızca bu uygulama için kaydedilir. Bu derlemenin paylaşılan App Group yapılandırması tamamlanana kadar uzantılar Finder önizlemelerinde bir kurulum mesajı gösterir ve küçük resimleri genel tutar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen werden nur für diese App gespeichert. Bis die gemeinsame App Group dieser Version eingerichtet ist, zeigen die Erweiterungen in Finder-Vorschauen einen Einrichtungshinweis und nur generische Miniaturbilder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages sont enregistrés pour cette app uniquement. Tant que l’App Group partagé de cette version n’est pas configuré, les extensions affichent un message de configuration dans les aperçus Finder et ne produisent que des vignettes génériques."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置仅保存在此应用中。在此版本的共享 App Group 配置完成之前，扩展会在访达预览中显示设置提示，并让缩略图保持通用样式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はこのアプリ内にのみ保存されています。このビルドの共有 App Group が構成されるまで、機能拡張は Finder のプレビューにセットアップに関するメッセージを表示し、サムネイルは汎用のままにします。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ केवल इस ऐप के लिए सहेजी गई हैं। इस बिल्ड का साझा App Group कॉन्फ़िगर होने तक एक्सटेंशन Finder पूर्वावलोकन में सेटअप संदेश दिखाते हैं और थंबनेल सामान्य रखते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mîheng tenê ji bo vê sepanê têne tomarkirin. Heta ku App Group a hevpar a vê avakirinê neyê sazkirin, pêvek di pêşdîtinên Finder de agahiyeke sazkirinê nîşan didin û wêneyên biçûk giştî dihêlin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки сохранены только для этого приложения. Пока общая группа App Group этой сборки не настроена, расширения показывают в предпросмотрах Finder сообщение о настройке, а миниатюры оставляют универсальными."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan hanya disimpan untuk aplikasi ini. Sampai App Group bersama untuk versi ini dikonfigurasi, ekstensi menampilkan pesan penyiapan di pratinjau Finder dan membiarkan gambar mini tetap generik."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস শুধু এই অ্যাপের জন্য সংরক্ষিত। এই বিল্ডের ভাগ করা App Group কনফিগার না হওয়া পর্যন্ত এক্সটেনশনগুলো Finder প্রিভিউতে একটি সেটআপ বার্তা দেখায় এবং থাম্বনেইল সাধারণ রাখে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An adana saitunan don wannan manhajar kaɗai. Har sai an saita App Group na bai ɗaya na wannan sigar, ƙari suna nuna sanarwar saiti a dubawar Finder, kuma suna barin ƙananan hotuna a matsayin na gama gari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes são salvos apenas para este app. Até que o App Group compartilhado desta versão seja configurado, as extensões mostram uma mensagem de configuração nas pré-visualizações do Finder e mantêm as miniaturas genéricas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes se guardan solo para esta app. Hasta que se configure el App Group compartido de esta versión, las extensiones muestran un mensaje de configuración en las vistas previas de Finder y mantienen las miniaturas genéricas."
          }
        }
      }
    },
    "setup.steps": {
      "comment": "Setup guidance shown on General for macOS 15 and later. Keep the System Settings path in the system's own wording. Separate the parts of the path with > (U+003E), never an arrow: the character turns around in a right-to-left run.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the Quick Look extensions in System Settings > General > Login Items & Extensions. Then select a supported file in Finder and press Space."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Genel > Giriş Öğeleri ve Uzantılar bölümünde Quick Look uzantılarını açın. Ardından Finder'da desteklenen bir dosya seçip Boşluk tuşuna basın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die Quick Look-Erweiterungen unter Systemeinstellungen > Allgemein > Anmeldeobjekte & Erweiterungen. Wählen Sie dann eine unterstützte Datei im Finder aus und drücken Sie die Leertaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les extensions Quick Look dans Réglages Système > Général > Ouverture et extensions. Sélectionnez ensuite un fichier pris en charge dans Finder et appuyez sur Espace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”>“通用”>“登录项与扩展”中打开快速查看扩展。然后在访达中选择支持的文件并按空格键。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」>「一般」>「ログイン項目と機能拡張」でクイックルックの機能拡張をオンにしてください。次に、Finder で対応ファイルを選択してスペースキーを押します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्ज़ > सामान्य > लॉगिन आइटम और एक्सटेंशन में Quick Look एक्सटेंशन चालू करें। फिर Finder में कोई समर्थित फ़ाइल चुनें और स्पेस दबाएँ।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêvekên Quick Look di Mîhengên Pergalê > Giştî > Hêmanên Têketinê û Pêvek de veke. Paşê di Finder de pelekî piştgirîkirî hilbijêre û bişkojka Valahiyê bikirtîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите расширения Quick Look в Системных настройках > Основные > Объекты входа и расширения. Затем выберите поддерживаемый файл в Finder и нажмите пробел."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan ekstensi Quick Look di Pengaturan Sistem > Umum > Item Masuk & Ekstensi. Lalu pilih berkas yang didukung di Finder dan tekan Spasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংস > সাধারণ > লগইন আইটেম ও এক্সটেনশন-এ Quick Look এক্সটেনশন চালু করুন। তারপর Finder-এ একটি সমর্থিত ফাইল বেছে স্পেস চাপুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunna ƙarin Quick Look a Saitunan Tsari > Gaba ɗaya > Abubuwan Shiga da Ƙari. Sannan zaɓi fayil mai tallafi a Finder ka danna maɓallin sarari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as extensões do Quick Look em Ajustes do Sistema > Geral > Itens de Início e Extensões. Depois, selecione um arquivo compatível no Finder e pressione Espaço."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las extensiones de Quick Look en Ajustes del Sistema > General > Ítems de inicio y extensiones. Después, selecciona un archivo compatible en Finder y pulsa Espacio."
          }
        }
      }
    },
    "setup.unverified": {
      "comment": "Truthful note under setup; never implies Finder uses this app for every type.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chooses which app provides previews and thumbnails for each file type. If another app also supports a type, Finder may use that app instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dosya türü için önizleme ve küçük resimleri hangi uygulamanın sağlayacağını macOS seçer. Başka bir uygulama da aynı türü destekliyorsa Finder o uygulamayı kullanabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS wählt für jeden Dateityp, welche App Vorschauen und Miniaturbilder bereitstellt. Unterstützt eine andere App denselben Typ, verwendet der Finder möglicherweise diese App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS choisit l’app qui fournit les aperçus et les vignettes de chaque type de fichier. Si une autre app prend aussi en charge un type, Finder peut utiliser cette app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种文件类型由哪个应用提供预览和缩略图由 macOS 决定。如果其他应用也支持该类型，访达可能会使用该应用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの種類ごとにプレビューとサムネイルを提供するアプリは macOS が選択します。別のアプリも同じ種類に対応している場合、Finder はそのアプリを使うことがあります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर फ़ाइल प्रकार के लिए पूर्वावलोकन और थंबनेल कौन-सा ऐप देगा, यह macOS चुनता है। अगर कोई दूसरा ऐप भी उस प्रकार का समर्थन करता है, तो Finder उस ऐप का उपयोग कर सकता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ji bo her cureyê pelê hildibijêre ka kîjan sepan pêşdîtin û wêneyên biçûk pêşkêş dike. Heke sepaneke din jî heman cureyê piştgirî dike, dibe ku Finder wê sepanê bi kar bîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS выбирает, какое приложение показывает предпросмотры и миниатюры для каждого типа файлов. Если этот тип поддерживает и другое приложение, Finder может использовать его."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS memilih aplikasi yang menyediakan pratinjau dan gambar mini untuk setiap jenis berkas. Jika aplikasi lain juga mendukung jenis tersebut, Finder mungkin menggunakan aplikasi itu."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ফাইলের ধরনের জন্য কোন অ্যাপ প্রিভিউ ও থাম্বনেইল দেবে, তা macOS বেছে নেয়। অন্য কোনো অ্যাপও একই ধরন সমর্থন করলে Finder সেই অ্যাপ ব্যবহার করতে পারে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ne ke zaɓar manhajar da ke ba da dubawa da ƙananan hotuna ga kowane nauʼin fayil. Idan wata manhaja ma tana tallafa wa nauʼin, Finder na iya amfani da ita."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS escolhe qual app fornece pré-visualizações e miniaturas para cada tipo de arquivo. Se outro app também for compatível com um tipo, o Finder pode usar esse app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS elige qué app ofrece las vistas previas y miniaturas de cada tipo de archivo. Si otra app también admite un tipo, Finder puede usar esa app."
          }
        }
      }
    },
