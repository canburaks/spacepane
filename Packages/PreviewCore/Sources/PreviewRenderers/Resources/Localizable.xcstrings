          }
        }
      }
    },
    "finding.launch.hiddenLocation": {
      "comment": "Safety finding for a launchd job: the program the job starts is stored in a temporary folder, a folder shared by all users, or a hidden folder (one whose name starts with a dot). No path is shown. Not formatted; no placeholder. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
