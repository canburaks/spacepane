    "settings.recovery": {
      "comment": "Fail-closed status for corrupt, unreadable, or unsupported preferences.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved settings could not be used. File types are disabled until you choose and save new settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş ayarlar kullanılamadı. Yeni ayarlar seçip kaydedene kadar dosya türleri devre dışıdır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Einstellungen konnten nicht verwendet werden. Dateitypen bleiben deaktiviert, bis Sie neue Einstellungen wählen und speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages enregistrés sont inutilisables. Les types de fichiers restent désactivés jusqu’à la sélection et l’enregistrement de nouveaux réglages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用已保存的设置。文件类型将保持停用，直到你选择并保存新的设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した設定を使用できませんでした。新しい設定を選んで保存するまで、ファイルの種類は無効になります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई सेटिंग्ज़ उपयोग नहीं की जा सकीं। नई सेटिंग्ज़ चुनकर सहेजने तक फ़ाइल प्रकार अक्षम रहेंगे।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mîhengên tomarkirî nehatin bikaranîn. Heta ku mîhengên nû hilbijêrî û tomar bikî, cureyên pelan neçalak in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые настройки недоступны. Типы файлов отключены, пока вы не выберете и не сохраните новые настройки."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan tersimpan tidak dapat digunakan. Jenis berkas dinonaktifkan hingga Anda memilih dan menyimpan pengaturan baru."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত সেটিংস ব্যবহার করা যায়নি। নতুন সেটিংস বেছে সংরক্ষণ না করা পর্যন্ত ফাইলের ধরন নিষ্ক্রিয় থাকবে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya amfani da saitunan da aka adana ba. Nauʼoʼin fayil suna kashe har sai ka zaɓa ka adana sabbin saituna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar os ajustes salvos. Os tipos de arquivo ficam desativados até você escolher e salvar novos ajustes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron usar los ajustes guardados. Los tipos de archivo permanecen desactivados hasta que elijas y guardes nuevos ajustes."
          }
        }
      }
    },
    "settings.saveFailed": {
      "comment": "Save failure status; do not expose raw system errors.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choices apply in this app, but could not be saved. Finder extensions may still use the last saved choices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçimler bu uygulamada geçerli, ancak kaydedilemedi. Finder uzantıları son kaydedilen seçimleri kullanmaya devam edebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl gilt in dieser App, konnte aber nicht gespeichert werden. Finder-Erweiterungen verwenden möglicherweise weiterhin die zuletzt gespeicherte Auswahl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choix s’appliquent dans cette app, mais n’ont pas pu être enregistrés. Les extensions Finder peuvent encore utiliser les derniers choix enregistrés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已在此应用中生效，但无法保存。访达扩展可能仍使用上次保存的选择。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択はこのアプリに適用されましたが、保存できませんでした。Finder の機能拡張では最後に保存した選択が使われる場合があります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयन इस ऐप में लागू हैं, लेकिन सहेजे नहीं जा सके। Finder एक्सटेंशन अभी भी अंतिम सहेजे गए चयन का उपयोग कर सकते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilbijartin di vê sepanê de derbasdar in, lê nehatin tomarkirin. Pêvekên Finder dibe ku hilbijartinên dawî yên tomarkirî bi kar bînin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор действует в этом приложении, но сохранить его не удалось. Расширения Finder могут использовать ранее сохранённый выбор."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan berlaku di aplikasi ini, tetapi tidak dapat disimpan. Ekstensi Finder mungkin masih menggunakan pilihan tersimpan sebelumnya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচন এই অ্যাপে প্রযোজ্য হয়েছে, তবে সংরক্ষণ করা যায়নি। Finder এক্সটেনশন শেষ সংরক্ষিত নির্বাচন ব্যবহার করতে পারে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓukan suna aiki a wannan manhaja, amma ba a adana su ba. Ƙarin Finder na iya ci gaba da amfani da zaɓin da aka adana a baya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As escolhas valem neste app, mas não puderam ser salvas. As extensões do Finder ainda podem usar as últimas escolhas salvas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones se aplican en esta app, pero no se pudieron guardar. Las extensiones de Finder pueden seguir usando las últimas opciones guardadas."
          }
        }
      }
    },
