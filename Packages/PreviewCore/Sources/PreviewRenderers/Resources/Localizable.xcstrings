    "profile.cell.distributionDescription": {
      "comment": "Spoken description of a tiny bar chart, read by VoiceOver instead of the bar characters. %1$@ and %2$@ are the exact smallest and largest values copied from the file, %3$@ is the locale-formatted number of equal-width ranges, and %4$@ is an already localized list of how many values fall into each range from lowest to highest. Preserve the positional placeholders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribution from %1$@ to %2$@ in %3$@ ranges, with counts %4$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ile %2$@ arasındaki dağılım, %3$@ aralık, sayılar: %4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
