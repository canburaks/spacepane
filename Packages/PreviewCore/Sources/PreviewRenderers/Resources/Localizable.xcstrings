        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev pel ji ya ku ev pêşdîtin dikare bixwîne mezintir e. Pelê di sepanekê de veke ku ji bo vê cureya pelê hatiye çêkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер файла превышает предел чтения этого предпросмотра. Откройте файл в приложении, предназначенном для этого типа файлов."
          }
