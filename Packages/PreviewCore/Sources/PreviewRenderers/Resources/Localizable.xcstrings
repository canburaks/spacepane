    "appearance.themeTransfer.notApplied": {
      "comment": "Status shown, and spoken by VoiceOver, after importing a theme file when the import was not applied because the person changed the appearance while the file was still being read. One sentence, in the caution style.",
      "extractionState": "manual",
      "localizations": {
