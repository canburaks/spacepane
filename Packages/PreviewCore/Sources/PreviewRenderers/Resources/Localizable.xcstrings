    "finding.pickle.brokenStream": {
      "comment": "Safety finding for a Python pickle or PyTorch checkpoint: the pickle data becomes invalid after the imports were read. Malicious models have used this so that security scanners stop early while Python still runs what came before. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data breaks off after its imports. Some scanners stop reading at that point."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veri, içe aktarmalardan sonra kesiliyor. Bazı tarama araçları okumayı bu noktada bırakıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten brechen nach den Importen ab. Manche Scanner hören an dieser Stelle auf zu lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données s’interrompent après les importations. Certains analyseurs arrêtent la lecture à ce stade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据在导入之后中断。有些扫描工具会在这里停止读取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データがインポートの後で途切れています。一部のスキャナはその時点で読み取りを止めます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा इंपोर्ट के बाद अधूरा कट जाता है। कुछ स्कैनर उसी जगह पढ़ना रोक देते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane piştî importan têne birîn. Hin skaner li wê derê dev ji xwendinê berdidin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные обрываются после импортов. Некоторые сканеры прекращают чтение в этом месте."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data terputus setelah impor. Beberapa pemindai berhenti membaca pada titik itu."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমপোর্টের পরে ডেটা মাঝপথে থেমে যায়। কিছু স্ক্যানার সেই জায়গায় পড়া বন্ধ করে দেয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayanan sun yanke bayan import ɗinsu. Wasu naʼurorin duba suna daina karantawa a wannan wuri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados são interrompidos após as importações. Alguns scanners param de ler nesse ponto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos se interrumpen después de las importaciones. Algunos escáneres dejan de leer en ese punto."
          }
        }
      }
    },
