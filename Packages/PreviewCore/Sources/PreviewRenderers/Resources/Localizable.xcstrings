    "preview.diagram.drawioPage": {
      "comment": "Status-line notice for a draw.io file with several pages: argument 1 is the total page count (Int64); only the first page is shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing page 1 of %1$lld. Other pages are not shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld sayfanın 1. sayfası gösteriliyor. Diğer sayfalar gösterilmiyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite 1 von %1$lld wird angezeigt. Weitere Seiten werden nicht angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Page 1 sur %1$lld affichée. Les autres pages ne sont pas affichées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示第 1 页，共 %1$lld 页。其他页面不会显示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ページ中の 1 ページ目を表示しています。他のページは表示されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld में से पृष्ठ 1 दिखाया जा रहा है। अन्य पृष्ठ नहीं दिखाए गए हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rûpela 1 ji %1$lld tê nîşandan. Rûpelên din nayên nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показана страница 1 из %1$lld. Остальные страницы не показаны."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan halaman 1 dari %1$lld. Halaman lainnya tidak ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld পৃষ্ঠার মধ্যে ১ম পৃষ্ঠা দেখানো হচ্ছে। অন্য পৃষ্ঠাগুলো দেখানো হয়নি।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana nuna shafi na 1 daga cikin %1$lld. Ba a nuna sauran shafuka ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando a página 1 de %1$lld. As outras páginas não são exibidas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando la página 1 de %1$lld. Las demás páginas no se muestran."
          }
        }
      }
    },
    "preview.diagram.interactionHelp": {
      "comment": "Accessibility help for the zoomable diagram. Keep the Command key name and the +, - and 0 keys unchanged; translate the actions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch, or press Command-Plus and Command-Minus, to zoom. Scroll or drag to move. Press Command-0 or double-click to fit the diagram."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınlaştırmak için sıkıştırın veya Command-Artı ve Command-Eksi tuşlarına basın. Taşımak için kaydırın veya sürükleyin. Diyagramı sığdırmak için Command-0 tuşuna basın veya çift tıklayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Zoomen zusammenziehen oder Befehlstaste-Plus und Befehlstaste-Minus drücken. Zum Verschieben scrollen oder ziehen. Mit Befehlstaste-0 oder Doppelklick wird das Diagramm eingepasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez, ou appuyez sur Commande-Plus et Commande-Moins, pour zoomer. Faites défiler ou faites glisser pour déplacer. Appuyez sur Commande-0 ou double-cliquez pour ajuster le diagramme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捏合，或按下 Command-加号 和 Command-减号 进行缩放。滚动或拖移可平移。按下 Command-0 或双击可使图表适应窗口。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチするか、Command-プラスと Command-マイナスで拡大縮小します。スクロールまたはドラッグで移動します。Command-0 またはダブルクリックで図全体を表示します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ूम करने के लिए पिंच करें, या Command-प्लस और Command-माइनस दबाएँ। हिलाने के लिए स्क्रॉल करें या खींचें। आरेख को फ़िट करने के लिए Command-0 दबाएँ या डबल-क्लिक करें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji bo mezinkirin û biçûkkirinê tiliyên xwe bikişînin hev, an jî Command-Plus û Command-Mînûs bitikînin. Ji bo livandinê bigerînin an bikişînin. Ji bo guncandina diyagramê Command-0 bitikînin an du caran bitikînin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для масштабирования сведите пальцы или нажмите Command-плюс и Command-минус. Для перемещения прокручивайте или перетаскивайте. Нажмите Command-0 или дважды щёлкните, чтобы вписать диаграмму в окно."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubit, atau tekan Command-Plus dan Command-Minus, untuk memperbesar atau memperkecil. Gulir atau seret untuk menggeser. Tekan Command-0 atau klik dua kali untuk menyesuaikan diagram."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জুম করতে পিঞ্চ করুন, অথবা Command-প্লাস ও Command-মাইনাস চাপুন। সরাতে স্ক্রল বা টেনে আনুন। ডায়াগ্রাম ফিট করতে Command-0 চাপুন বা ডাবল-ক্লিক করুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Danna da yatsu biyu, ko ka danna Command-Plus da Command-Minus, don zuƙowa. Gungura ko ja don motsawa. Danna Command-0 ko ka danna sau biyu don dacewa da zane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o gesto de pinça, ou pressione Command-Mais e Command-Menos, para ampliar ou reduzir. Role ou arraste para mover. Pressione Command-0 ou clique duas vezes para ajustar o diagrama."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca, o pulsa Comando-Más y Comando-Menos, para ampliar o reducir. Desplázate o arrastra para mover. Pulsa Comando-0 o haz doble clic para ajustar el diagrama."
          }
        }
      }
    },
