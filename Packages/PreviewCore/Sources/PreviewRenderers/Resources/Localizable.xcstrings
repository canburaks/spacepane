    "preview.markup.mathNotice": {
      "comment": "Status note: formulas in the rendered view are approximated with Unicode characters; they are not typeset.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formulas are approximated with Unicode characters, not typeset."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
