    "appearance.profile.saveDuplicate": {
      "comment": "Explanation shown under the profile name field on the Theme page, and as the Save button's hint, when the typed name is already used by a saved profile. One sentence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
