    "preview.markup.contents.help": {
      "comment": "Accessibility hint of a table-of-contents row: the Return key shows the heading in the document.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Return to show this heading in the document."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu başlığı belgede göstermek için Return tuşuna basın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Eingabetaste diese Überschrift im Dokument anzeigen."
          }
