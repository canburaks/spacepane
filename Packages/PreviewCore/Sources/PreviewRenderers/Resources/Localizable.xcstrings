    "format.data.geojson.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoJSON feature and geometry counts, property names, extent and a map-free plot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoJSON nesne ve geometri sayıları, özellik adları, kapsam ve haritasız bir çizim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoJSON: Anzahl der Features und Geometrien, Eigenschaftsnamen, Ausdehnung und ein kartenfreier Plot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoJSON : nombre d’entités et de géométries, noms des propriétés, étendue et tracé sans carte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoJSON 要素和几何数量、属性名称、范围，以及不含地图的绘图。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoJSON のフィーチャ数とジオメトリ数、プロパティ名、範囲、地図なしのプロット。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoJSON फ़ीचर और ज्यामिति संख्या, गुण नाम, विस्तार और बिना मानचित्र वाला प्लॉट।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejmara feature û geometriyên GeoJSON, navên taybetmendiyan, firehî û xêzkirinek bê nexşe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoJSON: число объектов и геометрий, имена свойств, охват и график без карты."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah fitur dan geometri GeoJSON, nama properti, cakupan, dan plot tanpa peta."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoJSON ফিচার ও জ্যামিতির সংখ্যা, প্রপার্টির নাম, বিস্তার এবং মানচিত্রহীন প্লট।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Adadin siffofi da geometry na GeoJSON, sunayen kaddarori, faɗi da zane ba tare da taswira ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagem de feições e geometrias GeoJSON, nomes de propriedades, extensão e um gráfico sem mapa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de entidades y geometrías de GeoJSON, nombres de propiedades, extensión y un gráfico sin mapa."
          }
        }
      }
    },
