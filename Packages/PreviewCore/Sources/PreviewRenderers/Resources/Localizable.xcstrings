    "preview.dropRejected": {
      "comment": "Inline rejection for an invalid drop. The existing preview remains available; do not imply a file was opened.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop one local file only. Web links and multiple items are unsupported."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca tek bir yerel dosya bırakın. Web bağlantıları ve birden fazla öğe desteklenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie nur eine lokale Datei ab. Weblinks und mehrere Objekte werden nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un seul fichier local. Les liens web et les éléments multiples ne sont pas pris en charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只拖放一个本地文件。不支持网页链接和多个项目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルファイルを1つだけドロップしてください。Web リンクや複数の項目には対応していません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एक स्थानीय फ़ाइल छोड़ें। वेब लिंक और कई आइटम समर्थित नहीं हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenê yek pela herêmî berde. Girêdanên webê û gelek hêman nayên piştgirîkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите только один локальный файл. Веб-ссылки и несколько объектов не поддерживаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan hanya satu berkas lokal. Tautan web dan beberapa item tidak didukung."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেবল একটি স্থানীয় ফাইল ছাড়ুন। ওয়েব লিংক ও একাধিক আইটেম সমর্থিত নয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajiye fayil ɗaya na cikin naʼura kawai. Ba a tallafa wa hanyoyin yanar gizo ko abubuwa da yawa ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte apenas um arquivo local. Links da web e vários itens não são compatíveis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta solo un archivo local. No se admiten enlaces web ni varios elementos."
          }
        }
      }
    },
    "preview.ebooks.notice.chaptersShown": {
      "comment": "Limits-strip sentence for a truncated e-book (EPUB): how many of its chapters the preview shows. Plural: the first argument selects the form by the number of chapters shown; %2$@ prints that number and %3$@ the total number of chapters in the book, both formatted for the display locale, so no variant carries digits. Both numbers come from the e-book adapter's own chapter list, never from the displayed text; the last chapter shown can be cut short. Describes only what this preview shows and says nothing about which app Finder uses. All translations are drafts pending native-speaker review.",
