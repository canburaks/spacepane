    "finding.secret.syncedFolder": {
      "comment": "%@ is a cloud service name such as iCloud Drive or Dropbox, or the phrase ‘a cloud storage folder’.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file holds secrets and is in %@, which copies it to the cloud and your other devices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya gizli bilgiler içeriyor ve bulunduğu konum (%@) onu buluta ve diğer cihazlarınıza kopyalıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei enthält Geheimnisse und liegt in %@, wodurch sie in die Cloud und auf Ihre anderen Geräte kopiert wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier contient des secrets et se trouve dans %@, ce qui entraîne sa copie dans le cloud et sur vos autres appareils."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件包含机密信息，且位于 %@ 中，该位置会将其拷贝到云端和你的其他设备。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには秘密情報が含まれており、%@ にあるため、クラウドやほかのデバイスにコピーされます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल में गोपनीय जानकारी है और यह %@ में है, जहाँ इसे क्लाउड और आपके अन्य डिवाइस पर कॉपी किया जाता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev pel agahiyên veşartî dihewîne û di %@ de ye, ku wê li cloudê û amûrên te yên din kopî dike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл содержит секреты и находится в %@, поэтому он копируется в облако и на другие ваши устройства."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas ini berisi rahasia dan berada di %@, yang menyalinnya ke cloud dan perangkat Anda yang lain."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলে গোপন তথ্য আছে এবং এটি যে স্থানে আছে (%@) সেখান থেকে ক্লাউডে ও আপনার অন্যান্য ডিভাইসে কপি হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan fayil yana ɗauke da sirri kuma yana cikin %@, wanda ke kwafar shi zuwa cloud da sauran naʼurorinku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo contém segredos e está em %@, que o copia para a nuvem e para seus outros dispositivos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo contiene secretos y está en %@, que lo copia en la nube y en tus otros dispositivos."
          }
        }
      }
    },
