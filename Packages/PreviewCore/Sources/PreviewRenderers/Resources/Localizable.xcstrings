    "preview.table.limitCaps": {
      "comment": "Neutral table limit notice for omitted columns or shortened cells. Row omissions have a separate count-aware notice. Does not promise more content in Source. Translations are drafts pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Columns or long cells beyond the table limits are not shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablo sınırlarını aşan sütunlar veya uzun hücreler gösterilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalten oder lange Zellen außerhalb der Tabellengrenzen werden nicht angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les colonnes ou cellules longues dépassant les limites du tableau ne sont pas affichées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出表格限制的列或过长单元格不会显示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表の上限を超える列や長いセルは表示されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तालिका की सीमाओं से बाहर के स्तंभ या लंबे सेल नहीं दिखाए जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Stûn an şaneyên dirêj ên ji sînorên tabloyê derbas dibin nayên nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Столбцы и длинные ячейки за пределами ограничений таблицы не показаны."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom atau sel panjang yang melampaui batas tabel tidak ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারণির সীমা ছাড়ানো কলাম বা দীর্ঘ ঘর দেখানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a nuna ginshiƙai ko dogayen ƙwayoyin da suka wuce iyakokin tebur ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colunas ou células longas além dos limites da tabela não são mostradas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se muestran las columnas o celdas largas que superan los límites de la tabla."
          }
        }
      }
    },
