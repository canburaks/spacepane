    "format.data.kml.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KML and KMZ placemarks and geometry with extent and length, plus a map-free plot; nothing is fetched or extracted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KML ve KMZ yer işaretleri ve geometri; kapsam ve uzunlukla birlikte haritasız bir çizim; hiçbir şey indirilmez veya çıkarılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KML- und KMZ-Ortsmarken und -Geometrie mit Ausdehnung und Länge sowie ein kartenfreier Plot; es wird nichts abgerufen oder entpackt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repères et géométries KML et KMZ avec étendue et longueur, plus un tracé sans carte ; rien n’est téléchargé ni extrait."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KML 和 KMZ 地标与几何图形，含范围和长度，以及不含地图的绘图；不会获取或解压任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KML と KMZ のプレースマークとジオメトリ、範囲と長さ、地図なしのプロット。何も取得・展開しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "KML और KMZ प्लेसमार्क और ज्यामिति, विस्तार और लंबाई के साथ, तथा बिना मानचित्र वाला प्लॉट; कुछ भी डाउनलोड या निकाला नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nîşanên cihê û geometriya KML û KMZ bi firehî û dirêjahî, û xêzkirinek bê nexşe; tiştek nayê anîn an derxistin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метки и геометрия KML и KMZ с охватом и длиной, а также график без карты; ничего не загружается и не распаковывается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penanda tempat dan geometri KML dan KMZ dengan cakupan dan panjang, serta plot tanpa peta; tidak ada yang diambil atau diekstrak."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "KML ও KMZ প্লেসমার্ক ও জ্যামিতি—বিস্তার ও দৈর্ঘ্যসহ—এবং মানচিত্রহীন প্লট; কিছুই আনা বা বের করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamomin wuri da geometry na KML da KMZ tare da faɗi da tsawo, da zane ba tare da taswira ba; ba a ɗauko ko fitar da komai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcadores e geometrias KML e KMZ com extensão e comprimento, além de um gráfico sem mapa; nada é baixado nem extraído."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcas de posición y geometrías KML y KMZ con extensión y longitud, además de un gráfico sin mapa; no se descarga ni se extrae nada."
          }
        }
      }
    },
