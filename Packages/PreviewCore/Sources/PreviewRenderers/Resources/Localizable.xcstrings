            "state": "translated",
            "value": "Aikace-aikacen Android (APK, AAB)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps Android (APK, AAB)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps de Android (APK, AAB)"
          }
        }
      }
    },
    "format.package.application.description": {
      "comment": "One-sentence description of the package.application file type; states what is and is not shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity, version, architectures, signature summary and size. Nothing is run, and the signature is not validated."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik, sürüm, mimariler, imza özeti ve boyut. Hiçbir şey çalıştırılmaz ve imza doğrulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Identität, Version, Architekturen, Signaturübersicht und Größe. Nichts wird ausgeführt, und die Signatur wird nicht validiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identité, version, architectures, résumé de la signature et taille. Rien n’est exécuté et la signature n’est pas validée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标识、版本、架构、签名摘要和大小。不会运行任何内容，也不验证签名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ID、バージョン、アーキテクチャ、署名の概要、サイズ。何も実行せず、署名の検証も行いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचान, संस्करण, आर्किटेक्चर, हस्ताक्षर सारांश और आकार। कुछ भी चलाया नहीं जाता और हस्ताक्षर का सत्यापन नहीं होता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasname, guherto, mîmarî, kurteya îmzeyê û mezinahî. Tiştek nayê xebitandin û îmze nayê piştrastkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор, версия, архитектуры, сводка подписи и размер. Ничего не запускается, подпись не проверяется."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitas, versi, arsitektur, ringkasan tanda tangan, dan ukuran. Tidak ada yang dijalankan, dan tanda tangan tidak divalidasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিচয়, সংস্করণ, আর্কিটেকচার, স্বাক্ষরের সারসংক্ষেপ ও আকার। কিছুই চালানো হয় না এবং স্বাক্ষর যাচাই করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaida, sigar, tsarin gine-gine, taƙaitaccen sa hannu da girma. Ba a gudanar da komai ba, kuma ba a tabbatar da sa hannu ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Identidade, versão, arquiteturas, resumo da assinatura e tamanho. Nada é executado e a assinatura não é validada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Identidad, versión, arquitecturas, resumen de la firma y tamaño. No se ejecuta nada y la firma no se valida."
          }
        }
      }
    },
