    "format.archive.comic-book.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comic pages in reading order with ComicInfo details; nothing is extracted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuma sırasına göre çizgi roman sayfaları ve ComicInfo ayrıntıları; hiçbir şey dışarı çıkarılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Comic-Seiten in Lesereihenfolge mit ComicInfo-Angaben; nichts wird entpackt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages de bande dessinée dans l’ordre de lecture avec les détails ComicInfo ; rien n’est extrait."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按阅读顺序显示漫画页面及 ComicInfo 详情；不会解压任何文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミックのページを読む順に表示し、ComicInfo の情報も表示します。何も展開しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ने के क्रम में कॉमिक के पृष्ठ और ComicInfo का विवरण; कुछ भी निकाला नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rûpelên komîkê bi rêzika xwendinê û hûrgiliyên ComicInfo; tiştek nayê derxistin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы комикса в порядке чтения и сведения ComicInfo; ничего не распаковывается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman komik berurutan sesuai urutan baca beserta detail ComicInfo; tidak ada yang diekstrak."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পড়ার ক্রমে কমিকের পৃষ্ঠা ও ComicInfo-এর তথ্য; কিছুই বের করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shafukan littafin ban dariya bisa tsarin karatu da bayanan ComicInfo; ba a cire komai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas de quadrinhos na ordem de leitura com detalhes do ComicInfo; nada é extraído."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas de cómic en orden de lectura con los detalles de ComicInfo; no se extrae nada."
          }
        }
      }
    },
