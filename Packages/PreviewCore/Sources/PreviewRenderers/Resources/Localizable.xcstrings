            "value": "预览已缩短。已显示单元格：%1$lld 个，共 %2$lld 个。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューを短縮しました。表示セル数: %2$lld 個中 %1$lld 個。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्वावलोकन छोटा किया गया। दिखाए गए सेल: %2$lld में से %1$lld।"
          }
