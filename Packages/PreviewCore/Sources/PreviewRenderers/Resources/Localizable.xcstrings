{
  "sourceLanguage": "en",
  "strings": {
    "about.acknowledgements.body": {
      "comment": "Keep the product and license names untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3D model previews use Open CASCADE Technology under the GNU LGPL 2.1 with the Open CASCADE exception. License notices are included with the app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3B model önizlemeleri, Open CASCADE istisnasıyla birlikte GNU LGPL 2.1 kapsamında Open CASCADE Technology kullanır. Lisans bildirimleri uygulamayla birlikte gelir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3D-Modellvorschauen verwenden Open CASCADE Technology unter der GNU LGPL 2.1 mit der Open-CASCADE-Ausnahme. Lizenzhinweise sind in der App enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus de modèles 3D utilisent Open CASCADE Technology sous licence GNU LGPL 2.1 avec l’exception Open CASCADE. Les avis de licence sont inclus dans l’app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 模型预览使用 Open CASCADE Technology，遵循 GNU LGPL 2.1 及 Open CASCADE 例外条款。许可声明随应用一同提供。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3Dモデルのプレビューには、GNU LGPL 2.1 および Open CASCADE 例外の下で提供される Open CASCADE Technology を使用しています。ライセンス表示はアプリに含まれています。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3D मॉडल पूर्वावलोकन Open CASCADE अपवाद सहित GNU LGPL 2.1 के अंतर्गत Open CASCADE Technology का उपयोग करते हैं। लाइसेंस सूचनाएँ ऐप के साथ शामिल हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtinên modela 3D Open CASCADE Technology di bin GNU LGPL 2.1 de bi îstisnaya Open CASCADE bi kar tînin. Notên lîsansê bi sepanê re hene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для предпросмотра 3D-моделей используется Open CASCADE Technology по лицензии GNU LGPL 2.1 с исключением Open CASCADE. Уведомления о лицензиях включены в приложение."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau model 3D menggunakan Open CASCADE Technology di bawah GNU LGPL 2.1 dengan pengecualian Open CASCADE. Pemberitahuan lisensi disertakan bersama aplikasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "3D মডেল প্রিভিউ Open CASCADE ব্যতিক্রমসহ GNU LGPL 2.1-এর অধীনে Open CASCADE Technology ব্যবহার করে। লাইসেন্স বিজ্ঞপ্তি অ্যাপের সঙ্গে অন্তর্ভুক্ত।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubawar samfuran 3D tana amfani da Open CASCADE Technology ƙarƙashin GNU LGPL 2.1 tare da banbancin Open CASCADE. An haɗa sanarwar lasisi da manhajar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As pré-visualizações de modelos 3D usam o Open CASCADE Technology sob a GNU LGPL 2.1 com a exceção do Open CASCADE. Os avisos de licença estão incluídos no app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vistas previas de modelos 3D usan Open CASCADE Technology bajo la GNU LGPL 2.1 con la excepción de Open CASCADE. Los avisos de licencia se incluyen con la app."
          }
        }
      }
    },
    "about.acknowledgements.openCascade": {
      "comment": "Plain paragraph in the About page's Acknowledgements card, under the Open CASCADE license sentence. Not formatted. Keep the product names Open CASCADE Technology and OPEN CASCADE SAS unchanged. It is the copyright line the LGPL asks the app to show, followed by a note that the 3D import helper's source and a written offer for the library source are public; a link row named by about.link.openSource follows it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open CASCADE Technology is copyright OPEN CASCADE SAS and its contributors. The source of the 3D import helper and the written offer for the library source are public."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open CASCADE Technology’nin telif hakkı OPEN CASCADE SAS ve katkıda bulunanlara aittir. 3B içe aktarma yardımcısının kaynağı ve kütüphane kaynağına ilişkin yazılı teklif herkese açıktır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Copyright an Open CASCADE Technology liegt bei OPEN CASCADE SAS und seinen Mitwirkenden. Der Quellcode des 3D-Import-Helfers und das schriftliche Angebot für den Quellcode der Bibliothek sind öffentlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open CASCADE Technology est protégé par le copyright d’OPEN CASCADE SAS et de ses contributeurs. Le code source de l’assistant d’import 3D et l’offre écrite pour le code source de la bibliothèque sont publics."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Open CASCADE Technology 的版权归 OPEN CASCADE SAS 及其贡献者所有。3D 导入辅助程序的源代码以及针对该库源代码的书面要约均已公开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Open CASCADE Technology の著作権は OPEN CASCADE SAS とその貢献者に帰属します。3D インポートヘルパーのソースコードと、ライブラリのソースコードに関する書面による申し出は公開されています。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Open CASCADE Technology का कॉपीराइट OPEN CASCADE SAS और उसके योगदानकर्ताओं के पास है। 3D इम्पोर्ट हेल्पर का सोर्स और लाइब्रेरी के सोर्स के लिए लिखित प्रस्ताव सार्वजनिक हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mafê kopîkirinê yê Open CASCADE Technology ya OPEN CASCADE SAS û beşdarvanên wê ye. Çavkaniya alîkarê împortkirina 3D û pêşniyara nivîskî ya ji bo çavkaniya pirtûkxaneyê gelemperî ne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторские права на Open CASCADE Technology принадлежат OPEN CASCADE SAS и её участникам. Исходный код помощника импорта 3D и письменное предложение об исходном коде библиотеки общедоступны."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hak cipta Open CASCADE Technology dimiliki OPEN CASCADE SAS dan para kontributornya. Kode sumber pembantu impor 3D dan penawaran tertulis untuk kode sumber pustaka tersedia untuk umum."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Open CASCADE Technology-এর কপিরাইট OPEN CASCADE SAS ও এর অবদানকারীদের। 3D ইমপোর্ট সহায়কের সোর্স এবং লাইব্রেরির সোর্সের জন্য লিখিত প্রস্তাব সর্বজনীন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Haƙƙin mallaka na Open CASCADE Technology na OPEN CASCADE SAS ne da masu ba da gudummawarsa. Tushen naʼurar taimakon shigo da 3D da rubutaccen tayin tushen ɗakin karatu a bayyane suke ga kowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O copyright do Open CASCADE Technology pertence à OPEN CASCADE SAS e aos seus colaboradores. O código-fonte do auxiliar de importação 3D e a oferta escrita para o código-fonte da biblioteca são públicos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El copyright de Open CASCADE Technology pertenece a OPEN CASCADE SAS y a sus colaboradores. El código fuente del asistente de importación 3D y la oferta escrita para el código fuente de la biblioteca son públicos."
          }
        }
      }
    },
