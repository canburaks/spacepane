    "format.text.nfo.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code page 437 text art and release notes decoded into safe text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod sayfası 437 metin sanatı ve sürüm notları güvenli metne dönüştürülür."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textkunst und Versionshinweise in Codepage 437, als sicherer Text dekodiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Art textuel et notes de version en page de code 437, décodés en texte sécurisé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将代码页 437 文本艺术和发布说明解码为安全文本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードページ 437 のテキストアートとリリースノートを安全なテキストにデコードします。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड पेज 437 का टेक्स्ट आर्ट और रिलीज़ नोट्स सुरक्षित पाठ में डिकोड किए जाते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hunera nivîsê û notên weşanê yên rûpela kodê 437 wekî nivîsa ewle tên vekirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстовая графика и примечания к выпуску в кодовой странице 437, декодированные в безопасный текст."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni teks dan catatan rilis kode halaman 437 didekodekan menjadi teks aman."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোড পেজ 437-এর টেক্সট আর্ট ও রিলিজ নোট নিরাপদ লেখায় ডিকোড করা হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana fassara zanen rubutu da bayanan fitarwa na shafin lamba 437 zuwa rubutu mai aminci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arte em texto e notas de versão na página de código 437 decodificadas em texto seguro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arte de texto y notas de versión en la página de códigos 437 decodificados como texto seguro."
          }
        }
      }
    },
