    "format.text.bibtex.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX entries as a formatted reference list in APA, MLA, Chicago or IEEE style, plus safe source; nothing is fetched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX kayıtları APA, MLA, Chicago veya IEEE stilinde biçimlendirilmiş kaynakça olarak ve güvenli kaynak; hiçbir şey indirilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX-Einträge als formatierte Literaturliste im Stil APA, MLA, Chicago oder IEEE sowie sichere Quelle; es wird nichts abgerufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrées BibTeX sous forme de liste de références mise en forme (APA, MLA, Chicago ou IEEE) et source sûre ; rien n’est téléchargé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 BibTeX 条目显示为 APA、MLA、Chicago 或 IEEE 格式的参考文献列表，并提供安全源码；不会获取任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX のエントリを APA、MLA、Chicago、IEEE のスタイルで整形した参考文献一覧と安全なソース。何も取得しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX प्रविष्टियाँ APA, MLA, Chicago या IEEE शैली की स्वरूपित संदर्भ सूची के रूप में, साथ में सुरक्षित स्रोत; कुछ भी डाउनलोड नहीं होता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomarên BibTeX wekî lîsteya çavkaniyên formatkirî bi şêwazên APA, MLA, Chicago an IEEE û çavkaniya ewle; tiştek nayê anîn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи BibTeX в виде оформленного списка литературы (APA, MLA, Chicago или IEEE) и безопасный исходник; ничего не загружается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Entri BibTeX sebagai daftar referensi terformat gaya APA, MLA, Chicago, atau IEEE, plus sumber aman; tidak ada yang diunduh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "BibTeX এন্ট্রি APA, MLA, Chicago বা IEEE শৈলীতে বিন্যস্ত গ্রন্থপঞ্জি হিসেবে এবং নিরাপদ উৎস; কিছুই আনা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shigarwar BibTeX a matsayin jerin nassoshi da aka tsara da salon APA, MLA, Chicago ko IEEE, tare da amintaccen tushe; ba a ɗauko komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entradas BibTeX como lista de referências formatada em APA, MLA, Chicago ou IEEE, mais código-fonte seguro; nada é baixado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entradas BibTeX como lista de referencias con formato APA, MLA, Chicago o IEEE, más código fuente seguro; no se descarga nada."
          }
        }
      }
    },
