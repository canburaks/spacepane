    "format.config.ini.description": {
      "comment": "Description of the INI-family configuration file type. Technical suffixes stay as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sections and settings from INI, properties and .conf files. Likely secrets are concealed; nothing is expanded or included."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "INI, properties ve .conf dosyalarındaki bölümler ve ayarlar. Olası sırlar gizlenir; hiçbir şey genişletilmez veya içe aktarılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschnitte und Einstellungen aus INI-, Properties- und .conf-Dateien. Wahrscheinliche Geheimnisse werden verborgen; nichts wird erweitert oder eingebunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sections et réglages des fichiers INI, properties et .conf. Les secrets probables sont masqués ; rien n’est développé ni inclus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 INI、properties 和 .conf 文件的分区与设置。可能的机密信息会被隐藏；不会展开或包含任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "INI、properties、.conf ファイルのセクションと設定。機密と思われる値は隠され、展開やインクルードは行われません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "INI, properties और .conf फ़ाइलों के अनुभाग और सेटिंग। संभावित गोपनीय जानकारी छिपाई जाती है; कुछ भी विस्तारित या शामिल नहीं किया जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş û mîhengên pelên INI, properties û .conf. Agahiyên veşartî yên gengaz têne veşartin; tu tişt nayê fireh kirin an tevlî kirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделы и параметры файлов INI, properties и .conf. Вероятные секреты скрываются; ничего не раскрывается и не подключается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian dan pengaturan dari berkas INI, properties, dan .conf. Rahasia yang mungkin disembunyikan; tidak ada yang diperluas atau disertakan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "INI, properties ও .conf ফাইলের অংশ ও সেটিং। সম্ভাব্য গোপন তথ্য লুকানো হয়; কিছুই প্রসারিত বা অন্তর্ভুক্ত করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sassa da saituna daga fayilolin INI, properties da .conf. Ana ɓoye sirrin da ake zato; ba a faɗaɗa ko haɗa komai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seções e configurações de arquivos INI, properties e .conf. Prováveis segredos são ocultados; nada é expandido ou incluído."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Secciones y ajustes de archivos INI, properties y .conf. Los secretos probables se ocultan; nada se expande ni se incluye."
          }
        }
      }
    },
    "format.config.ini.name": {
