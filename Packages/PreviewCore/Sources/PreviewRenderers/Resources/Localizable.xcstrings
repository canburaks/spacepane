    "settings.providers.scanSubtitle": {
      "comment": "Explanation of what the scan does. It only reads installed apps and changes nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks in installed apps for Quick Look extensions that handle some of the same file types. Nothing is changed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü uygulamalarda, aynı dosya türlerinin bir kısmını işleyen Quick Look uzantılarını arar. Hiçbir şey değiştirilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht in installierten Apps nach Quick Look-Erweiterungen, die einige derselben Dateitypen verarbeiten. Es wird nichts geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche dans les apps installées les extensions Quick Look qui gèrent certains des mêmes types de fichiers. Rien n’est modifié."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已安装的 App 中查找处理部分相同文件类型的快速查看扩展。不会更改任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのアプリから、同じファイルの種類の一部を扱うクイックルック機能拡張を探します。何も変更されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल किए गए ऐप में ऐसे Quick Look एक्सटेंशन खोजता है जो कुछ समान फ़ाइल प्रकार संभालते हैं। कुछ भी बदला नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Di sepanên sazkirî de li pêvekên Quick Look digere ku hin cureyên pelan ên hevpar birêve dibin. Tiştek nayê guhertin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет в установленных приложениях расширения Quick Look, которые обрабатывают часть тех же типов файлов. Ничего не изменяется."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari ekstensi Quick Look di aplikasi terpasang yang menangani sebagian jenis berkas yang sama. Tidak ada yang diubah."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনস্টল করা অ্যাপে এমন Quick Look এক্সটেনশন খোঁজে যা কিছু একই ফাইলের ধরন সামলায়। কিছুই বদলানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana bincika manhajojin da aka sanya don neman ƙarin Quick Look da ke sarrafa wasu nauʼoʼin fayil iri ɗaya. Ba a canza komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura nos apps instalados extensões do Quick Look que tratam de alguns dos mesmos tipos de arquivo. Nada é alterado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en las apps instaladas extensiones de Quick Look que gestionan algunos de los mismos tipos de archivo. No se cambia nada."
          }
        }
      }
    },
