        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छिपाए गए मान वाले स्तंभों में केवल यह दिखाया जाता है कि कितने सेल खाली हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Di stûnên ku nirxên veşartî hene de tenê tê nîşandan ka çend şane vala ne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для столбцов со скрытыми значениями показано только число пустых ячеек."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom dengan nilai yang disamarkan hanya menampilkan jumlah sel yang kosong."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লুকানো মান থাকা কলামে শুধু দেখানো হয় কয়টি সেল খালি।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginshiƙai masu ƙimomin da aka ɓoye suna nuna adadin sel da ba su da komai kawai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As colunas com valores ocultados mostram apenas quantas células estão vazias."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las columnas con valores ocultos muestran solo cuántas celdas están vacías."
          }
        }
      }
    },
