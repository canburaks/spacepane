    "preview.table.truncatedSummary": {
      "comment": "Notice under a table made from an app-written data summary (Parquet, Avro, Arrow, NumPy, HAR, the SQLite schema grid) or from only the first part of a large file, when rows were left out. It deliberately does not send the reader to the Source mode: for a data summary Source holds the same bounded rows, and for a large file only the first part was read. One sentence, no placeholders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the first rows the preview read are shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca önizlemenin okuduğu ilk satırlar gösteriliyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur die ersten Zeilen angezeigt, die die Vorschau gelesen hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les premières lignes lues par l’aperçu sont affichées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示预览已读取的前几行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示されているのは、プレビューが読み取った最初の行だけです。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वही पहली पंक्तियाँ दिखाई गई हैं जिन्हें पूर्वावलोकन ने पढ़ा।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenê rêzikên pêşîn ên ku pêşdîtinê xwendine têne nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны только первые строки, прочитанные при предпросмотре."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya baris pertama yang dibaca pratinjau yang ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রিভিউ যে প্রথম সারিগুলো পড়েছে শুধু সেগুলোই দেখানো হচ্ছে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana nuna layukan farko kawai da samfoti ya karanta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as primeiras linhas lidas pela pré-visualização são exibidas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran las primeras filas que leyó la vista previa."
          }
        }
      }
    },
    "preview.table.truncatedText": {
      "comment": "Notice under a table made from the file's own text (CSV, TSV, String Catalog) that was read whole, when columns, rows or long cells beyond the table limits were left out. Source is the name of the Source preview mode: keep it identical to the translation of preview.mode.source. Them means the omitted columns, rows or long cells. Two short sentences, no placeholders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Columns, rows or long cells beyond the table limits are not shown here. Source shows them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablo sınırlarını aşan sütunlar, satırlar veya uzun hücreler burada gösterilmiyor. Kaynak bunları gösterir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalten, Zeilen oder lange Zellen über den Tabellengrenzen werden hier nicht angezeigt. Quelle zeigt sie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les colonnes, lignes ou longues cellules au-delà des limites du tableau ne sont pas affichées ici. Source les affiche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出表格限制的列、行或过长的单元格不会在此显示。“源码”会显示它们。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表の上限を超える列、行、長いセルはここには表示されません。「ソース」で確認できます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तालिका की सीमा से अधिक स्तंभ, पंक्तियाँ या लंबे सेल यहाँ नहीं दिखाए जाते। स्रोत उन्हें दिखाता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Stûn, rêzik an şaneyên dirêj ên ji sînorên tabloyê derbas dibin li vir nayên nîşandan. Çavkanî wan nîşan dide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Столбцы, строки и длинные ячейки сверх пределов таблицы здесь не показаны. Вкладка «Исходный текст» показывает их."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom, baris, atau sel panjang di luar batas tabel tidak ditampilkan di sini. Sumber menampilkannya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারণির সীমা ছাড়ানো কলাম, সারি বা দীর্ঘ ঘর এখানে দেখানো হয় না। উৎস সেগুলো দেখায়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a nuna ginshiƙai, layuka ko dogayen sel da suka wuce iyakar tebur a nan. Tushe yana nuna su."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colunas, linhas ou células longas além dos limites da tabela não são exibidas aqui. Origem as mostra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las columnas, filas o celdas largas que superan los límites de la tabla no se muestran aquí. Código fuente las muestra."
          }
        }
      }
    },
    "preview.typographyFallbackHint": {
      "comment": "Visible native-renderer hint when a saved family or requested trait is unavailable. No raw system error text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some requested font settings are unavailable. The preview uses the closest supported font."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstenen bazı yazı tipi ayarları kullanılamıyor. Önizleme desteklenen en yakın yazı tipini kullanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige angeforderte Schrifteinstellungen sind nicht verfügbar. Die Vorschau verwendet die ähnlichste unterstützte Schrift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains réglages de police demandés sont indisponibles. L’aperçu utilise la police prise en charge la plus proche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分所需字体设置不可用。预览使用最接近的受支持字体。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定したフォント設定の一部を利用できません。プレビューでは最も近い対応フォントを使用します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ अनुरोधित फ़ॉन्ट सेटिंग्ज़ उपलब्ध नहीं हैं। पूर्वावलोकन सबसे निकट समर्थित फ़ॉन्ट का उपयोग करता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hin mîhengên fontê yên daxwazkirî nayên bikaranîn. Pêşdîtin fonta piştgirîkirî ya herî nêzîk bi kar tîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые запрошенные настройки шрифта недоступны. Предпросмотр использует ближайший поддерживаемый вариант."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa pengaturan font yang diminta tidak tersedia. Pratinjau menggunakan font yang didukung paling mendekati."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু অনুরোধ করা ফন্ট সেটিংস উপলব্ধ নয়। প্রিভিউ সবচেয়ে কাছাকাছি সমর্থিত ফন্ট ব্যবহার করে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasu saitunan nauʼin rubutu da aka nema ba su samuwa. Dubawar tana amfani da mafi kusa da ake tallafawa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns ajustes de fonte solicitados estão indisponíveis. A pré-visualização usa a fonte compatível mais próxima."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos ajustes de fuente solicitados no están disponibles. La vista previa usa la fuente compatible más cercana."
          }
        }
      }
    },
    "profile.cell.commonValue": {
