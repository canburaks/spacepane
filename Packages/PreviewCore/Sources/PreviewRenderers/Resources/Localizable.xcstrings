    "notebook.images.sourceOmitted": {
      "comment": "Notebook provenance notice. Embedded image output values are replaced by inert JSON null placeholders under their original MIME keys in the Source mode. Code, text outputs and metadata keep their normal bounded privacy filtering. Source is the localized name of the preview mode. Translations are drafts pending native-speaker review.",
      "extractionState": "manual",
