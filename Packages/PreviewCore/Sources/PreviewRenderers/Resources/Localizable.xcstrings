    "fileTypes.subtitle": {
      "comment": "Subtitle of the File Types page. The placeholder is the app's display name; keep it unchanged. Say that the user chooses which types this app may preview and that macOS decides which app previews each file. Never imply that Finder uses this app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which file types %@ may preview. macOS decides which app previews each file."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasının hangi dosya türlerini önizleyebileceğini seçin. Her dosyayı hangi uygulamanın önizleyeceğine macOS karar verir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, welche Dateitypen %@ in der Vorschau anzeigen darf. macOS entscheidet, welche App jede Datei in der Vorschau anzeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les types de fichiers dont %@ peut afficher l’aperçu. macOS décide quelle app affiche l’aperçu de chaque fichier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 %@ 可以预览哪些文件类型。macOS 决定由哪个应用预览每个文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がプレビューできるファイルの種類を選択します。各ファイルをどのアプリでプレビューするかは macOS が決定します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि %@ किन फ़ाइल प्रकारों का पूर्वावलोकन कर सकता है। हर फ़ाइल का पूर्वावलोकन कौन-सा ऐप करेगा, यह macOS तय करता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilbijêre ka %@ dikare kîjan cureyên pelan pêşdîtin bike. macOS biryar dide ka kîjan sepan her pelê pêşdîtin dike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите типы файлов, для которых %@ может показывать предпросмотр. Какое приложение показывает предпросмотр каждого файла, решает macOS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jenis berkas yang boleh dipratinjau oleh %@. macOS menentukan aplikasi mana yang menampilkan pratinjau setiap berkas."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ কোন ফাইলের ধরনের প্রিভিউ দেখাতে পারবে তা বেছে নিন। কোন অ্যাপ প্রতিটি ফাইলের প্রিভিউ দেখাবে, তা macOS ঠিক করে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi nauʼoʼin fayil da za a iya duba su da %@. macOS ne ke yanke shawarar manhajar da ke duba kowane fayil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais tipos de arquivo podem ser pré-visualizados por %@. O macOS decide qual app pré-visualiza cada arquivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué tipos de archivo puede previsualizar %@. macOS decide qué app previsualiza cada archivo."
          }
        }
      }
    },
    "finding.action.copied": {
      "comment": "Confirmation after the concealed text was copied to the clipboard; also announced by VoiceOver.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
