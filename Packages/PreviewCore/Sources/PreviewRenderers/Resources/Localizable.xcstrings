    "format.data.avro.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded Avro container inspection: schema, record counts and the first records; null and deflate codecs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı Avro kapsayıcı incelemesi: şema, kayıt sayıları ve ilk kayıtlar; null ve deflate codec’leri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Prüfung von Avro-Containern: Schema, Datensatzanzahl und die ersten Datensätze; Codecs null und deflate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspection bornée des conteneurs Avro : schéma, nombre d’enregistrements et premiers enregistrements ; codecs null et deflate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对 Avro 容器进行有限检查：架构、记录数量和前几条记录；支持 null 和 deflate 编解码器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Avro コンテナの制限付き確認：スキーマ、レコード数、先頭のレコード。null と deflate コーデックに対応します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित Avro कंटेनर निरीक्षण: स्कीमा, रिकॉर्ड संख्या और पहले रिकॉर्ड; null और deflate कोडेक।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Venêrîna sînorkirî ya konteynera Avro: schema, hejmara tomaran û tomarên yekem; kodekên null û deflate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченный просмотр контейнеров Avro: схема, число записей и первые записи; кодеки null и deflate."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan kontainer Avro terbatas: skema, jumlah rekaman, dan rekaman pertama; codec null dan deflate."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমিত Avro কন্টেইনার পরিদর্শন: স্কিমা, রেকর্ডের সংখ্যা ও প্রথম রেকর্ডগুলো; null ও deflate কোডেক।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Binciken kwantena na Avro mai iyaka: tsari, adadin bayanai da bayanai na farko; codec null da deflate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspeção limitada de contêineres Avro: esquema, contagem de registros e os primeiros registros; codecs null e deflate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspección acotada de contenedores Avro: esquema, número de registros y los primeros registros; códecs null y deflate."
          }
        }
      }
    },
