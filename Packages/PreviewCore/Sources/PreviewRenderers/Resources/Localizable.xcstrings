    "format.package.mcp-bundle.description": {
      "comment": "One-sentence description of a file type in the companion's File Types list: MCP bundles; the summary shows what the bundled server runs and asks for. Technical names stay as they are. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server’s program, tools, settings and folder access from its manifest. Nothing is installed or run."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun programı, araçları, ayarları ve klasör erişimi, manifestten okunur. Hiçbir şey kurulmaz veya çalıştırılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programm, Werkzeuge, Einstellungen und Ordnerzugriff des Servers aus dem Manifest. Nichts wird installiert oder ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme, outils, réglages et accès aux dossiers du serveur, lus dans le manifeste. Rien n’est installé ni exécuté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从清单读取服务器的程序、工具、设置和文件夹访问权限。不会安装或运行任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マニフェストから、サーバのプログラム、ツール、設定、フォルダへのアクセスを表示します。何もインストールや実行はしません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैनिफ़ेस्ट से सर्वर का प्रोग्राम, टूल, सेटिंग और फ़ोल्डर एक्सेस। कुछ भी इंस्टॉल या चलाया नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bername, amûr, mîheng û gihîştina peldankan a serverê ji manîfestoyê. Tiştek nayê sazkirin an xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа, инструменты, настройки и доступ к папкам сервера из манифеста. Ничего не устанавливается и не запускается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Program, alat, pengaturan, dan akses folder server dari manifes. Tidak ada yang diinstal atau dijalankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যানিফেস্ট থেকে সার্ভারের প্রোগ্রাম, টুল, সেটিং ও ফোল্ডার অ্যাক্সেস। কিছুই ইনস্টল বা চালানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shirin server, kayan aiki, saituna da damar shiga manyan fayiloli daga manifest. Ba a shigar ko gudanar da komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programa, ferramentas, configurações e acesso a pastas do servidor, lidos do manifesto. Nada é instalado nem executado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programa, herramientas, ajustes y acceso a carpetas del servidor, leídos del manifiesto. No se instala ni se ejecuta nada."
          }
        }
      }
    },
