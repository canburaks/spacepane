    "finding.install.buildScript": {
      "comment": "Informational finding for a Python source package (sdist): installing it from source runs its own setup script (setup.py) on this Mac. This is normal for source packages; it is not a warning. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building or installing this source package runs its setup script."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak paketini derlemek veya kurmak, kendi kurulum betiğini çalıştırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erstellen oder Installieren dieses Quellpakets wird sein Setup-Skript ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilation ou l’installation de ce paquet source exécute son script d’installation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建或安装此源码包时会运行其安装脚本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソースパッケージをビルドまたはインストールすると、セットアップスクリプトが実行されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सोर्स पैकेज को बिल्ड या इंस्टॉल करने पर इसकी सेटअप स्क्रिप्ट चलती है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Avakirin an sazkirina vî pakêta çavkaniyê skrîpta wê ya sazkirinê dixebitîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сборке или установке этого пакета с исходным кодом запускается его скрипт установки."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membangun atau menginstal paket sumber ini menjalankan skrip penyiapannya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সোর্স প্যাকেজ বিল্ড বা ইনস্টল করলে এর সেটআপ স্ক্রিপ্ট চলে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Gina ko shigar da wannan kunshin tushe yana gudanar da script ɗinsa na saiti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilar ou instalar este pacote de código-fonte executa o script de configuração dele."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilar o instalar este paquete de código fuente ejecuta su script de configuración."
          }
        }
      }
    },
    "finding.install.nativeBuild": {
      "comment": "Safety finding for an npm package: the package contains a build file (binding.gyp) that makes the installer compile and run native code, even when the package declares no install scripts. binding.gyp is not shown here. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing this package compiles native code from a build file, even without install scripts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu paketi kurmak, kurulum betikleri olmasa bile bir derleme dosyasından makine kodu derler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation dieses Pakets kompiliert nativen Code aus einer Build-Datei, auch ohne Installationsskripte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation de ce paquet compile du code natif à partir d’un fichier de build, même sans script d’installation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装此软件包时会根据构建文件编译原生代码，即使它没有安装脚本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパッケージをインストールすると、インストールスクリプトがなくても、ビルドファイルからネイティブコードがコンパイルされます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पैकेज को इंस्टॉल करने पर इंस्टॉल स्क्रिप्ट न होने पर भी बिल्ड फ़ाइल से नेटिव कोड कंपाइल होता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazkirina vî pakêtî, tevî ku skrîptên sazkirinê tune bin jî, koda makîneyê ji pelekî avakirinê kompîle dike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установка этого пакета компилирует нативный код из файла сборки, даже если скриптов установки нет."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menginstal paket ini mengompilasi kode native dari berkas build, meskipun tanpa skrip penginstalan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
