    "format.text.log.description": {
      "comment": "Description of the log file type: highlighting of timestamps, severities and stack frames.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timestamps, severity levels and stack frames highlighted for reading. Credentials and tokens are concealed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman damgaları, önem düzeyleri ve yığın çerçeveleri okumak için vurgulanır. Kimlik bilgileri ve belirteçler gizlenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitstempel, Schweregrade und Stack-Frames werden zum Lesen hervorgehoben. Zugangsdaten und Tokens werden verborgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horodatages, niveaux de gravité et trames de pile mis en valeur pour la lecture. Les identifiants et jetons sont masqués."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间戳、严重级别和调用栈帧会高亮显示，便于阅读。凭据和令牌会被隐藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムスタンプ、重大度、スタックフレームを読みやすく強調表示します。認証情報とトークンは隠されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमस्टैम्प, गंभीरता स्तर और स्टैक फ़्रेम पढ़ने के लिए हाइलाइट किए जाते हैं। क्रेडेंशियल और टोकन छिपाए जाते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Demnîşan, asta giraniyê û çarçoveyên stackê ji bo xwendinê tên ronî kirin. Agahiyên têketinê û token têne veşartin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метки времени, уровни важности и кадры стека выделяются для удобства чтения. Учётные данные и токены скрываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stempel waktu, tingkat keparahan, dan frame stack disorot agar mudah dibaca. Kredensial dan token disembunyikan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইমস্ট্যাম্প, গুরুত্বের স্তর ও স্ট্যাক ফ্রেম পড়ার সুবিধার জন্য হাইলাইট করা হয়। পরিচয়পত্র ও টোকেন লুকানো হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana haskaka lokutan rubutu, matakan tsanani da firam ɗin stack don karantawa. Ana ɓoye bayanan shiga da alamu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carimbos de data/hora, níveis de gravidade e quadros de pilha destacados para leitura. Credenciais e tokens são ocultados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcas de tiempo, niveles de gravedad y marcos de pila resaltados para facilitar la lectura. Las credenciales y los tokens se ocultan."
          }
        }
      }
    },
