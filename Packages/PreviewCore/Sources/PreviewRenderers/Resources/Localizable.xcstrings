    "format.ml.safetensors.description": {
      "comment": "One-sentence description of a file type in the companion's File Types list: safetensors AI model files; only the header is read. Technical names stay as they are. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tensors, parameter count, data types and metadata from the header, with LoRA and shard details. Model weights are never read."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst bilgiden tensörler, parametre sayısı, veri türleri ve üst veriler; LoRA ve parça ayrıntılarıyla. Model ağırlıkları hiçbir zaman okunmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tensoren, Parameteranzahl, Datentypen und Metadaten aus dem Header, mit LoRA- und Shard-Details. Modellgewichte werden nie gelesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenseurs, nombre de paramètres, types de données et métadonnées lus dans l’en-tête, avec les détails LoRA et des shards. Les poids du modèle ne sont jamais lus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从头部读取张量、参数数量、数据类型和元数据，以及 LoRA 和分片详情。从不读取模型权重。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッダから、テンソル、パラメータ数、データ型、メタデータ、LoRA とシャードの詳細を表示します。モデルの重みは読み取りません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हेडर से टेन्सर, पैरामीटर की संख्या, डेटा प्रकार और मेटाडेटा, साथ में LoRA और शार्ड का विवरण। मॉडल वेट कभी नहीं पढ़े जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tensor, hejmara parametreyan, cureyên daneyan û metadata ji sernivîsê, bi hûrguliyên LoRA û shard re. Giraniyên modelê tu carî nayên xwendin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тензоры, число параметров, типы данных и метаданные из заголовка, а также сведения о LoRA и шардах. Веса модели никогда не читаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tensor, jumlah parameter, tipe data, dan metadata dari header, beserta detail LoRA dan shard. Bobot model tidak pernah dibaca."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হেডার থেকে টেনসর, প্যারামিটারের সংখ্যা, ডেটার ধরন ও মেটাডেটা, সঙ্গে LoRA ও শার্ডের বিবরণ। মডেলের ওয়েট কখনও পড়া হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tensor, adadin parameter, nauʼin bayanai da metadata daga kan fayil, tare da bayanan LoRA da shard. Ba a taɓa karanta nauyin samfurin ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tensores, número de parâmetros, tipos de dados e metadados lidos do cabeçalho, com detalhes de LoRA e shards. Os pesos do modelo nunca são lidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tensores, número de parámetros, tipos de datos y metadatos leídos de la cabecera, con detalles de LoRA y shards. Los pesos del modelo nunca se leen."
          }
        }
      }
    },
