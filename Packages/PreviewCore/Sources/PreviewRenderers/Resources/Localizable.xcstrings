    "preview.package.notice.certificate": {
      "comment": "Status-line notice shown with certificate summaries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificates are shown as stored. Trust and revocation are not checked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifikalar kayıtlı olduğu gibi gösterilir. Güven ve iptal durumu denetlenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikate werden wie gespeichert angezeigt. Vertrauen und Sperrung werden nicht geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les certificats sont affichés tels qu’enregistrés. La confiance et la révocation ne sont pas vérifiées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证书按存储内容显示，不检查信任状态和吊销状态。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書は保存されたまま表示されます。信頼性や失効の確認は行いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणपत्र जैसे संग्रहीत हैं वैसे ही दिखाए जाते हैं। भरोसे और निरस्तीकरण की जाँच नहीं की जाती।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertîfîka wekî hatine tomarkirin têne nîşandan. Pêbawerî û betalkirin nayên kontrolkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификаты показаны как сохранены. Доверие и отзыв не проверяются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifikat ditampilkan apa adanya. Kepercayaan dan pencabutan tidak diperiksa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্টিফিকেট যেভাবে সংরক্ষিত আছে সেভাবেই দেখানো হয়। বিশ্বাসযোগ্যতা ও প্রত্যাহার পরীক্ষা করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana nuna takaddun shaida kamar yadda aka adana su. Ba a duba amincewa da soke su ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os certificados são exibidos como armazenados. Confiança e revogação não são verificadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los certificados se muestran tal como están almacenados. No se comprueban la confianza ni la revocación."
          }
        }
      }
    },
    "preview.package.notice.signature": {
      "comment": "Status-line notice shown with application, installer and profile summaries. One sentence of at most 12 words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signatures are shown as stored and not verified; notarization is not checked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmzalar kayıtlı olduğu gibi gösterilir. Doğrulanmaz ve noter onayı denetlenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturen werden wie gespeichert angezeigt. Sie werden nicht geprüft, und die Notarisierung wird nicht kontrolliert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signatures sont affichées telles qu’enregistrées. Elles ne sont pas vérifiées et la notarisation n’est pas contrôlée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名按存储内容显示，不会验证，也不检查公证。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名は保存されたまま表示されます。検証や公証の確認は行いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्ताक्षर जैसे संग्रहीत हैं वैसे ही दिखाए जाते हैं। उनका सत्यापन नहीं किया जाता और नोटरीकरण की जाँच नहीं होती।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Îmze wekî hatine tomarkirin têne nîşandan. Ne têne piştrastkirin û notarîzasyon nayê kontrolkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписи показаны как сохранены. Они не проверяются, нотаризация не проверяется."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda tangan ditampilkan apa adanya. Tidak diverifikasi, dan notarisasi tidak diperiksa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বাক্ষর যেভাবে সংরক্ষিত আছে সেভাবেই দেখানো হয়। এগুলো যাচাই করা হয় না এবং নোটারাইজেশনও পরীক্ষা করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana nuna sa hannu kamar yadda aka adana su. Ba a tabbatar da su ba, kuma ba a duba notarization ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas são exibidas como armazenadas. Elas não são verificadas e a notarização não é checada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las firmas se muestran tal como están almacenadas. No se verifican y no se comprueba la notarización."
          }
        }
      }
    },
