    "preview.emptyDescription": {
      "comment": "Empty direct-preview state description; JSON Lines uses a validated source view.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a supported local file. Likely secrets are concealed before display, selection, and copying."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen bir yerel dosya açın. Olası gizli bilgiler görüntüleme, seçme ve kopyalama öncesinde gizlenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie eine unterstützte lokale Datei. Wahrscheinliche Geheimnisse werden vor Anzeige, Auswahl und Kopieren verborgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un fichier local pris en charge. Les secrets probables sont masqués avant l’affichage, la sélection et la copie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开支持的本地文件。可能的机密信息会在显示、选择和拷贝前隐藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するローカルファイルを開いてください。秘密情報と思われる部分は、表示、選択、コピーの前に隠されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित स्थानीय फ़ाइल खोलें। संभावित गोपनीय जानकारी दिखाने, चुनने और कॉपी करने से पहले छिपाई जाती है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelekî herêmî yê piştgirîkirî veke. Agahiyên ku dibe ku veşartî bin berî nîşandan, hilbijartin û kopîkirinê tên veşartin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте поддерживаемый локальный файл. Вероятные секреты скрываются перед отображением, выделением и копированием."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka berkas lokal yang didukung. Informasi yang diduga rahasia disembunyikan sebelum ditampilkan, dipilih, dan disalin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমর্থিত স্থানীয় ফাইল খুলুন। সম্ভাব্য গোপন তথ্য দেখানো, নির্বাচন ও কপি করার আগে লুকানো হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Buɗe fayil na cikin naʼura da ake tallafawa. Ana ɓoye bayanan da ake zaton sirri ne kafin nunawa, zaɓawa da kwafi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo local compatível. Possíveis segredos são ocultados antes da exibição, seleção e cópia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo local compatible. Los posibles secretos se ocultan antes de mostrar, seleccionar y copiar el contenido."
          }
        }
      }
    },
