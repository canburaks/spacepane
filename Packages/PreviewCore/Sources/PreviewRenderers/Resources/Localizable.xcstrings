    "format.container.folder.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Immediate-child metadata only; no recursion or source changes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca doğrudan alt öğelerin üst verileri; özyineleme veya kaynak değişikliği yoktur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Metadaten direkter Unterobjekte; keine Rekursion oder Quelländerungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées des enfants directs uniquement ; sans récursion ni modification de la source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅检查直接子项的元数据；不递归或更改源内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直下の項目のメタデータのみ。再帰処理や元の内容の変更は行いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सीधे अंदर के आइटम का मेटाडेटा; कोई पुनरावर्ती निरीक्षण या स्रोत में बदलाव नहीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenê metadaneyên zarokên rasterast; ne vegerîna kûr û ne guhertina çavkanî."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только метаданные непосредственных дочерних объектов; без рекурсии и изменения исходных файлов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya metadata item langsung di dalamnya; tanpa rekursi atau perubahan sumber."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেবল সরাসরি ভেতরের আইটেমের মেটাডেটা; কোনো পুনরাবৃত্ত পরীক্ষা বা উৎস পরিবর্তন নয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayanan abubuwan da suke ciki kai tsaye kawai; babu bin ƙananan manyan fayiloli ko canza tushe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente metadados dos itens diretamente contidos; sem recursão nem alterações na origem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo metadatos de los elementos directamente contenidos; sin recursión ni cambios en el origen."
          }
        }
      }
    },
