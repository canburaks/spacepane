    "format.archive.xz.description": {
      "comment": "Supported-behavior description for xz files. A TAR archive inside is listed, text is shown, anything else is reported as binary, and streams that need a very large dictionary are declined.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded decompression of xz streams: TAR.XZ listings and supported text. Streams that need a very large dictionary are declined."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "xz akışlarının sınırlı açılması: TAR.XZ listeleri ve desteklenen metin. Çok büyük sözlük gerektiren akışlar reddedilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Dekomprimierung von xz-Datenströmen: TAR.XZ-Listen und unterstützter Text. Datenströme mit sehr großem Wörterbuch werden abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décompression bornée des flux xz : listes TAR.XZ et texte pris en charge. Les flux exigeant un très grand dictionnaire sont refusés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对 xz 数据流进行有界解压：TAR.XZ 列表和受支持的文本。需要超大字典的数据流将被拒绝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "xz ストリームを上限付きで解凍します。TAR.XZ の一覧と対応するテキストを表示し、非常に大きな辞書を必要とするストリームは処理しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "xz स्ट्रीम का सीमित डीकंप्रेशन: TAR.XZ सूचियाँ और समर्थित पाठ। बहुत बड़े डिक्शनरी की माँग करने वाली स्ट्रीम अस्वीकार की जाती हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekirina sînorkirî ya herikên xz: lîsteyên TAR.XZ û nivîsa piştgirîkirî. Herikên ku ferhengek pir mezin dixwazin tên red kirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченная распаковка потоков xz: списки TAR.XZ и поддерживаемый текст. Потоки, требующие очень большого словаря, отклоняются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekompresi aliran xz yang dibatasi: daftar TAR.XZ dan teks yang didukung. Aliran yang membutuhkan kamus sangat besar ditolak."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "xz স্ট্রিমের সীমিত ডিকম্প্রেশন: TAR.XZ তালিকা ও সমর্থিত টেক্সট। খুব বড় অভিধান প্রয়োজন এমন স্ট্রিম প্রত্যাখ্যান করা হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Buɗe rafukan xz mai iyaka: jerin TAR.XZ da rubutun da ake goyon baya. Ana ƙin rafukan da ke buƙatar ƙamus mai girma sosai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descompressão limitada de fluxos xz: listas TAR.XZ e texto compatível. Fluxos que exigem um dicionário muito grande são recusados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descompresión acotada de flujos xz: listas TAR.XZ y texto compatible. Los flujos que requieren un diccionario muy grande se rechazan."
          }
        }
      }
    },
