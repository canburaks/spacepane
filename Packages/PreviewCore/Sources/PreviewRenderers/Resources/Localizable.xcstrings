    "preview.interaction.filter.help": {
      "comment": "Accessibility help of the outline filter field. Escape is a key name shown on keyboards; translate it as the macOS keyboard labels it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows only rows whose key or value contains the text. Press Escape to clear."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca anahtarı veya değeri bu metni içeren satırları gösterir. Temizlemek için Escape tuşuna basın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt nur Zeilen, deren Schlüssel oder Wert den Text enthält. Mit der Escape-Taste zurücksetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche uniquement les lignes dont la clé ou la valeur contient le texte. Appuyez sur Échap pour effacer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示键或值包含该文本的行。按 Esc 键清除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーまたは値にテキストを含む行のみ表示します。Esc キーで解除します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वे पंक्तियाँ दिखाता है जिनकी कुंजी या मान में यह टेक्स्ट शामिल है। साफ़ करने के लिए Escape दबाएँ।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenê rêzên ku kilît an nirxa wan ev nivîs dihewîne nîşan dide. Ji bo paqijkirinê Escape bikirtînin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает только строки, ключ или значение которых содержит текст. Нажмите Escape, чтобы очистить."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya menampilkan baris yang kunci atau nilainya memuat teks tersebut. Tekan Escape untuk menghapus."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু সেই সারিগুলো দেখায় যেগুলোর কী বা মানে এই লেখা আছে। মুছতে Escape চাপুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana nuna layukan da maɓallinsu ko darajarsu ke ɗauke da rubutun kawai. Danna Escape don gogewa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra apenas as linhas cuja chave ou valor contém o texto. Pressione Esc para limpar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra solo las filas cuya clave o valor contiene el texto. Pulsa Escape para borrar."
          }
        }
      }
    },
