    "midi.playbackHelp": {
      "comment": "App-authored label or feedback; preserve format placeholders and their argument types.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play or pause this MIDI file with the macOS sound bank."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu MIDI dosyasını macOS ses bankasıyla oynatın veya duraklatın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese MIDI-Datei mit der macOS-Klangbank wiedergeben oder pausieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire ou mettre en pause ce fichier MIDI avec la banque de sons macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 macOS 音色库播放或暂停此 MIDI 文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS のサウンドバンクで、この MIDI ファイルを再生または一時停止します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS साउंड बैंक के साथ इस MIDI फ़ाइल को चलाएँ या विराम दें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê pela MIDI bi banka dengê macOS bilîze an rawestîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизвести или приостановить MIDI-файл с помощью банка звуков macOS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar atau jeda berkas MIDI ini dengan bank suara macOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS সাউন্ড ব্যাংক দিয়ে এই MIDI ফাইল চালান বা বিরতি দিন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunna ko dakatar da wannan fayil ɗin MIDI da bankin sauti na macOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduza ou pause este arquivo MIDI com o banco de sons do macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce o pausa este archivo MIDI con el banco de sonidos de macOS."
          }
        }
      }
    },
