    "format.text.fountain.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fountain screenplay with a title page, scene headings, action, dialogue and transitions plus safe source; scenes are listed in Contents."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlık sayfası, sahne başlıkları, aksiyon, diyalog ve geçişleri olan Fountain senaryosu ile güvenli kaynak; sahneler İçindekiler’de listelenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fountain-Drehbuch mit Titelseite, Szenenüberschriften, Handlung, Dialog und Übergängen sowie sichere Quelle; Szenen stehen im Inhalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scénario Fountain avec page de titre, intertitres de scène, action, dialogues et transitions, et source sûre ; les scènes figurent dans le sommaire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fountain 剧本，包含标题页、场景标题、动作、对白和转场，并提供安全源码；场景列在目录中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルページ、シーン見出し、ト書き、台詞、トランジションを備えた Fountain 脚本と安全なソース。シーンは目次に一覧表示されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक पृष्ठ, दृश्य शीर्षक, क्रिया, संवाद और संक्रमण वाली Fountain पटकथा और सुरक्षित स्रोत; दृश्य विषय-सूची में सूचीबद्ध होते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Senaryoya Fountain bi rûpela sernavê, sernivîsên dîmenan, çalakî, diyalog û veguhêztinan û çavkaniya ewle; dîmen di naverokê de têne lîstekirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сценарий Fountain с титульной страницей, заголовками сцен, действием, диалогами и переходами и безопасный исходник; сцены перечислены в оглавлении."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenario Fountain dengan halaman judul, kepala adegan, aksi, dialog, dan transisi plus sumber aman; adegan tercantum di Daftar Isi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিরোনাম পৃষ্ঠা, দৃশ্যের শিরোনাম, ক্রিয়া, সংলাপ ও রূপান্তরসহ Fountain চিত্রনাট্য এবং নিরাপদ উৎস; দৃশ্যগুলো সূচিতে তালিকাভুক্ত হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubutun fim na Fountain mai shafin take, taken fage, aiki, tattaunawa da sauye-sauye, tare da amintaccen tushe; ana jera fage a cikin Abubuwan ciki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Roteiro Fountain com folha de rosto, cabeçalhos de cena, ação, diálogos e transições, mais código-fonte seguro; as cenas aparecem no Conteúdo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guion Fountain con portada, encabezados de escena, acción, diálogos y transiciones, más código fuente seguro; las escenas se listan en Contenido."
          }
        }
      }
    },
