    "appearance.sample.typeDisabled": {
      "extractionState": "manual",
      "comment": "Shown under the live sample when the chosen type is disabled. File Types is the name of the sidebar page; translate it as in settings.fileTypes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file type is turned off in File Types. The sample still shows how it would look."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya türü Dosya Türleri bölümünde kapalı. Örnek yine de nasıl görüneceğini gösterir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Dateityp ist unter „Dateitypen“ deaktiviert. Das Beispiel zeigt trotzdem, wie er aussehen würde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce type de fichier est désactivé dans Types de fichiers. L’exemple montre tout de même son apparence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件类型已在“文件类型”中停用。示例仍会显示其外观。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルの種類は「ファイルの種類」でオフになっています。サンプルでは表示のされ方を確認できます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल प्रकार “फ़ाइल प्रकार” में बंद है। नमूना फिर भी दिखाता है कि यह कैसा दिखेगा।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev cureyê pelê di Cureyên Pelan de girtî ye. Nimûne dîsa jî nîşan dide ka ew ê çawa xuya bibe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот тип файла отключён в разделе «Типы файлов». Образец всё равно показывает, как он будет выглядеть."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis berkas ini dinonaktifkan di Jenis Berkas. Contoh tetap menunjukkan tampilannya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলের ধরনটি “ফাইলের ধরন”-এ বন্ধ আছে। নমুনাটি তবুও দেখায় এটি কেমন দেখাবে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kashe wannan nauʼin fayil a cikin Nauʼoʼin Fayil. Samfurin har yanzu yana nuna yadda zai bayyana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tipo de arquivo está desativado em Tipos de Arquivo. A amostra ainda mostra como ele ficaria."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tipo de archivo está desactivado en Tipos de archivo. La muestra sigue mostrando cómo se vería."
          }
        }
      }
    },
