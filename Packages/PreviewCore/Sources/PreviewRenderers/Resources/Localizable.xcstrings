    "appearance.fontFallbackNotice": {
      "comment": "Font-selection limitation. Do not imply all installed families support every trait.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable fonts or traits use the closest supported font. The sample shows a notice when a fallback is needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılamayan yazı tipleri veya özellikleri için desteklenen en yakın yazı tipi kullanılır. Bir yedek gerektiğinde örnekte bildirim gösterilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verfügbare Schriften oder Schriftmerkmale werden durch die ähnlichste unterstützte Schrift ersetzt. Das Beispiel zeigt einen Hinweis, wenn eine Ersatzschrift nötig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les polices ou styles indisponibles sont remplacés par la police prise en charge la plus proche. L’exemple affiche un avis lorsqu’un remplacement est nécessaire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用的字体或样式使用最接近的受支持字体。需要替代字体时，示例会显示提示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できないフォントやスタイルには、最も近い対応フォントを使用します。代替が必要な場合はサンプルに通知が表示されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुपलब्ध फ़ॉन्ट या विशेषताओं के लिए सबसे निकट समर्थित फ़ॉन्ट उपयोग होता है। विकल्प आवश्यक होने पर नमूना सूचना दिखाता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji bo font an taybetmendiyên nekarbar fonta piştgirîkirî ya herî nêzîk tê bikaranîn. Dema pêwîstiyeke vegerê hebe, nimûne agahiyekê nîşan dide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступные шрифты или начертания заменяются ближайшим поддерживаемым вариантом. Образец показывает уведомление, когда нужна замена."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Font atau gaya yang tidak tersedia diganti dengan font yang didukung paling mendekati. Contoh menampilkan pemberitahuan saat penggantian diperlukan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুপলব্ধ ফন্ট বা বৈশিষ্ট্যের জন্য কাছাকাছি সমর্থিত ফন্ট ব্যবহার করা হয়। বিকল্প দরকার হলে নমুনায় বিজ্ঞপ্তি দেখা যায়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Idan nauʼin rubutu ko halayensa ba su samuwa, ana amfani da mafi kusa da ake tallafawa. Samfurin yana nuna sanarwa idan an yi hakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fontes ou estilos indisponíveis usam a opção compatível mais próxima. A amostra mostra um aviso quando uma substituição é necessária."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes o estilos no disponibles usan la opción compatible más cercana. La muestra avisa cuando se necesita una sustitución."
          }
        }
      }
    },
