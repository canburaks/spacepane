    "preview.diagram.noticeReadable": {
      "comment": "Quiet note under a diagram that is too large to be shown whole with readable text. Formatted key, no count and no plural: %1$@ is the scale the diagram is drawn at, already formatted as a percentage for the display locale (for example 63%). The diagram is drawn at the smallest size that keeps its labels readable instead of shrinking further, and the reader moves to the rest by scrolling or dragging. Keep %1$@ exactly once. Two short sentences. All translations are drafts pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawn at %1$@ to stay readable. Scroll or drag for the rest."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunabilir kalması için %1$@ ölçeğinde çizildi. Gerisi için kaydırın veya sürükleyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %1$@ gezeichnet, damit es lesbar bleibt. Scrollen oder ziehen zeigt den Rest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiné à %1$@ pour rester lisible. Faites défiler ou glissez pour voir la suite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为保持可读，以 %1$@ 绘制。滚动或拖动可查看其余部分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みやすさを保つため %1$@ で描画しています。残りはスクロールまたはドラッグで表示します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ने योग्य रहे, इसलिए %1$@ पर बनाया गया है। बाकी देखने के लिए स्क्रॉल करें या खींचें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji bo ku bixwendin bimîne, li ser %1$@ hat xêzkirin. Ji bo yên mayî bigerînin an bikişînin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштаб %1$@ для читаемости. Прокрутите или перетащите, чтобы увидеть остальное."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digambar pada %1$@ agar tetap terbaca. Gulir atau seret untuk melihat sisanya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পড়ার উপযোগী রাখতে %1$@ মাপে আঁকা হয়েছে। বাকিটা দেখতে স্ক্রল বা টেনে সরান।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An zana shi a %1$@ domin ya kasance mai karantuwa. Gungura ko ja domin ganin sauran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhado a %1$@ para continuar legível. Role ou arraste para ver o resto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibujado al %1$@ para que siga siendo legible. Desplázate o arrastra para ver el resto."
          }
        }
      }
    },
