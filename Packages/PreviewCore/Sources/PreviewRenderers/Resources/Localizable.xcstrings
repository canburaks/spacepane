    "format.text.diff.description": {
      "comment": "Unified Diff is the technical patch/diff text format. This preview is read-only; no changes from a patch are applied.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only unified differences with additions and deletions highlighted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklemeleri ve silmeleri vurgulanan salt okunur birleşik farklar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützte Unified-Diff-Ansicht mit hervorgehobenen Ergänzungen und Löschungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Différences unifiées en lecture seule avec ajouts et suppressions mis en évidence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读统一差异，高亮显示添加项和删除项。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加と削除を強調表示した、読み取り専用の統一形式の差分。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ और हटाए गए भाग हाइलाइट करके केवल पढ़ने के एकीकृत अंतर।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cudahiyên yekbûyî yên tenê-xwendinê bi zêdekirin û jêbirinên rengkirî."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Унифицированные различия только для чтения с подсветкой добавлений и удалений."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbedaan terpadu hanya baca dengan penambahan dan penghapusan disorot."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোজন ও অপসারণ হাইলাইট করা শুধু পড়ার একীভূত পার্থক্য।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambance-bambance don karantawa kawai, da nuna abubuwan da aka ƙara ko goge."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferenças unificadas somente para leitura, com adições e remoções realçadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferencias unificadas de solo lectura con adiciones y eliminaciones resaltadas."
          }
        }
      }
    },
    "format.text.diff.name": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
