    "finding.bundle.runsProgram": {
      "comment": "Informational finding for an MCP bundle (.mcpb): the bundle contains a server that an AI app such as Claude starts as a program on this Mac. Every such bundle does this; it is not a warning. MCP is a technical name and stays as it is. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs a program on this Mac when an AI app starts its server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yapay zekâ uygulaması sunucusunu başlattığında bu Mac’te bir program çalıştırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt ein Programm auf diesem Mac aus, wenn eine KI-App den Server startet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute un programme sur ce Mac quand une app IA démarre son serveur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 AI 应用启动其服务器时，会在这台 Mac 上运行一个程序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI アプリがサーバを起動すると、この Mac 上でプログラムを実行します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई AI ऐप इसका सर्वर शुरू करता है, तो यह इस Mac पर एक प्रोग्राम चलाता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gava sepanek AI serverê wê çalak dike, li ser vê Mac’ê bernameyekê dixebitîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает программу на этом Mac, когда ИИ-приложение запускает свой сервер."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjalankan program di Mac ini saat aplikasi AI memulai servernya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো AI অ্যাপ এর সার্ভার চালু করলে এই Mac-এ একটি প্রোগ্রাম চালায়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana gudanar da shiri a wannan Mac idan manhajar AI ta fara server ɗinsa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa um programa neste Mac quando um app de IA inicia o servidor dele."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un programa en este Mac cuando una app de IA inicia su servidor."
          }
        }
      }
    },
