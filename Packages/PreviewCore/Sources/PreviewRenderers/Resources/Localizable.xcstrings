    "profile.status.concealed": {
      "comment": "Status line above the profile when at least one column holds concealed likely secrets. Such a column is not analyzed; only its count of empty cells is shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Columns with concealed values show only how many cells are empty."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlenmiş değerler içeren sütunlarda yalnızca kaç hücrenin boş olduğu gösterilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Spalten mit verborgenen Werten wird nur angezeigt, wie viele Zellen leer sind."
