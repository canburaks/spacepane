    "format.config.package-json.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project metadata and safe source; package scripts are never executed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje üst verileri ve güvenli kaynak; paket betikleri asla çalıştırılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektmetadaten und sichere Quelle; Paketskripte werden nie ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées du projet et source sécurisée ; les scripts du paquet ne sont jamais exécutés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目元数据和安全源码；从不执行软件包脚本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトのメタデータと安全なソース。パッケージのスクリプトは実行しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट मेटाडेटा और सुरक्षित स्रोत; पैकेज स्क्रिप्ट कभी निष्पादित नहीं होतीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaneyên projeyê û çavkaniya ewle; skrîptên pakêtê tu carî nayên xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданные проекта и безопасный исходный текст; скрипты пакета никогда не выполняются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata proyek dan sumber aman; skrip paket tidak pernah dijalankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রকল্পের মেটাডেটা ও নিরাপদ উৎস; প্যাকেজ স্ক্রিপ্ট কখনো চালানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayanan aikin da tushe mai aminci; ba a aiwatar da rubutun umarnin kunshi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadados do projeto e origem segura; scripts de pacotes nunca são executados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatos del proyecto y código fuente seguro; nunca se ejecutan scripts de paquetes."
          }
        }
      }
    },
