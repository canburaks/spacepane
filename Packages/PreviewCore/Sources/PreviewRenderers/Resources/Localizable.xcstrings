            "state": "translated",
            "value": "Le programme démarre à l’ouverture de session ou au démarrage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该程序会在登录时或启动时运行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムはログイン時または起動時に開始されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोग्राम लॉगिन पर या स्टार्टअप पर शुरू होता है।"
