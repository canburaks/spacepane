      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded outlines and safe XML source; feeds are not fetched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı ana hatlar ve güvenli XML kaynağı; beslemeler alınmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Gliederungen und sichere XML-Quelle; Feeds werden nicht abgerufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arborescences limitées et source XML sécurisée ; les flux ne sont pas récupérés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限度的大纲和安全 XML 源码；不获取订阅源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限付きアウトラインと安全な XML ソース。フィードは取得しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित रूपरेखा और सुरक्षित XML स्रोत; फ़ीड प्राप्त नहीं की जातीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
