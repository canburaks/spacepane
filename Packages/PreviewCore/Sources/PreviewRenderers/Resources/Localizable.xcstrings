            "value": "Pêşdîtin"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রিভিউ"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubawa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualizações"
          }
