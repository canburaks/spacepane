    "cad.importerUnavailable": {
      "comment": "CAD importer failure may mean a busy service, interrupted connection, missing component or packaging problem. Suggest retrying or checking the installation; do not require reinstallation. Translation draft pending native-speaker and host review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CAD importer is unavailable. Try again or check the app installation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD içe aktarıcısı kullanılamıyor. Yeniden deneyin veya uygulama kurulumunu kontrol edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CAD-Importer ist nicht verfügbar. Versuchen Sie es erneut oder prüfen Sie die App-Installation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importateur CAD est indisponible. Réessayez ou vérifiez l’installation de l’application."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD 导入器不可用。请重试或检查应用安装。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CADインポーターを利用できません。もう一度試すか、アプリのインストール状態を確認してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD आयातक उपलब्ध नहीं है। फिर से कोशिश करें या ऐप का इंस्टॉलेशन जाँचें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Anîna CAD tune ye. Dîsa biceribîne an sazkirina sepanê kontrol bike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортёр CAD недоступен. Повторите попытку или проверьте установку приложения."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengimpor CAD tidak tersedia. Coba lagi atau periksa instalasi aplikasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD আমদানিকারক উপলভ্য নয়। আবার চেষ্টা করুন বা অ্যাপের ইনস্টলেশন পরীক্ষা করুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a samun mai shigo da CAD. Sake gwadawa ko duba shigar da manhajar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O importador CAD está indisponível. Tente novamente ou verifique a instalação do aplicativo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importador CAD no está disponible. Vuelve a intentarlo o comprueba la instalación de la app."
          }
        }
      }
    },
    "cad.interactionHelp": {
      "comment": "Native CAD navigation help. Keep F, R, 1/2/3, +/− shortcuts unchanged; translate descriptions. Shift is the keyboard modifier.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to orbit. Shift-drag or right-drag to pan. Scroll to zoom. Arrow keys orbit; Shift-arrow keys pan; +/− zoom; F fits; R resets; 1/2/3 select front/side/top."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döndürmek için sürükleyin. Kaydırmak için Shift ile veya sağ tuşla sürükleyin. Yakınlaştırmak için kaydırın. Ok tuşları döndürür; Shift-ok tuşları kaydırır; +/− yakınlaştırır; F sığdırır; R sıfırlar; 1/2/3 ön/yan/üst görünümü seçer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Drehen ziehen. Zum Verschieben mit Umschalttaste oder rechter Maustaste ziehen. Zum Zoomen scrollen. Pfeiltasten drehen; Umschalt-Pfeiltasten verschieben; +/− zoomt; F passt ein; R setzt zurück; 1/2/3 wählt vorne/Seite/oben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour pivoter. Faites glisser avec Maj ou le bouton droit pour déplacer. Faites défiler pour zoomer. Les flèches font pivoter ; Maj-flèches déplacent ; +/− zoome ; F ajuste ; R réinitialise ; 1/2/3 sélectionne face/côté/dessus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以旋转。按住 Shift 拖动或用右键拖动以平移。滚动以缩放。方向键旋转；Shift 加方向键平移；+/− 缩放；F 适应模型；R 重置；1/2/3 选择正面/侧面/顶面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで回転。Shiftを押しながらドラッグ、または右ドラッグで移動。スクロールでズーム。矢印キーで回転、Shift＋矢印キーで移動、+/−でズーム、Fで全体表示、Rでリセット、1/2/3で正面/側面/上面を選択します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घुमाने के लिए खींचें। खिसकाने के लिए Shift दबाकर या दायाँ बटन दबाकर खींचें। ज़ूम के लिए स्क्रॉल करें। तीर कुंजियाँ घुमाती हैं; Shift-तीर खिसकाते हैं; +/− ज़ूम करते हैं; F फ़िट करता है; R रीसेट करता है; 1/2/3 सामने/पार्श्व/ऊपर चुनते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji bo zivirandinê bikişîne. Ji bo guheztinê bi Shift an bi bişkoja rastê bikişîne. Ji bo nêzîkkirinê bilivîne. Bişkojên tîran dizivirînin; Shift-tîr diguhezînin; +/− nêzîk/dûr dikin; F bicih dike; R nû dike; 1/2/3 pêş/kêle/jor hildibijêrin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте для вращения. Перетаскивайте с Shift или правой кнопкой для перемещения. Прокручивайте для масштаба. Стрелки вращают; Shift-стрелки перемещают; +/− меняет масштаб; F вписывает; R сбрасывает; 1/2/3 выбирает вид спереди/сбоку/сверху."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk memutar. Seret dengan Shift atau tombol kanan untuk menggeser. Gulir untuk memperbesar. Tombol panah memutar; Shift-panah menggeser; +/− mengubah zoom; F menyesuaikan; R mengatur ulang; 1/2/3 memilih depan/samping/atas."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘোরাতে টেনে আনুন। সরাতে Shift চেপে বা ডান বোতাম দিয়ে টানুন। জুম করতে স্ক্রল করুন। তীরচিহ্নের কী ঘোরায়; Shift-তীর সরায়; +/− জুম করে; F মানানসই করে; R রিসেট করে; 1/2/3 সামনে/পাশে/উপরে বেছে নেয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja don juyawa. Ja da Shift ko maɓallin dama don matsawa. Gungura don kusantarwa. Maɓallan kibiya suna juyawa; Shift-kibiya suna matsawa; +/− suna kusantarwa/nisantarwa; F yana daidaitawa; R yana sake saitawa; 1/2/3 suna zaɓar gaba/gefe/sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para girar. Arraste com Shift ou o botão direito para mover. Role para ampliar. As setas giram; Shift-setas movem; +/− altera o zoom; F ajusta; R redefine; 1/2/3 seleciona frente/lado/topo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para girar. Arrastra con Mayús o el botón derecho para desplazar. Desplázate para ampliar. Las flechas giran; Mayús-flechas desplazan; +/− cambia el zoom; F ajusta; R restablece; 1/2/3 selecciona frente/lateral/superior."
          }
        }
      }
    },
    "cad.invalidGeometry": {
      "comment": "CAD preview user interface. Translation draft; requires native-speaker and host review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model could not be displayed safely."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model güvenli biçimde gösterilemedi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell konnte nicht sicher angezeigt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle n’a pas pu être affiché de manière sûre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全显示此模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルを安全に表示できませんでした。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मॉडल को सुरक्षित रूप से प्रदर्शित नहीं किया जा सका।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev model bi awayekî ewle nehat nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось безопасно показать эту модель."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini tidak dapat ditampilkan dengan aman."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মডেলটি নিরাপদে দেখানো যায়নি।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya nuna wannan samfurin cikin aminci ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível exibir este modelo com segurança."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido mostrar este modelo de forma segura."
          }
        }
      }
    },
    "cad.measurements.open": {
      "comment": "Variant of the CAD measurements line used when the surface mesh is not a closed, watertight shell, so no volume can be computed. Argument 1 is the already locale-formatted surface area in square millimetres, argument 2 the number of separate bodies (Int64). Say that the volume is unavailable because the surface is not closed; never claim the model is invalid or broken. Keep the positional placeholders and the unit symbol mm². Do not add singular or plural forms. Approximate values computed from the displayed tessellated surface, not certified engineering measurements.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface area: %1$@ mm² · Volume unavailable (surface not closed) · Bodies: %2$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzey alanı: %1$@ mm² · Hacim kullanılamıyor (yüzey kapalı değil) · Gövdeler: %2$lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberfläche: %1$@ mm² · Volumen nicht verfügbar (Oberfläche nicht geschlossen) · Körper: %2$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aire de la surface : %1$@ mm² · Volume indisponible (surface non fermée) · Corps : %2$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表面积：%1$@ mm² · 体积不可用（表面未闭合） · 实体：%2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表面積：%1$@ mm² · 体積は利用できません（表面が閉じていません） · ボディ数：%2$lld"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सतह क्षेत्रफल: %1$@ mm² · आयतन उपलब्ध नहीं (सतह बंद नहीं है) · पिंड: %2$lld"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Qada rûerdê: %1$@ mm² · Qebare berdest nîne (rûerd ne girtî ye) · Cism: %2$lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Площадь поверхности: %1$@ mm² · Объём недоступен (поверхность не замкнута) · Тела: %2$lld"
          }
        },
        "id": {
