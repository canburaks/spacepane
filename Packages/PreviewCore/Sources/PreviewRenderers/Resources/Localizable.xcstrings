    "preview.interaction.goToLine.help": {
      "comment": "Accessibility help of the Go to Line field. Return and Escape are key names shown on keyboards; translate them as the macOS keyboard labels them.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a line number and press Return to jump to it. Press Escape to close."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir satır numarası yazıp gitmek için Return tuşuna basın. Kapatmak için Escape tuşuna basın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilennummer eingeben und mit der Eingabetaste springen. Mit der Escape-Taste schließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un numéro de ligne et appuyez sur Retour pour y aller. Appuyez sur Échap pour fermer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入行号并按回车键跳转，按 Esc 键关闭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行番号を入力して Return キーを押すと移動します。閉じるには Esc キーを押します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंक्ति संख्या लिखें और वहाँ जाने के लिए Return दबाएँ। बंद करने के लिए Escape दबाएँ।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejmara rêzekê binivîsin û ji bo çûnê Return bikirtînin. Ji bo girtinê Escape bikirtînin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите номер строки и нажмите Return, чтобы перейти. Нажмите Escape, чтобы закрыть."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik nomor baris lalu tekan Return untuk menuju ke sana. Tekan Escape untuk menutup."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি লাইন নম্বর লিখে সেখানে যেতে Return চাপুন। বন্ধ করতে Escape চাপুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubuta lambar layi sannan ka danna Return don tafiya zuwa gare ta. Danna Escape don rufewa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um número de linha e pressione Return para ir até ela. Pressione Esc para fechar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un número de línea y pulsa Retorno para ir a ella. Pulsa Escape para cerrar."
          }
        }
      }
    },
    "preview.interaction.goToLine.invalid": {
      "comment": "Error shown when the typed text is not a valid line number. The placeholder is the Int64 number of the last line; the first line is always 1. Phrase it so no plural form is needed.",
