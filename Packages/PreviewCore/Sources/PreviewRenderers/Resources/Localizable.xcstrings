    "format.model.ply.description": {
      "comment": "One-sentence description of the PLY preview shown under the file-type switch. 'Polygon meshes' are surfaces made of many-sided faces; ASCII and binary are the two PLY encodings. The second sentence says what the preview does not show.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local 3D preview of ASCII and binary polygon meshes. Colors, textures and extra properties are not shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ASCII ve ikili çokgen ağların yerel 3B önizlemesi. Renkler, dokular ve ek özellikler gösterilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale 3D-Vorschau von ASCII- und Binär-Polygonnetzen. Farben, Texturen und zusätzliche Eigenschaften werden nicht angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu 3D local de maillages polygonaux ASCII et binaires. Les couleurs, les textures et les propriétés supplémentaires ne sont pas affichées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ASCII 和二进制多边形网格的本地 3D 预览。不显示颜色、纹理和额外属性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ASCIIおよびバイナリのポリゴンメッシュのローカル3Dプレビュー。色、テクスチャ、追加プロパティは表示されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ASCII और बाइनरी बहुभुज जालों का स्थानीय 3D पूर्वावलोकन। रंग, टेक्सचर और अतिरिक्त गुण नहीं दिखाए जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtina 3D ya herêmî ji bo tevnên pirgoşe yên ASCII û binary. Reng, tekstûr û taybetmendiyên zêde nayên nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный 3D-просмотр полигональных сеток ASCII и двоичных. Цвета, текстуры и дополнительные свойства не показываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau 3D lokal untuk jaring poligon ASCII dan biner. Warna, tekstur, dan properti tambahan tidak ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ASCII ও বাইনারি বহুভুজ জালের স্থানীয় 3D প্রিভিউ। রং, টেক্সচার ও অতিরিক্ত বৈশিষ্ট্য দেখানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duban 3D na cikin naʼura na ragar kusurwoyi masu yawa na ASCII da binary. Ba a nuna launuka, tsarin saman da ƙarin siffofi ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia 3D local de malhas poligonais ASCII e binárias. Cores, texturas e propriedades extras não são exibidas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa 3D local de mallas poligonales ASCII y binarias. No se muestran colores, texturas ni propiedades adicionales."
          }
        }
      }
    },
