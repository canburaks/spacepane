    "format.data.torrent.description": {
      "comment": "One-sentence description of the data.torrent file type; states what is and is not shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files, sizes and info-hashes. Tracker paths and private keys are never shown, and nothing is downloaded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar, boyutlar ve bilgi karmaları. İzleyici yolları ve özel anahtarlar hiçbir zaman gösterilmez ve hiçbir şey indirilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, Größen und Info-Hashes. Tracker-Pfade und private Schlüssel werden nie angezeigt, und nichts wird heruntergeladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers, tailles et info-hashes. Les chemins des trackers et les clés privées ne sont jamais affichés et rien n’est téléchargé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件、大小和信息哈希。从不显示 Tracker 路径和私有密钥，也不下载任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル、サイズ、インフォハッシュ。トラッカーのパスや秘密鍵は表示せず、何もダウンロードしません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें, आकार और इन्फ़ो हैश। ट्रैकर पथ और निजी कुंजियाँ कभी नहीं दिखाई जातीं और कुछ भी डाउनलोड नहीं होता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pel, mezinahî û info hash. Rêyên tracker û mifteyên taybet tu carî nayên nîşandan û tiştek nayê daxistin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы, размеры и инфо-хеши. Пути трекеров и закрытые ключи никогда не показываются, ничего не загружается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas, ukuran, dan info hash. Jalur tracker dan kunci privat tidak pernah ditampilkan, dan tidak ada yang diunduh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল, আকার ও ইনফো হ্যাশ। ট্র্যাকারের পাথ ও ব্যক্তিগত কী কখনও দেখানো হয় না এবং কিছুই ডাউনলোড করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayiloli, girma da info hash. Ba a taɓa nuna hanyoyin tracker da maɓallan sirri ba, kuma ba a sauke komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos, tamanhos e info hashes. Caminhos de trackers e chaves privadas nunca são exibidos e nada é baixado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos, tamaños e info hashes. Las rutas de los trackers y las claves privadas nunca se muestran y no se descarga nada."
          }
        }
      }
    },
