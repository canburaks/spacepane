    "format.data.tsv.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded tab-separated tables and safe source; formulas are never evaluated."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı sekmeyle ayrılmış tablolar ve güvenli kaynak; formüller asla hesaplanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte tabulatorgetrennte Tabellen und sichere Quelle; Formeln werden nie ausgewertet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tableaux limités à valeurs séparées par des tabulations et source sécurisée ; les formules ne sont jamais évaluées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限度的制表符分隔表格和安全源码；从不计算公式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限付きのタブ区切り表と安全なソース。数式は評価されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित टैब-पृथक तालिकाएँ और सुरक्षित स्रोत; सूत्रों का कभी मूल्यांकन नहीं किया जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabloyên sînordar ên bi tabê veqetandî û çavkaniya ewle; formul qet nayên hesabkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблицы с разделителями-табуляциями с ограничениями и безопасный исходный текст; формулы никогда не вычисляются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabel nilai dipisahkan tab yang berbatas dan sumber aman; rumus tidak pernah dievaluasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমিত ট্যাব-বিভক্ত সারণি ও নিরাপদ উৎস; সূত্র কখনো মূল্যায়ন করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Teburan ƙimomi da tab ya raba masu iyaka da tushe mai aminci; ba a taɓa lissafa dabaru ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabelas limitadas separadas por tabulações e fonte segura; fórmulas nunca são avaliadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablas limitadas separadas por tabulaciones y fuente segura; las fórmulas nunca se evalúan."
          }
        }
      }
    },
