    "format.text.ttml.description": {
      "comment": "Description of the TTML and DFXP subtitle type.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed TTML and DFXP paragraphs as cues; styles, regions and layout are not applied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlı TTML ve DFXP paragrafları altyazı satırları olarak; stiller, bölgeler ve yerleşim uygulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitgesteuerte TTML- und DFXP-Absätze als Untertitel; Stile, Regionen und Layout werden nicht angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paragraphes TTML et DFXP minutés sous forme de répliques ; styles, régions et mise en page ne sont pas appliqués."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带时间的 TTML 和 DFXP 段落，显示为字幕条目；不应用样式、区域和布局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング付きの TTML/DFXP の段落をキューとして表示します。スタイル、リージョン、レイアウトは適用されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समयबद्ध TTML और DFXP अनुच्छेद उपशीर्षक प्रविष्टियों के रूप में; शैलियाँ, क्षेत्र और लेआउट लागू नहीं किए जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Paragrafên TTML û DFXP yên bi dem wekî binnivîs; şêwaz, herêm û sêwirandin nayên sepandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизированные абзацы TTML и DFXP как реплики; стили, области и разметка не применяются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paragraf TTML dan DFXP berwaktu sebagai subtitel; gaya, wilayah, dan tata letak tidak diterapkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়যুক্ত TTML ও DFXP অনুচ্ছেদ সাবটাইটেল অংশ হিসেবে; শৈলী, অঞ্চল ও লেআউট প্রয়োগ করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin layi na TTML da DFXP masu lokaci a matsayin rubutun ƙasa; ba a amfani da salo, yankuna da tsarin shimfiɗa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parágrafos TTML e DFXP temporizados como legendas; estilos, regiões e layout não são aplicados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párrafos TTML y DFXP con tiempos como subtítulos; no se aplican estilos, regiones ni diseño."
          }
        }
      }
    },
