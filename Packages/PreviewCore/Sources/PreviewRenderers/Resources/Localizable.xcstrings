    "format.data.arrow.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded Arrow IPC file and stream inspection: schema and batch structure; Feather v1 is not supported."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı Arrow IPC dosya ve akış incelemesi: şema ve toplu iş yapısı; Feather v1 desteklenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Prüfung von Arrow-IPC-Dateien und -Streams: Schema und Batch-Struktur; Feather v1 wird nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspection bornée des fichiers et flux Arrow IPC : schéma et structure des lots ; Feather v1 n’est pas pris en charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对 Arrow IPC 文件和流进行有限检查：架构和批次结构；不支持 Feather v1。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrow IPC ファイルとストリームの制限付き確認：スキーマとバッチ構造。Feather v1 には対応しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित Arrow IPC फ़ाइल और स्ट्रीम निरीक्षण: स्कीमा और बैच संरचना; Feather v1 समर्थित नहीं है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Venêrîna sînorkirî ya pelên û herikên Arrow IPC: schema û avahiya beşan; Feather v1 nayê piştgirî kirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченный просмотр файлов и потоков Arrow IPC: схема и структура пакетов; Feather v1 не поддерживается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan berkas dan aliran Arrow IPC terbatas: skema dan struktur batch; Feather v1 tidak didukung."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমিত Arrow IPC ফাইল ও স্ট্রিম পরিদর্শন: স্কিমা ও ব্যাচ কাঠামো; Feather v1 সমর্থিত নয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Binciken fayil da kwararar Arrow IPC mai iyaka: tsari da tsarin rukunai; ba a goyi bayan Feather v1 ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspeção limitada de arquivos e fluxos Arrow IPC: esquema e estrutura dos lotes; Feather v1 não é compatível."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspección acotada de archivos y flujos Arrow IPC: esquema y estructura de lotes; Feather v1 no es compatible."
          }
        }
      }
    },
