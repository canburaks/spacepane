        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji bo nîşandana vê sernivîsê di belgeyê de Return bitepîne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
