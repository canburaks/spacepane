    "help.keyboard.body": {
      "comment": "Explanation in the Help section of the About page. Command-1 to Command-4 switch between the four pages (General, File Types, Theme, About); Command-comma opens General (use the translated name of the General page as it appears in the sidebar); Command-Z and Shift-Command-Z undo and redo the last reset, bulk change, theme import or profile deletion. Keep the keyboard symbols as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 to ⌘4 switch pages. ⌘, opens General. ⌘Z undoes the last reset, bulk change, theme import or profile deletion; ⇧⌘Z redoes it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 – ⌘4 sayfalar arasında geçiş yapar. ⌘, Genel sayfasını açar. ⌘Z son sıfırlamayı, toplu değişikliği, tema içe aktarmayı veya profil silmeyi geri alır; ⇧⌘Z yeniden uygular."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 bis ⌘4 wechseln die Seiten. ⌘, öffnet „Allgemein“. ⌘Z macht das letzte Zurücksetzen, die letzte Sammeländerung, den letzten Designimport oder das Löschen eines Profils rückgängig; ⇧⌘Z stellt es wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 à ⌘4 changent de page. ⌘, ouvre Général. ⌘Z annule la dernière réinitialisation, modification groupée, importation de thème ou suppression de profil ; ⇧⌘Z la rétablit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 至 ⌘4 切换页面。⌘, 打开“通用”。⌘Z 撤销最近一次重置、批量更改、主题导入或方案删除；⇧⌘Z 重做。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1〜⌘4 でページを切り替えます。⌘, で「一般」を開きます。⌘Z で直前のリセット、一括変更、テーマの読み込み、プロファイルの削除を取り消し、⇧⌘Z でやり直します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 से ⌘4 पृष्ठ बदलते हैं। ⌘, “सामान्य” खोलता है। ⌘Z पिछले रीसेट, सामूहिक बदलाव, थीम आयात या प्रोफ़ाइल हटाने को पूर्ववत करता है; ⇧⌘Z उसे फिर से करता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 heta ⌘4 di navbera rûpelan de diguherin. ⌘, “Giştî” vedike. ⌘Z vegerandina dawî, guhertina komî, têxistina temayê an jêbirina profîlê betal dike; ⇧⌘Z dîsa dike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1–⌘4 переключают страницы. ⌘, открывает «Основные». ⌘Z отменяет последний сброс, массовое изменение, импорт темы или удаление профиля; ⇧⌘Z возвращает отменённое."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 hingga ⌘4 berpindah antarhalaman. ⌘, membuka Umum. ⌘Z membatalkan pengaturan ulang, perubahan massal, impor tema, atau penghapusan profil terakhir; ⇧⌘Z mengulanginya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 থেকে ⌘4 পৃষ্ঠা বদলায়। ⌘, “সাধারণ” খোলে। ⌘Z শেষ রিসেট, গণ-পরিবর্তন, থিম আমদানি বা প্রোফাইল মোছা পূর্বাবস্থায় ফেরায়; ⇧⌘Z আবার করে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 zuwa ⌘4 suna sauya shafuka. ⌘, yana buɗe “Gaba ɗaya”. ⌘Z yana soke mayarwa ta ƙarshe, canji na gama gari, shigo da jigo ko goge salo; ⇧⌘Z yana sake yinsa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 a ⌘4 alternam entre as páginas. ⌘, abre Geral. ⌘Z desfaz a última redefinição, alteração em massa, importação de tema ou exclusão de perfil; ⇧⌘Z refaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1 a ⌘4 cambian de página. ⌘, abre General. ⌘Z deshace el último restablecimiento, cambio masivo, importación de tema o eliminación de perfil; ⇧⌘Z lo rehace."
          }
        }
      }
    },
