    "format.package.installer.description": {
      "comment": "One-sentence description of the package.installer file type; states what is and is not shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contents, identifiers, versions and script names. Scripts and payloads are never read."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik, tanımlayıcılar, sürümler ve betik adları. Betikler ve yükler hiçbir zaman okunmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalt, Kennungen, Versionen und Skriptnamen. Skripte und Payloads werden nie gelesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu, identifiants, versions et noms des scripts. Les scripts et les payloads ne sont jamais lus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容、标识符、版本和脚本名称。从不读取脚本和载荷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容、識別子、バージョン、スクリプト名。スクリプトとペイロードは読み取りません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामग्री, पहचानकर्ता, संस्करण और स्क्रिप्ट के नाम। स्क्रिप्ट और पेलोड कभी नहीं पढ़े जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Naverok, nasname, guherto û navên skrîptan. Skrîpt û payload tu carî nayên xwendin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое, идентификаторы, версии и имена скриптов. Скрипты и данные пакетов никогда не читаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi, pengenal, versi, dan nama skrip. Skrip dan payload tidak pernah dibaca."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়বস্তু, শনাক্তকারী, সংস্করণ ও স্ক্রিপ্টের নাম। স্ক্রিপ্ট ও পেলোড কখনও পড়া হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Abun ciki, masu gano, sigogi da sunayen rubutun. Ba a taɓa karanta rubutun da payload ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
