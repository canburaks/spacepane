    "format.text.latex.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline LaTeX structure with approximated math and safe source; nothing is compiled and referenced files are never opened."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık gösterilen matematikle çevrimdışı LaTeX yapısı ve güvenli kaynak; hiçbir şey derlenmez, başvurulan dosyalar asla açılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline dargestellte LaTeX-Struktur mit angenäherter Mathematik und sicherer Quelle; nichts wird kompiliert, referenzierte Dateien werden nie geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Structure LaTeX hors ligne avec mathématiques approximées et source sûre ; rien n’est compilé et les fichiers référencés ne sont jamais ouverts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线显示的 LaTeX 结构，数学公式为近似显示，并提供安全源码；不会编译，也不会打开引用的文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインで表示する LaTeX の構造（数式は近似表示）と安全なソース。コンパイルは行わず、参照先ファイルも開きません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमानित गणित और सुरक्षित स्रोत के साथ ऑफ़लाइन LaTeX संरचना; कुछ भी कंपाइल नहीं होता और संदर्भित फ़ाइलें कभी नहीं खोली जातीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Avahiya LaTeX a negirêdayî bi matematîka nêzîk û çavkaniya ewle; tiştek nayê kompîlekirin û pelên referanskirî tu car nayên vekirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Структура LaTeX без сети с приближённой математикой и безопасным исходником; ничего не компилируется, указанные файлы не открываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Struktur LaTeX luring dengan matematika perkiraan dan sumber aman; tidak ada yang dikompilasi dan berkas yang dirujuk tidak pernah dibuka."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনুমানিক গণিতসহ অফলাইন LaTeX কাঠামো ও নিরাপদ উৎস; কিছুই কম্পাইল হয় না এবং উল্লেখিত ফাইল কখনো খোলা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsarin LaTeX ba tare da intanet ba tare da lissafi na kusa-kusa da amintaccen tushe; ba a haɗa komai ba kuma ba a taɓa buɗe fayilolin da aka ambata ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrutura LaTeX offline com matemática aproximada e código-fonte seguro; nada é compilado e arquivos referenciados nunca são abertos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estructura LaTeX sin conexión con matemáticas aproximadas y código fuente seguro; no se compila nada y nunca se abren los archivos referenciados."
          }
        }
      }
    },
