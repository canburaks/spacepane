    "format.data.drawio.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First page drawn natively from plain or compressed files, plus safe XML source; no links, images or scripts are used."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk sayfa, düz veya sıkıştırılmış dosyalardan yerel olarak çizilir; güvenli XML kaynağı da gösterilir; bağlantı, görsel veya betik kullanılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Seite wird aus einfachen oder komprimierten Dateien nativ gezeichnet, dazu sichere XML-Quelle; keine Links, Bilder oder Skripte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première page est dessinée nativement depuis des fichiers simples ou compressés, avec la source XML sûre ; aucun lien, image ni script."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从普通或压缩文件中原生绘制第一页，并提供安全 XML 源码；不使用链接、图像或脚本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常または圧縮ファイルの最初のページをネイティブに描画し、安全な XML ソースも表示します。リンク、画像、スクリプトは使いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य या संपीड़ित फ़ाइलों का पहला पृष्ठ मूल रूप से बनाया जाता है, साथ में सुरक्षित XML स्रोत; लिंक, चित्र या स्क्रिप्ट का उपयोग नहीं होता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rûpela yekem ji pelên asayî an pêçayî bi awayekî xwerû tê xêzkirin, bi çavkaniya XML a ewle re; ti girêdan, wêne an skrîpt nayên bikaranîn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая страница рисуется нативно из обычных или сжатых файлов, плюс безопасный XML; ссылки, изображения и сценарии не используются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman pertama digambar secara native dari berkas biasa atau terkompresi, beserta sumber XML aman; tidak ada tautan, gambar, atau skrip yang digunakan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাধারণ বা সংকুচিত ফাইল থেকে প্রথম পৃষ্ঠা নেটিভভাবে আঁকা হয়, সাথে নিরাপদ XML সোর্স; কোনো লিঙ্ক, ছবি বা স্ক্রিপ্ট ব্যবহার করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana zana shafi na farko kai tsaye daga fayilolin da aka matse ko waɗanda ba a matse ba, tare da amintaccen tushen XML; ba a amfani da hanyoyin haɗi, hotuna ko rubutun shirye-shirye."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira página é desenhada nativamente a partir de arquivos simples ou compactados, além da origem XML segura; não são usados links, imagens nem scripts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera página se dibuja de forma nativa desde archivos simples o comprimidos, más el origen XML seguro; no se usan enlaces, imágenes ni scripts."
          }
        }
      }
    },
