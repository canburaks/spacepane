    "general.limits.fileSizeHint": {
      "comment": "Explains what happens above the size limit: text, source code, log, CSV/TSV, INI and caption files show their leading part; other formats show an explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Larger files show their first part when the format allows it, otherwise an explanation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha büyük dosyalarda biçim izin veriyorsa ilk bölüm, aksi halde bir açıklama gösterilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere Dateien zeigen ihren ersten Teil, wenn das Format es zulässt, sonst eine Erklärung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers plus volumineux affichent leur première partie si le format le permet, sinon une explication."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更大的文件会在格式允许时显示开头部分，否则显示说明。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これより大きいファイルは、形式が対応している場合は最初の部分、そうでない場合は説明が表示されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़ी फ़ाइलों में, प्रारूप अनुमति दे तो शुरुआती हिस्सा दिखता है, नहीं तो स्पष्टीकरण दिखता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelên mezintir, heke format destûr bide, beşa xwe ya yekem nîşan didin; heke na, ravekirinekê nîşan didin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для файлов большего размера показывается начало, если формат это позволяет, иначе — пояснение."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas yang lebih besar menampilkan bagian awalnya jika formatnya memungkinkan, atau penjelasan jika tidak."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বড় ফাইলে ফরম্যাট অনুমতি দিলে প্রথম অংশ দেখানো হয়, নইলে একটি ব্যাখ্যা দেখানো হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Manyan fayiloli suna nuna sashensu na farko idan tsarin fayil ya yarda, in ba haka ba bayani."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos maiores mostram a primeira parte quando o formato permite; caso contrário, uma explicação."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos más grandes muestran su primera parte si el formato lo permite; si no, una explicación."
          }
        }
      }
    },
    "general.limits.footnote": {
      "comment": "Footnote under the read-only limits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits are fixed in this version. Archives, databases and 3D models apply their own limits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlar bu sürümde sabittir. Arşivler, veritabanları ve 3B modeller kendi sınırlarını uygular."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Limits sind in dieser Version fest. Archive, Datenbanken und 3D-Modelle wenden eigene Limits an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites sont fixes dans cette version. Les archives, les bases de données et les modèles 3D appliquent leurs propres limites."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本中的限制是固定的。归档、数据库和 3D 模型会应用各自的限制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンでは制限は固定です。アーカイブ、データベース、3Dモデルには、それぞれ独自の制限が適用されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस संस्करण में सीमाएँ निश्चित हैं। संग्रह, डेटाबेस और 3D मॉडल अपनी अलग सीमाएँ लागू करते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sînor di vê guhertoyê de sabit in. Arşîv, bingehên daneyan û modelên 3D sînorên xwe yên cuda bi kar tînin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии ограничения фиксированные. Для архивов, баз данных и 3D-моделей действуют собственные ограничения."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas bersifat tetap di versi ini. Arsip, basis data, dan model 3D menerapkan batasnya sendiri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সংস্করণে সীমাগুলি নির্দিষ্ট। আর্কাইভ, ডেটাবেস ও 3D মডেল নিজ নিজ সীমা প্রয়োগ করে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Iyakokin a tsaye suke a wannan sigar. Kundin fayil, rumbunan bayanai da samfuran 3D suna amfani da iyakokinsu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites são fixos nesta versão. Arquivos compactados, bancos de dados e modelos 3D aplicam seus próprios limites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites son fijos en esta versión. Los archivos comprimidos, las bases de datos y los modelos 3D aplican sus propios límites."
          }
        }
      }
    },
