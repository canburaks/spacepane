    "appearance.lineNumbersHint": {
      "comment": "Explain that concealment may collapse source lines, wrapping is visual only, and the gutter never changes copied content.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers follow the displayed logical lines after concealment. Wrapped continuations share a number; copied text does not include line numbers."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numaralar, gizleme sonrasında görüntülenen mantıksal satırları izler. Kaydırılan devam satırları aynı numarayı paylaşır; kopyalanan metin satır numaralarını içermez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nummern folgen den angezeigten logischen Zeilen nach dem Verbergen von Inhalten. Umgebrochene Fortsetzungen teilen eine Nummer; kopierter Text enthält keine Zeilennummern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les numéros suivent les lignes logiques affichées après masquage. Les retours visuels partagent le même numéro ; le texte copié n’inclut pas les numéros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行号对应隐藏机密后显示的逻辑行。换行延续部分共享同一行号；拷贝的文本不包含行号。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号は秘密情報を隠した後の論理行に対応します。折り返された部分には同じ番号が使われます。コピーしたテキストに行番号は含まれません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संख्याएँ सामग्री छिपाने के बाद दिखने वाली तार्किक पंक्तियों का अनुसरण करती हैं। मुड़ी पंक्ति के अगले भागों की संख्या समान है; कॉपी किए टेक्स्ट में पंक्ति संख्याएँ नहीं आतीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejmar piştî veşartinê rêzikên mantîqî yên nîşandayî dişopînin. Berdewamiyên şikestî heman hejmarê bi kar tînin; metna kopîkirî hejmarên rêzikan nagire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нумерация соответствует отображаемым логическим строкам после скрытия секретов. Перенесённые части имеют один номер; скопированный текст не содержит номеров строк."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomor mengikuti baris logis yang ditampilkan setelah penyamaran. Lanjutan baris yang dibungkus memakai nomor yang sama; teks yang disalin tidak menyertakan nomor baris."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নম্বর গোপন তথ্য লুকানোর পরে প্রদর্শিত যৌক্তিক লাইন অনুসরণ করে। ভেঙে দেখানো লাইনের পরের অংশে একই নম্বর থাকে; কপি করা লেখায় লাইন নম্বর থাকে না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lambobi suna bin layukan rubutu da ake nunawa bayan ɓoye sirri. Ci gaban layin da aka karya yana da lamba ɗaya; rubutun da aka kwafa ba ya haɗa lambobin layuka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números seguem as linhas lógicas exibidas após a ocultação. As continuações de linhas quebradas compartilham um número; o texto copiado não inclui números de linha."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números siguen las líneas lógicas mostradas tras ocultar secretos. Las continuaciones de líneas ajustadas comparten un número; el texto copiado no incluye números de línea."
          }
        }
      }
    },
