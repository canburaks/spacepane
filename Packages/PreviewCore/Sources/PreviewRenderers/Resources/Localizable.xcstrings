    "format.model.stl.description": {
      "comment": "One-sentence description of the STL preview shown under the file-type switch. 'Triangle meshes' are surfaces made of triangles; 'binary and ASCII' name the two STL encodings. The second sentence says what the preview does not show.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local 3D preview of triangle meshes, in binary and ASCII form. Colors, materials and units are not shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üçgen ağların ikili ve ASCII biçimlerinde yerel 3B önizlemesi. Renkler, malzemeler ve birimler gösterilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale 3D-Vorschau von Dreiecksnetzen, binär und als ASCII. Farben, Materialien und Einheiten werden nicht angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu 3D local de maillages triangulaires, au format binaire et ASCII. Les couleurs, les matériaux et les unités ne sont pas affichés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三角网格的本地 3D 预览，支持二进制和 ASCII 格式。不显示颜色、材质和单位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三角形メッシュのローカル3Dプレビュー（バイナリ形式とASCII形式）。色、マテリアル、単位は表示されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "त्रिभुज जालों का स्थानीय 3D पूर्वावलोकन, बाइनरी और ASCII रूप में। रंग, सामग्री और इकाइयाँ नहीं दिखाई जातीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pêşdîtina 3D ya herêmî ji bo tevnên sêgoşeyî, bi forma binary û ASCII. Reng, materyal û yekeyan nayên nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный 3D-просмотр треугольных сеток в двоичном и ASCII-форматах. Цвета, материалы и единицы измерения не показываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau 3D lokal untuk jaring segitiga, dalam format biner dan ASCII. Warna, material, dan satuan tidak ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ত্রিভুজ জালের স্থানীয় 3D প্রিভিউ, বাইনারি ও ASCII রূপে। রং, ম্যাটেরিয়াল ও একক দেখানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duban 3D na cikin naʼura na ragar alwatika, a tsarin binary da ASCII. Ba a nuna launuka, kayan ƙira da maʼauni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia 3D local de malhas triangulares, em formato binário e ASCII. Cores, materiais e unidades não são exibidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa 3D local de mallas triangulares, en formato binario y ASCII. No se muestran colores, materiales ni unidades."
          }
        }
      }
    },
