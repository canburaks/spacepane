    "appearance.syntax.hint": {
      "comment": "App-authored label or feedback; preserve format placeholders and their argument types.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Styles apply only to safe displayed text. Colors use accessible theme palettes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiller yalnızca güvenli görüntülenen metne uygulanır. Renkler erişilebilir tema paletlerini kullanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stile gelten nur für sicher angezeigten Text. Die Farben verwenden barrierefreie Designpaletten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les styles s’appliquent uniquement au texte affiché sécurisé. Les couleurs utilisent des palettes de thème accessibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "样式仅应用于安全显示的文本。颜色采用符合辅助功能要求的主题调色板。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイルは安全に表示されるテキストにのみ適用されます。色にはアクセシビリティに配慮したテーマのパレットを使用します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शैलियाँ केवल सुरक्षित प्रदर्शित टेक्स्ट पर लागू होती हैं। रंग सुलभ थीम पैलेट का उपयोग करते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Şêwaz tenê li ser metna ewle ya nîşandayî tên sepandin. Reng paletên temayê yên gihîştinbar bi kar tînin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стили применяются только к безопасному отображаемому тексту. Цвета используют доступные палитры темы."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaya hanya diterapkan pada teks aman yang ditampilkan. Warna menggunakan palet tema yang aksesibel."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শৈলী কেবল নিরাপদ প্রদর্শিত লেখায় প্রয়োগ করা হয়। রং সহজে ব্যবহারযোগ্য থিম প্যালেট থেকে নেওয়া হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana amfani da salo ga rubutu mai aminci da ake nunawa kawai. Launuka suna amfani da jigon da ke sauƙaƙa karantawa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os estilos se aplicam somente ao texto seguro exibido. As cores usam paletas de temas acessíveis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estilos se aplican solo al texto seguro mostrado. Los colores usan paletas de temas accesibles."
          }
        }
      }
    },
