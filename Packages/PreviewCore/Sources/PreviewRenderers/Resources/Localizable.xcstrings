          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ एक स्थानीय फ़ाइल छोड़ें"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Li vir yek pela herêmî berde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите сюда один локальный файл"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan satu berkas lokal di sini"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে একটি স্থানীয় ফাইল ছাড়ুন"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajiye fayil ɗaya na cikin naʼura a nan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte um arquivo local aqui"
          }
