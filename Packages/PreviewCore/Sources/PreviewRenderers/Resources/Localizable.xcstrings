    "format.data.xml.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded XML source and structure; external entities are not loaded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı XML kaynağı ve yapısı; harici varlıklar yüklenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte XML-Quelle und Struktur; externe Entitäten werden nicht geladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source et structure XML limitées ; les entités externes ne sont pas chargées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限度的 XML 源码和结构；不载入外部实体。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限付き XML ソースと構造。外部実体は読み込みません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित XML स्रोत और संरचना; बाहरी एंटिटी लोड नहीं होतीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Çavkanî û avahiya XML a sînordar; hêmanên derveyî nayên barkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный текст и структура XML с ограничениями; внешние сущности не загружаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber dan struktur XML berbatas; entitas eksternal tidak dimuat."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমাবদ্ধ XML উৎস ও কাঠামো; বাহ্যিক সত্তা লোড করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tushe da tsarin XML mai iyaka; ba a loda abubuwan waje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Origem e estrutura XML com limites; entidades externas não são carregadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código fuente y estructura XML limitados; no se cargan entidades externas."
          }
        }
      }
    },
