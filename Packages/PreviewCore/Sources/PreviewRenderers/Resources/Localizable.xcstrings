    "preview.listing.filter.help": {
      "comment": "Accessibility help of the table filter field. The match ignores upper and lower case and accents.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type text to show only the rows that contain it. Case and accents are ignored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yazdığınız metni içeren satırları göstermek için metin yazın. Büyük/küçük harf ve aksanlar yok sayılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text eingeben, um nur Zeilen anzuzeigen, die ihn enthalten. Groß-/Kleinschreibung und Akzente werden ignoriert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez du texte pour n’afficher que les lignes qui le contiennent. La casse et les accents sont ignorés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入文字，仅显示包含该文字的行。忽略大小写和重音符号。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を入力すると、その文字を含む行だけを表示します。大文字・小文字とアクセントは区別しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वे पंक्तियाँ दिखाने के लिए टेक्स्ट लिखें जिनमें वह टेक्स्ट है। अक्षर-भेद और उच्चारण-चिह्न अनदेखे किए जाते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivîsekî binivîse da ku tenê rêzên ku wî dihewînin werin nîşandan. Mezin/biçûk û nîşanên dengdêran nayên hesibandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите текст, чтобы показать только строки, содержащие его. Регистр и диакритические знаки не учитываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik teks untuk hanya menampilkan baris yang memuatnya. Huruf besar/kecil dan aksen diabaikan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু সেই সারিগুলো দেখাতে লিখুন যেখানে লেখাটি আছে। বড়-ছোট হাতের অক্ষর ও উচ্চারণচিহ্ন উপেক্ষা করা হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubuta rubutu domin nuna layukan da ke ɗauke da shi kawai. Ba a laʼakari da manya da ƙananan haruffa da alamomin haruffa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um texto para mostrar apenas as linhas que o contêm. Maiúsculas, minúsculas e acentos são ignorados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe texto para mostrar solo las filas que lo contienen. Se ignoran mayúsculas, minúsculas y acentos."
          }
        }
      }
    },
