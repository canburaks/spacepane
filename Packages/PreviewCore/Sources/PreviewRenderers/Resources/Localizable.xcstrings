    "format.data.gpx.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX waypoints, routes and tracks with distance, elevation and time range, plus a map-free plot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX yol noktaları, rotalar ve izler; mesafe, yükseklik ve zaman aralığı ile haritasız bir çizim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX-Wegpunkte, -Routen und -Tracks mit Strecke, Höhe und Zeitraum sowie ein kartenfreier Plot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points de passage, itinéraires et traces GPX avec distance, altitude et plage horaire, plus un tracé sans carte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX 航点、路线和轨迹，含距离、海拔和时间范围，以及不含地图的绘图。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX のウェイポイント、ルート、トラックと、距離・標高・時間範囲、地図なしのプロット。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX वेपॉइंट, मार्ग और ट्रैक, दूरी, ऊँचाई और समय सीमा के साथ, तथा बिना मानचित्र वाला प्लॉट।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xalên rê, rê û şopên GPX bi dûrahî, bilindahî û navbera demê, û xêzkirinek bê nexşe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путевые точки, маршруты и треки GPX с расстоянием, высотой и временным диапазоном, а также график без карты."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik jalan, rute, dan trek GPX dengan jarak, ketinggian, dan rentang waktu, serta plot tanpa peta."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX ওয়েপয়েন্ট, রুট ও ট্র্যাক—দূরত্ব, উচ্চতা ও সময়সীমাসহ—এবং মানচিত্রহীন প্লট।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuraren hanya, hanyoyi da hanyoyin bi na GPX tare da tazara, tsayi da tsawon lokaci, da zane ba tare da taswira ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos de passagem, rotas e trilhas GPX com distância, elevação e intervalo de tempo, além de um gráfico sem mapa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos de ruta, rutas y pistas GPX con distancia, altitud e intervalo de tiempo, además de un gráfico sin mapa."
          }
        }
      }
    },
