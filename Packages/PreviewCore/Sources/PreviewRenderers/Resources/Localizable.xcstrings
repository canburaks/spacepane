    "format.config.strings-dictionary.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only property-list localization dictionaries."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur özellik listesi yerelleştirme sözlükleri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützte Lokalisierungswörterbücher als Eigenschaftslisten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictionnaires de localisation de listes de propriétés en lecture seule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读属性列表本地化字典。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用のプロパティリスト形式のローカライズ辞書。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल पढ़ने के प्रॉपर्टी सूची स्थानीयकरण शब्दकोश।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferhengên herêmîkirinê yên lîsteyên taybetmendiyan ên tenê-xwendinê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Словари локализации в формате списков свойств только для чтения."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamus lokalisasi daftar properti hanya baca."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু পড়ার প্রপার্টি তালিকা স্থানীয়করণ অভিধান।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙamus na fassarar jerin kadarori don karantawa kawai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicionários de localização em listas de propriedades somente para leitura."
          }
        },
        "es": {
          "stringUnit": {
