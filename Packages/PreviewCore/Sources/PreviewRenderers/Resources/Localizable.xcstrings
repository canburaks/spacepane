    "appearance.profile.hint": {
      "comment": "App-authored label or feedback; preserve format placeholders and their argument types.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles contain appearance only. File type choices stay independent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiller yalnızca görünümü içerir. Dosya türü seçimleri bağımsız kalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile enthalten nur die Darstellung. Die Dateitypauswahl bleibt unabhängig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils contiennent uniquement l’apparence. Les choix de types de fichiers restent indépendants."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案仅包含外观。文件类型选择保持独立。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルには外観のみが含まれます。ファイルの種類の選択は独立しています。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल में केवल रूप शामिल होता है। फ़ाइल प्रकार के चयन स्वतंत्र रहते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Profîl tenê dîmenê digirin. Hilbijartinên cureyên pelan serbixwe dimînin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили содержат только оформление. Выбор типов файлов остаётся независимым."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil hanya berisi tampilan. Pilihan jenis berkas tetap terpisah."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রোফাইলে কেবল চেহারা থাকে। ফাইলের ধরন নির্বাচন স্বাধীন থাকে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayanan salo sun ƙunshi kamanni kawai. Zaɓin nauʼoʼin fayil yana zaman kansa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis contêm somente a aparência. As escolhas de tipos de arquivo são independentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles contienen solo la apariencia. Las opciones de tipos de archivo son independientes."
          }
        }
      }
    },
