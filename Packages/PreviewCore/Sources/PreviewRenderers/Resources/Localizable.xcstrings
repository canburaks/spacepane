    "format.archive.7z.description": {
      "comment": "Supported-behavior description for 7z archives. Only the header, which may itself be compressed, is decoded; file data is never decoded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded 7z entry listings from the header, including compressed headers. File data is never decoded; archives with encrypted headers are not listed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıkıştırılmış üst bilgiler dahil, üst bilgiden 7z girdilerinin sınırlı listeleri. Dosya verileri hiçbir zaman çözülmez; üst bilgisi şifreli arşivler listelenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte 7z-Eintragslisten aus dem Header, auch bei komprimierten Headern. Dateidaten werden nie dekodiert; Archive mit verschlüsselten Headern werden nicht aufgelistet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listes d’entrées 7z bornées, lues dans l’en-tête, y compris compressé. Les données des fichiers ne sont jamais décodées ; les archives aux en-têtes chiffrés ne sont pas listées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据头部（包括已压缩的头部）生成有界的 7z 条目列表。绝不解码文件数据；头部已加密的压缩包不会列出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮されたヘッダを含め、ヘッダから 7z の項目を上限付きで一覧表示します。ファイルのデータはデコードしません。ヘッダが暗号化されたアーカイブは一覧表示されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपीड़ित हेडर सहित, हेडर से 7z प्रविष्टियों की सीमित सूची। फ़ाइल डेटा कभी डीकोड नहीं किया जाता; एन्क्रिप्टेड हेडर वाले संग्रह सूचीबद्ध नहीं होते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lîsteyên sînorkirî yên tomarên 7z ji sernivîsê, bi sernivîsên pêçandî jî. Daneyên pelan qet nayên vekirin; arşîvên bi sernivîsên şîfrekirî nayên lîstekirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченные списки записей 7z по заголовку, в том числе сжатому. Данные файлов никогда не декодируются; архивы с зашифрованными заголовками не перечисляются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar entri 7z yang dibatasi dari header, termasuk header terkompresi. Data file tidak pernah didekode; arsip dengan header terenkripsi tidak didaftar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংকুচিত হেডারসহ হেডার থেকে 7z এন্ট্রির সীমিত তালিকা। ফাইলের ডেটা কখনও ডিকোড করা হয় না; এনক্রিপ্টেড হেডারযুক্ত আর্কাইভ তালিকাভুক্ত হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Jerin shigarwar 7z mai iyaka daga kan fayil, har da wanda aka matse. Ba a taɓa buɗe bayanan fayiloli ba; ba a jera taskokin da kan fayilolinsu aka ɓoye ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas limitadas de entradas 7z lidas do cabeçalho, inclusive comprimido. Os dados dos arquivos nunca são decodificados; arquivos com cabeçalhos cifrados não são listados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas acotadas de entradas 7z leídas de la cabecera, incluso comprimida. Los datos de los archivos nunca se decodifican; los archivos con cabeceras cifradas no se listan."
          }
        }
      }
    },
