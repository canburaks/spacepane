    "format.config.provisioning-profile.description": {
      "comment": "One-sentence description of the config.provisioning-profile file type; states what is and is not shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, team, dates and entitlements. Device identifiers are never shown, and the signature is not verified."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad, takım, tarihler ve yetkiler. Cihaz tanımlayıcıları hiçbir zaman gösterilmez ve imza doğrulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, Team, Daten und Berechtigungen. Geräte-IDs werden nie angezeigt, und die Signatur wird nicht geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom, équipe, dates et droits. Les identifiants d’appareils ne sont jamais affichés et la signature n’est pas vérifiée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称、团队、日期和权限。从不显示设备标识符，也不验证签名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前、チーム、日付、権限。デバイス識別子は表示せず、署名の検証も行いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम, टीम, तिथियाँ और एंटाइटलमेंट। डिवाइस पहचानकर्ता कभी नहीं दिखाए जाते और हस्ताक्षर का सत्यापन नहीं होता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav, tîm, dîrok û mafên (entitlements). Nasnameyên amûran tu carî nayên nîşandan û îmze nayê piştrastkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя, команда, даты и привилегии. Идентификаторы устройств никогда не показываются, подпись не проверяется."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama, tim, tanggal, dan entitlement. Pengenal perangkat tidak pernah ditampilkan, dan tanda tangan tidak diverifikasi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম, টিম, তারিখ ও এনটাইটেলমেন্ট। ডিভাইস শনাক্তকারী কখনও দেখানো হয় না এবং স্বাক্ষর যাচাই করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Suna, ƙungiya, kwanakin wata da izini. Ba a taɓa nuna masu gano naʼura ba, kuma ba a tabbatar da sa hannu ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome, equipe, datas e entitlements. Identificadores de dispositivos nunca são exibidos e a assinatura não é verificada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre, equipo, fechas y entitlements. Los identificadores de dispositivos nunca se muestran y la firma no se verifica."
          }
        }
      }
    },
    "format.config.provisioning-profile.name": {
