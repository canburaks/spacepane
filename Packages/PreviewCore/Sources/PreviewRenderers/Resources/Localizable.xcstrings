          "stringUnit": {
            "state": "translated",
            "value": "Bounded Parquet footer inspection: schema, row groups and metadata; column data is never read."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı Parquet alt bilgi incelemesi: şema, satır grupları ve üst veri; sütun verisi hiç okunmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Prüfung der Parquet-Fußzeile: Schema, Zeilengruppen und Metadaten; Spaltendaten werden nie gelesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspection bornée du pied de page Parquet : schéma, groupes de lignes et métadonnées ; les données des colonnes ne sont jamais lues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对 Parquet 文件尾部进行有限检查：架构、行组和元数据；绝不读取列数据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Parquet フッターの制限付き確認：スキーマ、行グループ、メタデータ。列データは読み取りません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित Parquet फ़ुटर निरीक्षण: स्कीमा, पंक्ति समूह और मेटाडेटा; स्तंभ डेटा कभी नहीं पढ़ा जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Venêrîna sînorkirî ya binê Parquet: schema, komên rêzan û metadata; daneyên stûnan tu carî nayên xwendin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченный просмотр нижней части Parquet: схема, группы строк и метаданные; данные столбцов никогда не читаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan footer Parquet terbatas: skema, grup baris, dan metadata; data kolom tidak pernah dibaca."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমিত Parquet ফুটার পরিদর্শন: স্কিমা, সারি গ্রুপ ও মেটাডেটা; কলামের ডেটা কখনো পড়া হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Binciken ƙarshen Parquet mai iyaka: tsari, ƙungiyoyin layuka da metadata; ba a taɓa karanta bayanan ginshiƙai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspeção limitada do rodapé do Parquet: esquema, grupos de linhas e metadados; os dados das colunas nunca são lidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspección acotada del pie de Parquet: esquema, grupos de filas y metadatos; los datos de las columnas nunca se leen."
          }
        }
      }
    },
