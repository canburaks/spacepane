    "finding.extension.startsAutomatically": {
      "comment": "Informational finding for a code editor extension (.vsix, for Visual Studio Code and similar editors): the extension asks to start every time the editor opens, not only when one of its features is used. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts whenever the editor opens."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod düzenleyici her açıldığında başlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet bei jedem Öffnen des Code-Editors."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre à chaque ouverture de l’éditeur de code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打开代码编辑器时都会启动。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードエディタを開くたびに起動します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड एडिटर खुलने पर हर बार शुरू हो जाता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dema edîtora kodê tê vekirin dest pê dike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускается при каждом открытии редактора кода."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimulai setiap kali editor kode dibuka."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোড এডিটর খুললেই প্রতিবার চালু হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana farawa duk lokacin da aka buɗe manhajar gyaran lamba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sempre que o editor de código é aberto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arranca cada vez que se abre el editor de código."
          }
        }
      }
    },
    "finding.hidden.agentInstructions": {
      "comment": "Hidden-content context shown with other hidden-content findings in files such as AGENTS.md or .cursorrules.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This looks like an instruction file for AI coding tools, where hidden text can steer them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, gizli metnin yönlendirebileceği yapay zekâ kodlama araçları için bir talimat dosyasına benziyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies scheint eine Anweisungsdatei für KI-Coding-Tools zu sein; versteckter Text kann sie steuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ressemble à un fichier d’instructions pour des outils de codage IA, où du texte caché peut les orienter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来像 AI 编程工具的指令文件，其中的隐藏文本可能会左右这些工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI コーディングツール向けの指示ファイルのようです。隠しテキストでツールの動作を操作される可能性があります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह AI कोडिंग टूल के लिए निर्देश फ़ाइल जैसी लगती है, जहाँ छिपा टेक्स्ट उन्हें प्रभावित कर सकता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev mîna pelek rêwerzan ji bo amûrên kodkirinê yên AI xuya dike, ku nivîsa veşartî dikare wan rêve bibe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже на файл инструкций для ИИ-инструментов программирования, где скрытый текст может ими управлять."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tampak seperti berkas instruksi untuk alat pemrograman AI, yang bisa diarahkan oleh teks tersembunyi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি AI কোডিং টুলের জন্য নির্দেশনা ফাইলের মতো দেখাচ্ছে, যেখানে লুকানো টেক্সট সেগুলোকে প্রভাবিত করতে পারে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan yana kama da fayil na umarni ga kayan aikin coding na AI, inda boyayyen rubutu zai iya jagorantar su."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece um arquivo de instruções para ferramentas de programação com IA, em que texto escondido pode direcioná-las."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece un archivo de instrucciones para herramientas de programación con IA, donde el texto escondido puede dirigirlas."
          }
        }
      }
    },
    "finding.hidden.bidirectionalControls": {
      "comment": "Hidden-content check for Unicode bidirectional controls (Trojan Source). %lld is a count (Int64). Keep the wording independent of singular and plural.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction-changing characters that can make code read differently than it runs: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun çalıştığından farklı okunmasına yol açabilen yön değiştirme karakterleri: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtungsändernde Zeichen, durch die Code anders gelesen wird, als er ausgeführt wird: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caractères de changement de direction pouvant faire lire le code autrement qu’il ne s’exécute : %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能让代码的显示与实际运行不一致的方向控制字符：%lld。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードの見え方と実行内容を食い違わせる可能性がある、方向を変える文字: %lld。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिशा बदलने वाले अक्षर, जिनसे कोड वैसा नहीं पढ़ा जाता जैसा वह चलता है: %lld।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tîpên guherîna alî yên ku dikarin bikin ku kod ji ya ku dixebite cuda were xwendin: %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символы смены направления текста, из-за которых код читается иначе, чем выполняется: %lld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karakter pengubah arah yang membuat kode terbaca berbeda dari yang dijalankan: %lld."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিক পরিবর্তনকারী অক্ষর, যার ফলে কোড যেভাবে চলে তার থেকে ভিন্নভাবে পড়া যায়: %lld।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Haruffa masu canza alkibla waɗanda ke sa a karanta code daban da yadda yake aiki: %lld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Caracteres que mudam a direção do texto e fazem o código ser lido de forma diferente de como é executado: %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caracteres que cambian la dirección del texto y hacen que el código se lea distinto de como se ejecuta: %lld."
          }
        }
      }
    },
