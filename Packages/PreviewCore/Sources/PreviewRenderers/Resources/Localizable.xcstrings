    "format.package.editor-extension.description": {
      "comment": "One-sentence description of a file type in the companion's File Types list: code editor extension packages; the summary shows facts from the manifest and checks the scripts for invisible characters. Technical names stay as they are. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publisher, version, when it starts, bundled native code and hidden characters. Nothing is installed or run."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayıncı, sürüm, ne zaman başladığı, pakete dahil makine kodu ve gizli karakterler. Hiçbir şey kurulmaz veya çalıştırılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herausgeber, Version, Startzeitpunkt, enthaltener nativer Code und unsichtbare Zeichen. Nichts wird installiert oder ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éditeur de l’extension, version, moment du démarrage, code natif inclus et caractères masqués. Rien n’est installé ni exécuté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布者、版本、启动时机、附带的原生代码和隐藏字符。不会安装或运行任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開元、バージョン、起動のタイミング、同梱されたネイティブコード、隠れた文字。何もインストールや実行はしません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकाशक, संस्करण, कब शुरू होता है, साथ आया नेटिव कोड और छिपे वर्ण। कुछ भी इंस्टॉल या चलाया नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Weşanger, guherto, kengê dest pê dike, koda makîneyê ya tê de û tîpên veşartî. Tiştek nayê sazkirin an xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Издатель, версия, когда запускается, встроенный нативный код и скрытые символы. Ничего не устанавливается и не запускается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerbit, versi, kapan dimulai, kode native yang disertakan, dan karakter tersembunyi. Tidak ada yang diinstal atau dijalankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রকাশক, সংস্করণ, কখন চালু হয়, সঙ্গে থাকা নেটিভ কোড ও লুকানো অক্ষর। কিছুই ইনস্টল বা চালানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai wallafawa, sigar, lokacin farawa, lambar native da aka haɗa, da haruffan da aka ɓoye. Ba a shigar ko gudanar da komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicador, versão, quando inicia, código nativo incluído e caracteres ocultos. Nada é instalado nem executado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicador, versión, cuándo se inicia, código nativo incluido y caracteres ocultos. No se instala ni se ejecuta nada."
          }
        }
      }
    },
