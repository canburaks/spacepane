    "mesh.printCheck.openEdges": {
      "comment": "Plural key (one count sentence; the first formatter argument chooses the plural form and is never printed, the second is the count already formatted for the locale). Print-check line of a 3D model preview: the number of open edges, meaning edges that only one triangle of the surface uses, so the surface has a gap there and is not watertight. Shown only when the count is above zero. Say it as a fact about the surface; never claim the model is broken or cannot be printed. Count of the displayed tessellation. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%2$@ open edge (a gap in the surface)"
                }
