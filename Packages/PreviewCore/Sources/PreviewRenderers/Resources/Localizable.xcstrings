    "preview.disabledDescription": {
      "comment": "Instructions shown for a disabled format; no content is displayed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable this file type in the companion app’s File Types settings to preview its content."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriği önizlemek için yardımcı uygulamanın Dosya Türleri ayarlarında bu dosya türünü etkinleştirin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie diesen Dateityp in den Dateityp-Einstellungen der Begleit-App, um seinen Inhalt anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ce type de fichier dans les réglages Types de fichiers de l’app compagnon pour afficher son contenu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要预览其内容，请在配套应用的“文件类型”设置中启用此文件类型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容をプレビューするには、連携アプリの「ファイルの種類」設定でこの種類を有効にしてください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामग्री का पूर्वावलोकन करने के लिए साथी ऐप की फ़ाइल प्रकार सेटिंग्ज़ में यह प्रकार सक्षम करें।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji bo pêşdîtina naverokê, vê cureya pelê di mîhengên Cureyên Pelan ên sepana alîkar de çalak bike."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы просматривать содержимое, включите этот тип в настройках типов файлов основного приложения."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan jenis berkas ini di pengaturan Jenis Berkas aplikasi pendamping untuk melihat pratinjau kontennya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়বস্তুর প্রিভিউ দেখতে সহযোগী অ্যাপের ফাইলের ধরন সেটিংসে এই ধরন সক্রিয় করুন।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunna wannan nauʼin fayil a saitunan Nauʼoʼin Fayil na manhajar taimako don duba abubuwansa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative este tipo de arquivo nos ajustes de Tipos de Arquivo do app complementar para pré-visualizar seu conteúdo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa este tipo de archivo en los ajustes de Tipos de archivo de la app complementaria para ver su contenido."
          }
        }
      }
    },
