    "format.config.strings.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only localization key/value source with likely secrets concealed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olası gizli bilgileri gizlenmiş salt okunur yerelleştirme anahtar/değer kaynağı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützte Lokalisierungsquelle mit Schlüsseln und Werten sowie verborgenen wahrscheinlichen Geheimnissen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source de localisation clé/valeur en lecture seule avec secrets probables masqués."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读本地化键值源码，并隐藏可能的机密信息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密情報と思われる部分を隠した、読み取り専用のローカライズ用キーと値のソース。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोपनीय जानकारी छिपाकर केवल पढ़ने का स्थानीयकरण कुंजी/मान स्रोत।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Çavkaniya mifte/nirx a herêmîkirinê ya tenê-xwendinê bi agahiyên veşartî yên têne veşartin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный текст локализации «ключ — значение» только для чтения со скрытием вероятных секретов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber kunci/nilai lokalisasi hanya baca dengan informasi yang diduga rahasia disamarkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গোপন তথ্য লুকিয়ে শুধু পড়ার স্থানীয়করণ কি/মান উৎস।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tushe na maɓalli/ƙima na fassarar manhaja don karantawa kawai tare da ɓoye sirri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Origem de chaves e valores de localização somente para leitura, com possíveis segredos ocultados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código fuente de claves y valores de localización de solo lectura con posibles secretos ocultos."
          }
        }
      }
    },
