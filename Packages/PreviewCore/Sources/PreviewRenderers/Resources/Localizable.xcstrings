    "format.document.web-archive.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text of saved MHTML pages; pages are never rendered or loaded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş MHTML sayfalarının metni; sayfalar asla işlenmez veya yüklenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text gespeicherter MHTML-Seiten; Seiten werden nie gerendert oder geladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte des pages MHTML enregistrées ; les pages ne sont jamais rendues ni chargées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示已保存 MHTML 页面的文字；页面不会被渲染或加载。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された MHTML ページのテキストを表示します。ページの描画や読み込みは行いません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए MHTML पृष्ठों का पाठ; पृष्ठ कभी रेंडर या लोड नहीं किए जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivîsa rûpelên MHTML yên tomarkirî; rûpel tu carî nayên teşekirin an barkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст сохранённых страниц MHTML; страницы никогда не отображаются и не загружаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks halaman MHTML yang disimpan; halaman tidak pernah dirender atau dimuat."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত MHTML পৃষ্ঠার লেখা; পৃষ্ঠা কখনও রেন্ডার বা লোড করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubutun shafukan MHTML da aka ajiye; ba a taɓa nuna shafukan ko loda su ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto de páginas MHTML salvas; as páginas nunca são renderizadas nem carregadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto de páginas MHTML guardadas; las páginas nunca se muestran ni se cargan."
          }
        }
      }
    },
