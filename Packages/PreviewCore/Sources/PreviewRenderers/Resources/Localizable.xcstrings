    "appearance.resetHint": {
      "comment": "Help for reset appearance; distinguish it from resetting file type choices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the default theme and typography. File type choices are preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan temayı ve tipografiyi geri yükleyin. Dosya türü seçimleri korunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standarddesign und Typografie wiederherstellen. Die Dateitypauswahl bleibt erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir le thème et la typographie par défaut. Les choix de types de fichiers sont conservés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认主题和字体排印。保留文件类型选择。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマと書体設定を初期値に戻します。ファイルの種類の選択は保持されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट थीम और टाइपोग्राफ़ी बहाल करें। फ़ाइल प्रकार के चयन सुरक्षित रहते हैं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema û tîpnivîsiya standard vegerîne. Hilbijartinên cureyên pelan tên parastin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить стандартную тему и типографику. Выбор типов файлов сохраняется."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan tema dan tipografi bawaan. Pilihan jenis berkas tetap dipertahankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিফল্ট থিম ও টাইপোগ্রাফি ফিরিয়ে আনুন। ফাইলের ধরন নির্বাচন বজায় থাকে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayar da jigo da salon rubutu na farko. Ana kiyaye zaɓin nauʼoʼin fayil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure o tema e a tipografia padrão. As escolhas de tipos de arquivo são preservadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el tema y la tipografía predeterminados. Se conservan las opciones de tipos de archivo."
          }
        }
      }
    },
    "appearance.sample.description": {
      "comment": "Caption under the live sample. Each supported file type has a synthetic sample; the user picks one from a menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file type to see a built-in sample with your settings. Samples contain no personal data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınızla yerleşik bir örnek görmek için bir dosya türü seçin. Örnekler kişisel veri içermez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Dateityp, um ein integriertes Beispiel mit Ihren Einstellungen zu sehen. Beispiele enthalten keine persönlichen Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un type de fichier pour voir un exemple intégré avec vos réglages. Les exemples ne contiennent aucune donnée personnelle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一种文件类型，即可查看应用了你的设置的内置示例。示例不含个人数据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの種類を選ぶと、設定を適用した内蔵サンプルが表示されます。サンプルに個人データは含まれません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सेटिंग्ज़ के साथ अंतर्निहित नमूना देखने के लिए कोई फ़ाइल प्रकार चुनें। नमूनों में कोई व्यक्तिगत डेटा नहीं होता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cureyekî pelê hilbijêre da ku nimûneyeke hundirîn bi mîhengên xwe bibînî. Nimûne tu daneyên kesane nagirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите тип файла, чтобы увидеть встроенный образец с вашими настройками. Образцы не содержат личных данных."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jenis berkas untuk melihat contoh bawaan dengan pengaturan Anda. Contoh tidak berisi data pribadi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সেটিংসসহ একটি অন্তর্নির্মিত নমুনা দেখতে একটি ফাইলের ধরন বেছে নিন। নমুনায় কোনো ব্যক্তিগত ডেটা নেই।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi nauʼin fayil don ganin samfurin cikin manhaja da saitunanku. Samfuran ba su ƙunshi bayanan sirri ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um tipo de arquivo para ver uma amostra integrada com seus ajustes. As amostras não contêm dados pessoais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tipo de archivo para ver una muestra integrada con tus ajustes. Las muestras no contienen datos personales."
          }
        }
      }
    },
