    "format.disk.image.description": {
      "comment": "One-sentence description of the disk.image file type; states what is and is not shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size and partition table of UDIF images. Images are never mounted or decompressed, and encrypted images are not opened."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UDIF görüntülerinin boyutu ve bölüm tablosu. Görüntüler hiçbir zaman bağlanmaz veya açılmaz; şifreli görüntüler açılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe und Partitionstabelle von UDIF-Images. Images werden nie gemountet oder dekomprimiert, verschlüsselte Images werden nicht geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille et table de partitions des images UDIF. Les images ne sont jamais montées ni décompressées et les images chiffrées ne sont pas ouvertes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UDIF 映像的大小和分区表。从不挂载或解压映像，也不打开加密映像。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UDIF イメージのサイズとパーティションテーブル。イメージのマウントや展開は行わず、暗号化されたイメージは開きません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UDIF इमेज का आकार और पार्टीशन तालिका। इमेज कभी माउंट या डीकंप्रेस नहीं की जातीं और एन्क्रिप्टेड इमेज नहीं खोली जातीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezinahî û tabloya partîsyonan a îmajên UDIF. Îmaj tu carî nayên mount kirin an vekirin û îmajên şîfrekirî nayên vekirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер и таблица разделов образов UDIF. Образы никогда не монтируются и не распаковываются, зашифрованные образы не открываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran dan tabel partisi image UDIF. Image tidak pernah di-mount atau didekompresi, dan image terenkripsi tidak dibuka."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "UDIF ইমেজের আকার ও পার্টিশন টেবিল। ইমেজ কখনও মাউন্ট বা ডিকমপ্রেস করা হয় না এবং এনক্রিপ্টেড ইমেজ খোলা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Girma da teburin ɓangarorin hotunan UDIF. Ba a taɓa hawa ko buɗe matsewar hotuna ba, kuma ba a buɗe hotunan da aka ɓoye ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho e tabela de partições de imagens UDIF. As imagens nunca são montadas nem descompactadas e imagens criptografadas não são abertas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño y tabla de particiones de imágenes UDIF. Las imágenes nunca se montan ni se descomprimen y las imágenes cifradas no se abren."
          }
        }
      }
    },
