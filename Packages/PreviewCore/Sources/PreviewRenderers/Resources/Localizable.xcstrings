    "finding.model.incomplete": {
      "comment": "Safety finding for an AI model file (GGUF or safetensors): the file's header describes more data than the file holds, which usually means an interrupted download or copy. The app reads only the header. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is shorter than its header says, possibly an incomplete download."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya, üst bilgisinde yazandan kısa; indirme tamamlanmamış olabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist kürzer, als ihr Header angibt; vielleicht ist der Download unvollständig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est plus court que ne l’indique son en-tête, peut-être à cause d’un téléchargement incomplet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件比其头部所标明的要短，可能是下载不完整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルがヘッダの記載より短く、ダウンロードが不完全な可能性があります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल अपने हेडर में बताए आकार से छोटी है, शायद डाउनलोड अधूरा है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pel ji ya ku sernivîsa wê dibêje kurttir e, dibe ku daxistin ne temam be."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл короче, чем указано в заголовке, возможно, загрузка не завершена."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas lebih pendek daripada yang tertulis di headernya, mungkin unduhan tidak lengkap."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটি হেডারে লেখা আকারের চেয়ে ছোট, হয়তো ডাউনলোড অসম্পূর্ণ।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayil ɗin ya fi abin da kan fayil ɗin ya ce ƙanƙanta, wataƙila ba a kammala saukewa ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo é menor do que seu cabeçalho indica, possivelmente por um download incompleto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es más corto de lo que indica su cabecera, posiblemente por una descarga incompleta."
          }
        }
      }
    },
    "finding.model.inconsistentLayout": {
      "comment": "Safety finding for an AI model file: the header lists the positions of its tensors (blocks of numbers), and those positions overlap or leave holes, which the file format forbids. Tensor is a technical term; keep the usual technical word in the language. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The header’s tensor ranges overlap or leave gaps, which the format forbids."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst bilgideki tensör aralıkları üst üste biniyor veya boşluk bırakıyor; biçim bunu yasaklıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tensorbereiche im Header überlappen sich oder lassen Lücken, was das Format verbietet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plages de tenseurs de l’en-tête se chevauchent ou laissent des trous, ce que le format interdit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头部中的张量范围存在重叠或空隙，格式不允许这样。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッダ内のテンソルの範囲に重なりや隙間があります。この形式では認められていません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हेडर की टेन्सर रेंज ओवरलैप होती हैं या बीच में खाली जगह छोड़ती हैं, जो प्रारूप में मना है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Navberên tensorê yên di sernivîsê de li hev diketin an valahî dihêlin, û ev form destûr nade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диапазоны тензоров в заголовке перекрываются или оставляют пропуски, а формат этого не допускает."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentang tensor di header tumpang tindih atau menyisakan celah, dan format ini melarangnya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হেডারের টেনসর রেঞ্জ একটির সঙ্গে আরেকটি মিলে যায় বা ফাঁক রাখে, যা এই ফরম্যাটে নিষিদ্ধ।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kewayen tensor a kan fayil ɗin sun haɗu da juna ko suna bar giɓi, abin da tsarin ya hana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os intervalos de tensor do cabeçalho se sobrepõem ou deixam lacunas, o que o formato proíbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intervalos de tensor de la cabecera se solapan o dejan huecos, algo que el formato prohíbe."
          }
        }
      }
    },
