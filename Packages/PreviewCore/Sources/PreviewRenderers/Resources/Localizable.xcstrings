    "notebook.images.availablePages": {
      "comment": "Notebook provenance notice shown only when at least one validated saved figure is available in the Pages mode. Does not promise every embedded image is supported or available. Pages is the localized mode name. Translations are drafts pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
