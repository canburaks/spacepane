    "format.package.ios-app.description": {
      "comment": "One-sentence description of the package.ios-app file type; states what is and is not shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, provisioning profile, icon and file listing. Nothing is extracted or run."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, provizyon profili, simge ve dosya listesi. Hiçbir şey çıkarılmaz veya çalıştırılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, Provisioning-Profil, Symbol und Dateiliste. Nichts wird entpackt oder ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, profil de provisionnement, icône et liste des fichiers. Rien n’est extrait ni exécuté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist、描述文件、图标和文件列表。不会解压或运行任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist、プロビジョニングプロファイル、アイコン、ファイル一覧。何も展開や実行はしません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, प्रोविज़निंग प्रोफ़ाइल, आइकन और फ़ाइल सूची। कुछ भी निकाला या चलाया नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, profîla provisioning, îkon û lîsteya pelan. Tiştek nayê derxistin an xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, профиль подготовки, значок и список файлов. Ничего не распаковывается и не запускается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, profil provisioning, ikon, dan daftar berkas. Tidak ada yang diekstrak atau dijalankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, প্রভিশনিং প্রোফাইল, আইকন ও ফাইলের তালিকা। কিছুই এক্সট্র্যাক্ট বা চালানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, bayanin provisioning, gunki da jerin fayiloli. Ba a cire ko gudanar da komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, perfil de provisionamento, ícone e lista de arquivos. Nada é extraído nem executado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Info.plist, perfil de aprovisionamiento, icono y lista de archivos. No se extrae ni se ejecuta nada."
          }
        }
      }
    },
