    "format.package.python-wheel.description": {
      "comment": "One-sentence description of a file type in the companion's File Types list: Python wheel packages; the summary shows the package metadata and any code that would run at every Python start. Technical names stay as they are. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, version, requirements, commands and files that run when Python starts. Nothing is installed or run."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad, sürüm, gereksinimler, komutlar ve Python başladığında çalışan dosyalar. Hiçbir şey kurulmaz veya çalıştırılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, Version, Anforderungen, Befehle und Dateien, die beim Start von Python ausgeführt werden. Nichts wird installiert oder ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom, version, prérequis, commandes et fichiers exécutés au démarrage de Python. Rien n’est installé ni exécuté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称、版本、依赖要求、命令，以及在 Python 启动时运行的文件。不会安装或运行任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前、バージョン、要件、コマンド、Python の起動時に実行されるファイル。何もインストールや実行はしません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम, संस्करण, आवश्यकताएँ, कमांड और Python शुरू होने पर चलने वाली फ़ाइलें। कुछ भी इंस्टॉल या चलाया नहीं जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav, guherto, pêdivî, ferman û pelên ku dema Python dest pê dike dixebitin. Tiştek nayê sazkirin an xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя, версия, требования, команды и файлы, которые запускаются при старте Python. Ничего не устанавливается и не запускается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama, versi, persyaratan, perintah, dan berkas yang berjalan saat Python dimulai. Tidak ada yang diinstal atau dijalankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম, সংস্করণ, প্রয়োজনীয়তা, কমান্ড এবং Python চালু হলে যে ফাইলগুলো চলে। কিছুই ইনস্টল বা চালানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Suna, sigar, buƙatu, umarni da fayilolin da ke gudana idan Python ya fara. Ba a shigar ko gudanar da komai ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome, versão, requisitos, comandos e arquivos executados quando o Python inicia. Nada é instalado nem executado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre, versión, requisitos, comandos y archivos que se ejecutan cuando Python se inicia. No se instala ni se ejecuta nada."
          }
        }
      }
    },
