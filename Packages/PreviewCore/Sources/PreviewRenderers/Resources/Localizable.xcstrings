    "preview.ebooks.notice.drm": {
      "comment": "Status line for an ebook protected by digital rights management (DRM); nothing is decrypted and protected chapters are omitted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This book is protected by digital rights management. Its protected text is not shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitap dijital haklar yönetimiyle korunuyor. Korumalı metni gösterilmiyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Buch ist durch digitales Rechtemanagement geschützt. Der geschützte Text wird nicht angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce livre est protégé par une gestion des droits numériques. Son texte protégé n’est pas affiché."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图书受数字版权管理（DRM）保护，不显示受保护的正文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書籍はデジタル著作権管理（DRM）で保護されています。保護された本文は表示されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पुस्तक डिजिटल अधिकार प्रबंधन (DRM) से सुरक्षित है। इसका सुरक्षित पाठ नहीं दिखाया जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev pirtûk bi rêveberiya mafên dîjîtal (DRM) hatiye parastin. Nivîsa wê ya parastî nayê nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Книга защищена средствами управления цифровыми правами (DRM). Защищённый текст не показывается."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku ini dilindungi manajemen hak digital (DRM). Teks yang dilindungi tidak ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বইটি ডিজিটাল অধিকার ব্যবস্থাপনা (DRM) দ্বারা সুরক্ষিত। সুরক্ষিত লেখা দেখানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kare wannan littafi da tsarin kula da haƙƙin dijital (DRM). Ba a nuna rubutunsa da aka kare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este livro é protegido por gestão de direitos digitais (DRM). O texto protegido não é mostrado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este libro está protegido por gestión de derechos digitales (DRM). No se muestra su texto protegido."
          }
        }
      }
    },
    "preview.ebooks.notice.partialPages": {
      "comment": "Status line when only some pages of a comic are shown. %1$@ is the number of pages shown and %2$@ the total number of pages, both formatted for the user's locale.",
      "extractionState": "manual",
      "localizations": {
