    "format.archive.tar.description": {
      "comment": "Sparse entries means TAR entries for files with holes/unallocated ranges, not entries that are rare or missing from the listing. No extraction occurs.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bounded archive listings without extraction; sparse entries are unsupported."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkarmadan sınırlı arşiv listeleri; seyrek girdiler desteklenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte Archivlisten ohne Extraktion; Sparse-Einträge werden nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listes d’archives limitées sans extraction ; les entrées creuses ne sont pas prises en charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限度地列出归档内容，不解压；不支持稀疏条目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開せずにアーカイブの一覧を制限付きで表示します。スパース項目には対応していません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निकाले बिना सीमित संग्रह सूचियाँ; विरल प्रविष्टियों का समर्थन नहीं।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lîsteyên arşîvê yên sînordar bê derxistinê; hêmanên sparse nayên piştgirîkirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список содержимого архива с ограничениями без извлечения; разреженные записи не поддерживаются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar arsip berbatas tanpa ekstraksi; entri sparse tidak didukung."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বের না করে সীমাবদ্ধ আর্কাইভ তালিকা; বিক্ষিপ্ত এন্ট্রি সমর্থিত নয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Jerin kundin fayil mai iyaka ba tare da fitarwa ba; ba a tallafa wa bayanai masu sarari ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Listagens limitadas sem extração; entradas esparsas não são compatíveis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listados limitados sin extracción; no se admiten entradas dispersas."
          }
        }
      }
    },
