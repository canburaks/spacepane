        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La géométrie 3D est affichée telle qu’elle est enregistrée. Les métadonnées du document sont omises."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 几何按存储的内容显示。文档元数据已省略。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3D形状は保存された状態で表示されます。文書のメタデータは省略されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3D ज्यामिति सहेजे गए रूप में दिखाई जाती है। दस्तावेज़ मेटाडेटा छोड़ दिया जाता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometriya 3D wekî hatî tomarkirin tê nîşandan. Metadataya belgeyê nayê nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3D-геометрия показана в сохранённом виде. Метаданные документа опущены."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometri 3D ditampilkan sesuai yang disimpan. Metadata dokumen dihilangkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "3D জ্যামিতি সংরক্ষিত অবস্থায় দেখানো হয়। নথির মেটাডেটা বাদ দেওয়া হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana nuna tsarin 3D kamar yadda aka adana shi. Ba a nuna bayanan takardar ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A geometria 3D é exibida como foi armazenada. Os metadados do documento são omitidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La geometría 3D se muestra tal como está guardada. Se omiten los metadatos del documento."
          }
        }
      }
    },
