          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı JSON doğrulaması ve gizlenmiş kaynak görünümü."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzte JSON-Prüfung und eine Quellansicht mit verborgenen Geheimnissen."
          }
        },
        "fr": {
