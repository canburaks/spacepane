    "format.text.jupyter-notebook.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only notebook cells and text outputs; code is never executed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur not defteri hücreleri ve metin çıktıları; kod asla çalıştırılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützte Notebook-Zellen und Textausgaben; Code wird nie ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellules et sorties texte de notebook en lecture seule ; le code n’est jamais exécuté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读的笔记本单元格和文本输出；从不执行代码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用のノートブックセルとテキスト出力。コードは実行されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल-पढ़ने योग्य नोटबुक सेल और पाठ आउटपुट; कोड कभी निष्पादित नहीं किया जाता।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Şaneyên defterê û derketinên nivîsê tenê ji bo xwendinê; kod qet nayê xebitandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ячейки блокнота и текстовые выводы только для чтения; код никогда не выполняется."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sel notebook dan keluaran teks hanya baca; kode tidak pernah dijalankan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু-পঠনযোগ্য নোটবুক সেল ও লেখা আউটপুট; কোড কখনো চালানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙwayoyin littafin rubutu da sakamakon rubutu don karatu kawai; ba a taɓa gudanar da lamba ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Células e saídas de texto do notebook somente leitura; o código nunca é executado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Celdas y salidas de texto del cuaderno de solo lectura; el código nunca se ejecuta."
          }
        }
      }
    },
