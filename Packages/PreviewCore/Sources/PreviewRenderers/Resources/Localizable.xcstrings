    "format.data.har.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP archive summaries: requests with method, address, status and size; headers, cookies and bodies are never shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP arşivi özetleri: yöntem, adres, durum ve boyutla istekler; üst bilgiler, çerezler ve gövdeler asla gösterilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenfassungen von HTTP-Archiven: Anfragen mit Methode, Adresse, Status und Größe; Header, Cookies und Inhalte werden nie angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumés d’archives HTTP : requêtes avec méthode, adresse, statut et taille ; les en-têtes, cookies et corps ne sont jamais affichés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 存档摘要：显示请求的方法、地址、状态和大小；绝不显示标头、Cookie 和正文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP アーカイブの概要：メソッド、アドレス、ステータス、サイズ付きのリクエスト。ヘッダー、Cookie、本文は表示しません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP आर्काइव सारांश: विधि, पता, स्थिति और आकार के साथ अनुरोध; हेडर, कुकी और बॉडी कभी नहीं दिखाई जाती।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurteyên arşîva HTTP: daxwazên bi rêbaz, navnîşan, rewş û mezinahî; sernav, cookie û laş tu carî nayên nîşandan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводки архивов HTTP: запросы с методом, адресом, статусом и размером; заголовки, cookie и тела никогда не показываются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringkasan arsip HTTP: permintaan dengan metode, alamat, status, dan ukuran; header, cookie, dan isi tidak pernah ditampilkan."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP আর্কাইভের সারাংশ: মেথড, ঠিকানা, স্ট্যাটাস ও আকারসহ অনুরোধ; হেডার, কুকি ও বডি কখনো দেখানো হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Taƙaitawar taskar HTTP: buƙatu masu hanya, adireshi, matsayi da girma; ba a taɓa nuna kanun labarai, kuki da jiki ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumos de arquivos HTTP: requisições com método, endereço, status e tamanho; cabeçalhos, cookies e corpos nunca são exibidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resúmenes de archivos HTTP: solicitudes con método, dirección, estado y tamaño; los encabezados, cookies y cuerpos nunca se muestran."
          }
        }
      }
    },
