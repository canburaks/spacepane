    "format.text.extensionless.description": {
      "comment": "Description of the extension-free file type. Only text is shown; binary content is never displayed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text files whose name has no extension, such as shell profiles. Binary files show an explanation instead of content."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adında uzantı olmayan metin dosyaları, örneğin kabuk profilleri. İkili dosyalarda içerik yerine bir açıklama gösterilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textdateien ohne Dateinamenerweiterung, etwa Shell-Profile. Bei Binärdateien wird statt des Inhalts eine Erklärung angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers texte dont le nom n’a pas d’extension, comme les profils de shell. Les fichiers binaires affichent une explication à la place du contenu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件名没有扩展名的文本文件，例如 shell 配置文件。二进制文件会显示说明而非内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に拡張子のないテキストファイル（シェルのプロファイルなど）。バイナリファイルでは内容の代わりに説明が表示されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसी टेक्स्ट फ़ाइलें जिनके नाम में एक्सटेंशन नहीं होता, जैसे शेल प्रोफ़ाइल। बाइनरी फ़ाइलों में सामग्री के बजाय एक स्पष्टीकरण दिखता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelên nivîsê yên ku di navê wan de paşgir tune ye, wek profîlên shellê. Pelên dudoyî li şûna naverokê ravekirinekê nîşan didin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстовые файлы, в имени которых нет расширения, например профили оболочки. Для двоичных файлов вместо содержимого показывается пояснение."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas teks yang namanya tidak memiliki ekstensi, seperti profil shell. Berkas biner menampilkan penjelasan, bukan isinya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব টেক্সট ফাইলের নামে কোনো এক্সটেনশন নেই, যেমন শেল প্রোফাইল। বাইনারি ফাইলে বিষয়বস্তুর বদলে একটি ব্যাখ্যা দেখানো হয়।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayilolin rubutu waɗanda sunansu ba shi da ƙari, kamar bayanan shell. Fayilolin binary suna nuna bayani maimakon abin da ke ciki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos de texto cujo nome não tem extensão, como perfis de shell. Arquivos binários mostram uma explicação em vez do conteúdo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de texto cuyo nombre no tiene extensión, como los perfiles de shell. Los archivos binarios muestran una explicación en lugar del contenido."
          }
        }
      }
    },
