          "stringUnit": {
            "state": "translated",
            "value": "ファイルを展開せずに、ZIP と ZIP64 の一覧を制限付きで表示します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें निकाले बिना सीमित ZIP और ZIP64 सूचियाँ।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lîsteyên ZIP û ZIP64 ên sînordar bê derxistina pelan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список содержимого ZIP и ZIP64 с ограничениями без извлечения файлов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar ZIP dan ZIP64 berbatas tanpa mengekstrak berkas."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল বের না করে সীমাবদ্ধ ZIP ও ZIP64 তালিকা।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Jerin ZIP da ZIP64 mai iyaka ba tare da fitar da fayiloli ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Listagens ZIP e ZIP64 com limites, sem extrair arquivos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listados ZIP y ZIP64 limitados sin extraer archivos."
          }
        }
      }
    },
