        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলটি দেখাতে এই প্রিভিউয়ের অনুমোদিত %@-এর চেয়ে বেশি জায়গা লাগত। এই ধরনের ফাইলের জন্য তৈরি অ্যাপে এটি খুলুন।"
