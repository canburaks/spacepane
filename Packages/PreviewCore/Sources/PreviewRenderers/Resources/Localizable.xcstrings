    "format.text.asciidoc.description": {
      "comment": "File type name or supported-behavior description; technical format names remain recognizable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline AsciiDoc headings, lists, blocks and admonitions plus safe source; includes are never followed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı AsciiDoc başlıkları, listeleri, blokları ve uyarıları ile güvenli kaynak; include satırları asla izlenmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline dargestellte AsciiDoc-Überschriften, Listen, Blöcke und Hinweisboxen sowie sichere Quelle; Includes werden nie verfolgt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres, listes, blocs et encadrés AsciiDoc hors ligne et source sûre ; les inclusions ne sont jamais suivies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线显示 AsciiDoc 的标题、列表、块和提示框，并提供安全源码；绝不会跟随 include。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AsciiDoc の見出し、リスト、ブロック、注意書きをオフラインで表示し、安全なソースも提供します。include は決して辿りません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AsciiDoc के शीर्षक, सूचियाँ, ब्लॉक और सूचना-बॉक्स ऑफ़लाइन, साथ में सुरक्षित स्रोत; include कभी नहीं खोले जाते।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sernivîs, lîste, blok û nîşeyên AsciiDoc ên negirêdayî û çavkaniya ewle; include tu car nayên şopandin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки, списки, блоки и врезки AsciiDoc без сети и безопасный исходник; include никогда не выполняются."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul, daftar, blok, dan kotak peringatan AsciiDoc secara luring plus sumber aman; include tidak pernah diikuti."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইনে AsciiDoc শিরোনাম, তালিকা, ব্লক ও সতর্কবার্তা এবং নিরাপদ উৎস; include কখনো অনুসরণ করা হয় না।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken AsciiDoc, jeri, tubalan da akwatunan gargaɗi ba tare da intanet ba, tare da amintaccen tushe; ba a taɓa bin include ba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos, listas, blocos e avisos AsciiDoc offline, mais código-fonte seguro; includes nunca são seguidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encabezados, listas, bloques y avisos de AsciiDoc sin conexión, más código fuente seguro; los include nunca se siguen."
          }
        }
      }
    },
