    "finding.launch.atLoad": {
      "comment": "Safety finding for a launchd job: macOS starts the program when the person logs in or when the Mac starts up. Not formatted; no placeholder. No file content, name or path appears in this sentence. Draft translations pending native-speaker review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The program starts at login or at startup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program, oturum açıldığında veya başlangıçta çalışır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Programm startet bei der Anmeldung oder beim Hochfahren."
          }
        },
        "fr": {
