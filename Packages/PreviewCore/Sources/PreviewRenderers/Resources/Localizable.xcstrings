    "preview.invisibles.note": {
      "comment": "Status line in the Invisibles preview mode, which shows hidden characters as markers such as ⟨U+202E RLO⟩. Copy and find in this mode use the marked text; the Source mode keeps the exact text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden characters are shown as markers, and copying here includes them. Source keeps the exact text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli karakterler işaretçi olarak gösterilir ve burada kopyalama bunları da içerir. Kaynak, metnin tam halini korur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsichtbare Zeichen werden als Markierungen angezeigt, und beim Kopieren in dieser Ansicht sind sie enthalten. Quelle behält den exakten Text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les caractères invisibles sont affichés sous forme de repères, et la copie ici les inclut. Source conserve le texte exact."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可见字符显示为标记，在此拷贝时也会包含这些标记。“源码”保留原始文本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見えない文字はマーカーで表示され、ここでコピーするとマーカーも含まれます。「ソース」では元のテキストがそのまま保たれます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अदृश्य अक्षर चिह्नों के रूप में दिखाए जाते हैं, और यहाँ कॉपी करने पर वे भी शामिल होते हैं। स्रोत सटीक पाठ को जस का तस रखता है।"
          }
        },
        "ku-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tîpên nedîtbar wekî nîşan têne nîşandan û kopîkirina li vir wan jî di nav xwe de dihewîne. Çavkanî nivîsa rast diparêze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невидимые символы показаны метками, и при копировании здесь они включаются. Вкладка «Исходный текст» хранит точный текст."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karakter tak terlihat ditampilkan sebagai penanda, dan penyalinan di sini menyertakannya. Sumber menyimpan teks persis seperti aslinya."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অদৃশ্য অক্ষর চিহ্ন হিসেবে দেখানো হয়, এবং এখানে কপি করলে সেগুলোও কপি হয়। উৎস মূল লেখা হুবহু রাখে।"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana nuna haruffan da ba a gani a matsayin alamomi, kuma kwafi a nan yana haɗa su. Tushe yana riƙe ainihin rubutun."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os caracteres invisíveis são mostrados como marcadores, e a cópia aqui os inclui. Origem mantém o texto exato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los caracteres invisibles se muestran como marcadores, y la copia aquí los incluye. Código fuente conserva el texto exacto."
          }
        }
      }
    },
