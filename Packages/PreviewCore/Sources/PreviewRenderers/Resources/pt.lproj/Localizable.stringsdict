	<key>appearance.pointsSpoken</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$@ ponto</string>
			<key>other</key>
			<string>%2$@ pontos</string>
		</dict>
	</dict>
	<key>failure.body.structureTooDeepLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Esta pré-visualização lê documentos aninhados em até %2$@ nível, e este é mais profundo. Abra-o em um app feito para este tipo de arquivo.</string>
			<key>other</key>
			<string>Esta pré-visualização lê documentos aninhados em até %2$@ níveis, e este é mais profundo. Abra-o em um app feito para este tipo de arquivo.</string>
		</dict>
	</dict>
