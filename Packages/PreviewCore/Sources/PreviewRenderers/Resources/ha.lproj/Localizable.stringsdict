	<key>failure.body.structureTooDeepLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Wannan dubawa tana karanta takardu da aka haɗa cikin juna har mataki %2$@, amma wannan takardar ta fi haka zurfi. Buɗe fayil ɗin a cikin manhajar da aka ƙera don irin wannan fayil.</string>
			<key>other</key>
			<string>Wannan dubawa tana karanta takardu da aka haɗa cikin juna har matakai %2$@, amma wannan takardar ta fi haka zurfi. Buɗe fayil ɗin a cikin manhajar da aka ƙera don irin wannan fayil.</string>
		</dict>
	</dict>
